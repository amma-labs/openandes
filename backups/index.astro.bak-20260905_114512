---
import Layout from '~/layouts/PageLayout.astro';
import RadarWidget from '~/components/widgets/RadarWidget.astro';

// Importar posts de Análisis
const posts = await Promise.all(
  Object.entries(import.meta.glob('../data/post/*.{md,mdx}')).map(async ([path, load]) => {
    const post = await load();
    const slug = path.split('/').pop().replace(/\.(md|mdx)$/, '');
    return {
      ...post,
      slug,
      url: `/analisis/${slug}`
    };
  })
);

// Ordenar por fecha y obtener el más reciente
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.frontmatter?.pubDate || '1970-01-01');
  const dateB = new Date(b.frontmatter?.pubDate || '1970-01-01');
  return dateB - dateA;
});

const mainPost = sortedPosts[0] || null;

// Array de Comentarios & Briefs reales (ordenados de más nuevo a más viejo)
const briefs = [
  {
    title: "El petróleo saudí sin su doble salida",
    author: "Sabrina Langer",
    date: "2026-09-05",
    displayDate: "5 Sep 2026",
    category: "Visión Experta",
    image: "/images/posts/1750905_0.png.webp",
    url: "/vision-experta/petroleo-saudi-sin-doble-salida",
    excerpt: "El colapso de los corredores saudíes expone cómo la especialización extrema de las cadenas de suministro dejó al descubierto la fragilidad del comercio mundial.",
    published: true
  },
  {
    title: "El Milagro Chino de Zhou Qunfei",
    author: "Nicolás H. Pinzón",
    date: "2026-08-31",
    displayDate: "31 Ago 2026",
    category: "Visión Experta",
    image: "/images/posts/a836391ed7c366d38ded99b0b42c038f5673d784-1480x833.jpg",
    url: "/vision-experta/milagro-chino-zhou-qunfei",
    excerpt: "La historia de la niña pobre del campo que se convirtió en la mujer hecha a sí misma más rica del mundo, fundadora de Lens Technology y símbolo del desarrollo industrial chino.",
    published: true
  }
];

const metadata = {
  title: 'OPEN ANDES — Inteligencia Estratégica y Riesgo Geofinanciero LatAm-Asia',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="font-sans text-[#1a1410] dark:text-[#f0ece4]">

    <!-- ============================================ -->
    <!-- HERO / MAIN GRID                             -->
    <!-- ============================================ -->
    <section class="py-8 px-4 sm:px-6 mx-auto max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <article class="lg:col-span-8 flex flex-col gap-4 font-sans">
          <div class="flex items-center gap-3">
            <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-xs uppercase px-2.5 py-1 rounded w-max tracking-wide">
              {mainPost ? mainPost.frontmatter?.category || 'Análisis' : 'Informe Principal'}
            </span>
            {mainPost?.frontmatter?.pubDate && (
              <span class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">
                {new Date(mainPost.frontmatter.pubDate).toLocaleDateString('es-ES', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </span>
            )}
          </div>
          
          <a href={mainPost?.url || '#'} class="group block overflow-hidden rounded-md bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <img 
              src={mainPost?.frontmatter?.image || 'https://images.unsplash.com/photo-1578575437130-527eed3abbec?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80'} 
              alt={mainPost?.frontmatter?.title || 'Análisis Principal'} 
              class="w-full h-[360px] sm:h-[400px] object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </a>

          <a href={mainPost?.url || '#'} class="hover:underline">
            <h1 class="text-3xl sm:text-4xl font-display font-semibold tracking-tight text-slate-900 dark:text-white leading-tight">
              {mainPost?.frontmatter?.title || 'Título del Informe Principal en preparación...'}
            </h1>
          </a>

          <div class="flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
            {mainPost?.frontmatter?.author && (
              <span class="font-medium">Por {mainPost.frontmatter.author}</span>
            )}
          </div>

          <a href={mainPost?.url || '#'} class="block hover:opacity-90">
            <p class="font-sans text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              {mainPost?.frontmatter?.excerpt || 'El equipo analítico de Open Andes se encuentra redactando la evaluación estratégica de esta entrega. Estará disponible públicamente en la fecha programada.'}
            </p>
          </a>
        </article>

        <aside class="lg:col-span-4 flex flex-col justify-between lg:border-l lg:border-[#e8e0d0] lg:dark:border-[#2a2a2a] lg:pl-8 font-sans h-full">
          <div class="flex flex-col justify-between h-full gap-5">
            
            <article class="grid grid-cols-12 gap-3 pb-4 border-b border-[#e8e0d0] dark:border-[#2a2a2a] items-center opacity-70">
              <div class="col-span-8 flex flex-col gap-1">
                <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-[10px] uppercase px-2 py-0.5 rounded w-max">Defensa</span>
                <h3 class="text-sm font-display font-medium leading-snug text-slate-500 dark:text-slate-400 italic">Análisis en preparación...</h3>
                <div class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">Estreno: Jueves 8 Sep</div>
              </div>
              <div class="col-span-4 overflow-hidden rounded">
                <img src="https://images.unsplash.com/photo-1508614589041-895b88991e3e?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="En espera" class="w-full h-20 object-cover grayscale" />
              </div>
            </article>

            <article class="grid grid-cols-12 gap-3 pb-4 border-b border-[#e8e0d0] dark:border-[#2a2a2a] items-center opacity-70">
              <div class="col-span-8 flex flex-col gap-1">
                <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-[10px] uppercase px-2 py-0.5 rounded w-max">Geoeconomía</span>
                <h3 class="text-sm font-display font-medium leading-snug text-slate-500 dark:text-slate-400 italic">Análisis en preparación...</h3>
                <div class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">Estreno: Lunes 15 Sep</div>
              </div>
              <div class="col-span-4 overflow-hidden rounded">
                <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="En espera" class="w-full h-20 object-cover grayscale" />
              </div>
            </article>

            <article class="grid grid-cols-12 gap-3 pb-4 border-b border-[#e8e0d0] dark:border-[#2a2a2a] items-center opacity-70">
              <div class="col-span-8 flex flex-col gap-1">
                <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-[10px] uppercase px-2 py-0.5 rounded w-max">Tecnología</span>
                <h3 class="text-sm font-display font-medium leading-snug text-slate-500 dark:text-slate-400 italic">Análisis en preparación...</h3>
                <div class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">Estreno: Jueves 22 Sep</div>
              </div>
              <div class="col-span-4 overflow-hidden rounded">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="En espera" class="w-full h-20 object-cover grayscale" />
              </div>
            </article>

            <article class="grid grid-cols-12 gap-3 items-center opacity-70">
              <div class="col-span-8 flex flex-col gap-1">
                <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-[10px] uppercase px-2 py-0.5 rounded w-max">Escenarios</span>
                <h3 class="text-sm font-display font-medium leading-snug text-slate-500 dark:text-slate-400 italic">Análisis en preparación...</h3>
                <div class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">Estreno: Lunes 29 Sep</div>
              </div>
              <div class="col-span-4 overflow-hidden rounded">
                <img src="https://images.unsplash.com/photo-1541872703-74c5e44368f9?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="En espera" class="w-full h-20 object-cover grayscale" />
              </div>
            </article>

          </div>
        </aside>

      </div>
    </section>

    <!-- ============================================ -->
    <!-- ANÁLISIS & INFORMES TÁCTICOS                 -->
    <!-- ============================================ -->
    <section class="py-12 px-4 sm:px-6 mx-auto max-w-7xl border-b border-[#e8e0d0] dark:border-[#2a2a2a] font-sans">
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-[#1a1410] dark:text-[#f0ece4]">
          Comentarios &amp; <em>Briefs</em>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {briefs.map((brief) => (
          <article class="flex flex-col gap-3 p-4 rounded-lg bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 border border-[#e8e0d0] dark:border-[#2a2a2a] hover:opacity-100 transition-opacity">
            <a href={brief.url}>
              <div class="overflow-hidden rounded h-40 bg-slate-200 dark:bg-slate-800">
                <img src={brief.image} alt={brief.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
              </div>
            </a>
            <div class="flex items-center justify-between text-xs">
              <span class="bg-[#1a4b8c] text-white font-mono-tech font-bold px-2 py-0.5 rounded uppercase">{brief.category}</span>
              <span class="text-[#1a4b8c] dark:text-[#2b6cb5] font-mono-tech font-bold">{brief.displayDate}</span>
            </div>
            <a href={brief.url} class="hover:underline">
              <h3 class="text-base font-display font-medium text-slate-800 dark:text-slate-200 leading-tight">{brief.title}</h3>
            </a>
            <p class="text-xs text-slate-500 dark:text-slate-400 italic">Por {brief.author}</p>
            <p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-3">{brief.excerpt}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ============================================ -->
    <!-- RADAR WIDGET                                 -->
    <!-- ============================================ -->
    <section class="py-12 px-4 sm:px-6 mx-auto max-w-7xl font-sans">
      <RadarWidget title="Pulso" badgePosition="right" />
    </section>

  </div>
</Layout>
