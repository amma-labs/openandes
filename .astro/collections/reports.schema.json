{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "researchLeaders": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "associateResearchers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pdfUrl": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "toc": {
      "default": true,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}