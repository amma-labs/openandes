{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/enfoques",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/miradas",
      "permanent": true
    },
    {
      "source": "/mirada-experta",
      "destination": "/miradas",
      "permanent": true
    },
    {
      "source": "/mirada-experta/:slug",
      "destination": "/miradas/:slug",
      "permanent": true
    }
  ]
}
