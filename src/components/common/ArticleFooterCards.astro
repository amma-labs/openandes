---
import { getCollection } from 'astro:content';
import { authors as authorRegistry } from '~/data/authors';

export interface Props {
  section: 'analisis' | 'comentarios' | 'monitor';
  currentSlug: string;
  locale?: 'es' | 'en' | 'zh';
  title: string;
  author?: string;
  authorSlugs?: string[];
  pubDate: Date | string;
  reportType?: string;
}

const {
  section,
  currentSlug,
  locale = 'es',
  title,
  author,
  authorSlugs = [],
  pubDate,
  reportType,
} = Astro.props;

// 1. Etiquetas multilingües
const labels = {
  es: {
    shareEyebrow: 'COMPARTE EL CONOCIMIENTO',
    citeTitle: 'Citar este artículo',
    citeReportTitle: 'Citar este informe',
    copyCitation: 'Copiar cita',
    copyLink: 'Copiar enlace',
    copied: '¡Copiado!',
    keepReading: 'Para seguir leyendo',
    exploreMore: {
      analisis: 'Seguir explorando análisis',
      comentarios: 'Seguir explorando comentarios',
      monitor: 'Explorar todos los informes',
    },
  },
  en: {
    shareEyebrow: 'SHARE KNOWLEDGE',
    citeTitle: 'Cite this article',
    citeReportTitle: 'Cite this report',
    copyCitation: 'Copy citation',
    copyLink: 'Copy link',
    copied: 'Copied!',
    keepReading: 'Continue reading',
    exploreMore: {
      analisis: 'Explore more analysis',
      comentarios: 'Explore more commentaries',
      monitor: 'Explore all reports',
    },
  },
  zh: {
    shareEyebrow: '分享知识',
    citeTitle: '引用本文',
    citeReportTitle: '引用本报告',
    copyCitation: '复制引文',
    copyLink: '复制链接',
    copied: '已复制！',
    keepReading: '延伸阅读',
    exploreMore: {
      analisis: '浏览更多深度分析',
      comentarios: '浏览更多评论文章',
      monitor: '浏览全部研究报告',
    },
  },
}[locale];

// 2. Resolución de autores
const resolvedNames: string[] =
  authorSlugs.length > 0
    ? authorSlugs.map((s) => authorRegistry[s]?.name).filter(Boolean)
    : author
      ? [author]
      : ['Open Andes'];

function splitName(fullName: string) {
  const clean = fullName.trim();
  if (!clean || clean.toLowerCase() === 'open andes') {
    return { isOrg: true, first: '', last: 'Open Andes' };
  }
  const parts = clean.split(/\s+/);
  if (parts.length <= 1) return { isOrg: false, first: '', last: clean };
  if (parts.length === 2) {
    return { isOrg: false, first: parts[0], last: parts[1] };
  }
  // Si termina en inicial (ej. "Francisco J. Covarrubias R.") o tiene inicial intermedia ("Nicolás H. Pinzón")
  const hasInitial = parts.some((pt) => /^[A-ZÁÉÍÓÚÑ]\.$/.test(pt));
  if (hasInitial) {
    const firstParts: string[] = [];
    const lastParts: string[] = [];
    let foundFirstInitial = false;
    for (let i = 0; i < parts.length; i++) {
      if (i === 0) {
        firstParts.push(parts[i]);
      } else if (/^[A-ZÁÉÍÓÚÑ]\.$/.test(parts[i]) && !foundFirstInitial) {
        firstParts.push(parts[i]);
        foundFirstInitial = true;
      } else {
        lastParts.push(parts[i]);
      }
    }
    return { isOrg: false, first: firstParts.join(' '), last: lastParts.join(' ') };
  }
  // Nombres hispanos estándar con 2 nombres y 2 apellidos (ej. "Mauricio Aaron Bravo Melendez") o 1 nombre y 2 apellidos ("Bernardo Muñoz Aguilar")
  const last = parts.slice(-2).join(' ');
  const first = parts.slice(0, -2).join(' ');
  return { isOrg: false, first, last };
}

// Formato Chicago (Apellido, Nombre y Nombre Apellido)
function buildChicagoAuthors(names: string[]): string {
  const formatted = names.map((n, idx) => {
    const p = splitName(n);
    if (p.isOrg) return 'Open Andes';
    return idx === 0 ? `${p.last}, ${p.first}` : `${p.first} ${p.last}`;
  });
  if (formatted.length === 1) return formatted[0];
  const conn = locale === 'es' ? ' y ' : locale === 'en' ? ' and ' : '、';
  if (formatted.length === 2) return `${formatted[0]}${conn}${formatted[1]}`;
  const last = formatted.pop();
  return `${formatted.join(', ')}${locale === 'zh' ? '、' : `,${conn}`}${last}`;
}

// Formato APA 7 (Apellido, N., & Apellido, N.)
function buildApaAuthors(names: string[]): string {
  const formatted = names.map((n) => {
    const p = splitName(n);
    if (p.isOrg) return 'Open Andes';
    const initials = p.first
      .split(/\s+/)
      .filter(Boolean)
      .map((part) => `${part[0].toUpperCase()}.`)
      .join(' ');
    return `${p.last}, ${initials}`;
  });
  if (formatted.length === 1) return formatted[0];
  if (formatted.length === 2) return `${formatted[0]} & ${formatted[1]}`;
  const last = formatted.pop();
  return `${formatted.join(', ')}, & ${last}`;
}

// Formato BibTeX (Apellido, Nombre and Apellido, Nombre)
function buildBibtexAuthors(names: string[]): string {
  return names
    .map((n) => {
      const p = splitName(n);
      return p.isOrg ? '{Open Andes}' : `${p.last}, ${p.first}`;
    })
    .join(' and ');
}

// 3. Fechas y URL canónica
const dateObj = pubDate instanceof Date ? pubDate : new Date(pubDate);
const year = dateObj.getUTCFullYear();
const monthNum = String(dateObj.getUTCMonth() + 1).padStart(2, '0');
const monthLong = new Intl.DateTimeFormat(
  locale === 'es' ? 'es-ES' : locale === 'en' ? 'en-US' : 'zh-CN',
  { month: 'long', timeZone: 'UTC' }
).format(dateObj);
const formattedDateFull = new Intl.DateTimeFormat(
  locale === 'es' ? 'es-ES' : locale === 'en' ? 'en-US' : 'zh-CN',
  { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }
).format(dateObj);
const apaDate = locale === 'zh'
  ? `${year}年${dateObj.getUTCMonth() + 1}月${dateObj.getUTCDate()}日`
  : `${year}, ${dateObj.getUTCDate()} de ${monthLong}`;
const apaDateEn = `${year}, ${monthLong} ${dateObj.getUTCDate()}`;

const cleanUrl = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', 'https://openandes.org').href;

const chicagoAuthors = buildChicagoAuthors(resolvedNames);
const apaAuthors = buildApaAuthors(resolvedNames);
const bibtexAuthors = buildBibtexAuthors(resolvedNames);

const firstAuthorLast = splitName(resolvedNames[0]).last.toLowerCase().replace(/[^a-z0-9]/g, '') || 'openandes';
const cleanSlugKey = currentSlug.replace(/[^a-zA-Z0-9]/g, '').slice(0, 18) || 'article';
const bibtexKey = `${firstAuthorLast}${year}${cleanSlugKey}`;

const citations = {
  chicago:
    section === 'monitor'
      ? `${chicagoAuthors}. "${title}." ${reportType ? `${reportType}, ` : ''}Open Andes, ${formattedDateFull}. ${cleanUrl}`
      : `${chicagoAuthors}. "${title}." Open Andes, ${formattedDateFull}. ${cleanUrl}`,
  apa: `${apaAuthors} (${locale === 'en' ? apaDateEn : apaDate}). ${title}${section === 'monitor' && reportType ? ` [${reportType}]` : ''}. Open Andes. ${cleanUrl}`,
  bibtex: `@misc{${bibtexKey},
  author = {${bibtexAuthors}},
  title = {{${title}}},
  year = {${year}},
  month = {${monthNum}},
  howpublished = {Open Andes},
  url = {${cleanUrl}}
}`,
};

// 4. Obtención automática de 3 lecturas relacionadas de la misma sección e idioma
const prefix = locale === 'es' ? '' : `/${locale}`;
const exploreHref = `${prefix}/${section}`;

interface RelatedItem {
  title: string;
  href: string;
  date: number;
}

let relatedItems: RelatedItem[] = [];

if (section === 'monitor') {
  const allReports = await getCollection('reports');
  relatedItems = allReports
    .filter((entry) => entry.id.startsWith(`${locale}/`))
    .map((entry) => {
      const slug = entry.id.replace(/^(es|en|zh)\//, '').replace(/\.(md|mdx)$/, '');
      return {
        slug,
        title: entry.data.title,
        href: `${prefix}/monitor/${slug}`,
        date: new Date(entry.data.date).getTime(),
      };
    })
    .filter((item) => item.slug !== currentSlug && !currentSlug.endsWith(`/${item.slug}`))
    .sort((a, b) => b.date - a.date)
    .slice(0, 3);
} else {
  const globFiles =
    section === 'analisis'
      ? import.meta.glob('../../data/post/**/*.{md,mdx}', { eager: true })
      : import.meta.glob('../../data/comentarios/**/*.{md,mdx}', { eager: true });

  const folderPrefix = section === 'analisis' ? `../../data/post/${locale}/` : `../../data/comentarios/${locale}/`;

  relatedItems = Object.entries(globFiles)
    .filter(([filepath]) => filepath.startsWith(folderPrefix))
    .map(([filepath, mod]: [string, any]) => {
      const slug = filepath.match(/\/([^/]+)\.(md|mdx)$/)![1];
      const fm = mod.frontmatter || {};
      return {
        slug,
        title: fm.title || slug,
        href: `${prefix}/${section}/${slug}`,
        date: fm.pubDate ? new Date(fm.pubDate).getTime() : 0,
      };
    })
    .filter((item) => item.slug !== currentSlug)
    .sort((a, b) => b.date - a.date)
    .slice(0, 3);
}
---

<section
  aria-label={section === 'monitor' ? labels.citeReportTitle : labels.citeTitle}
  class="not-prose my-12 grid grid-cols-1 md:grid-cols-2 gap-6"
>
  <!-- TARJETA IZQUIERDA: CITAR -->
  <div
    data-citation-widget
    data-cite-chicago={citations.chicago}
    data-cite-apa={citations.apa}
    data-cite-bibtex={citations.bibtex}
    class="flex flex-col justify-between rounded-3xl border border-[#e5e7eb] dark:border-[#2a2a2a] bg-[#ffffff] dark:bg-[#0b101b] p-7 sm:p-8 shadow-sm"
  >
    <div>
      <p class="text-center font-mono-tech text-[11px] font-bold uppercase tracking-[0.14em] text-[#1344e7] dark:text-[#5b8def] mb-2">
        {labels.shareEyebrow}
      </p>
      <h2 class="text-center font-fraunces text-3xl sm:text-[34px] font-normal text-[#111827] dark:text-[#f3f4f6] tracking-tight mb-4">
        {section === 'monitor' ? labels.citeReportTitle : labels.citeTitle}
      </h2>

      <!-- SELECTOR DE FORMATO -->
      <div class="mb-4 flex items-center justify-center gap-1.5" role="tablist" aria-label="Formato de cita">
        <button
          type="button"
          data-format-tab="chicago"
          aria-selected="true"
          class="cursor-pointer rounded-full px-3.5 py-1 font-mono-tech text-[11px] font-bold uppercase tracking-wider transition bg-[#1344e7] text-white"
        >
          Chicago
        </button>
        <button
          type="button"
          data-format-tab="apa"
          aria-selected="false"
          class="cursor-pointer rounded-full px-3.5 py-1 font-mono-tech text-[11px] font-bold uppercase tracking-wider transition bg-[#e2f3ff]/70 text-[#1344e7] hover:bg-[#e2f3ff] dark:bg-white/5 dark:text-[#9ca3af] dark:hover:text-white"
        >
          APA 7
        </button>
        <button
          type="button"
          data-format-tab="bibtex"
          aria-selected="false"
          class="cursor-pointer rounded-full px-3.5 py-1 font-mono-tech text-[11px] font-bold uppercase tracking-wider transition bg-[#e2f3ff]/70 text-[#1344e7] hover:bg-[#e2f3ff] dark:bg-white/5 dark:text-[#9ca3af] dark:hover:text-white"
        >
          BibTeX
        </button>
      </div>

      <!-- CAJA CELESTE INSTITUCIONAL -->
      <div
        data-citation-box
        class="rounded-2xl bg-[#e2f3ff]/65 dark:bg-[#1344e7]/10 border border-[#bfdbfe] dark:border-[#1344e7]/30 p-5 font-fraunces text-[14.5px] leading-relaxed text-[#111827] dark:text-[#e5e7eb] select-all break-words"
      >
        {citations.chicago}
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <button
        type="button"
        data-copy-btn
        data-copy-target="citation"
        data-copy-text={citations.chicago}
        data-copied-label={labels.copied}
        class="cursor-pointer rounded-full bg-[#1344e7] px-5 py-2.5 text-xs font-semibold tracking-wide text-white transition hover:bg-[#0f36b8]"
      >
        {labels.copyCitation}
      </button>
    </div>
  </div>

  <!-- TARJETA DERECHA: PARA SEGUIR LEYENDO -->
  <div class="flex flex-col justify-between rounded-3xl border border-[#e5e7eb] dark:border-[#2a2a2a] bg-[#ffffff] dark:bg-[#0b101b] p-7 sm:p-8 shadow-sm">
    <div>
      <h2 class="text-center font-fraunces text-3xl sm:text-[34px] font-normal text-[#111827] dark:text-[#f3f4f6] tracking-tight mb-6">
        {labels.keepReading}
      </h2>

      {relatedItems.length > 0 && (
        <ul class="divide-y divide-[#e5e7eb] dark:divide-[#2a2a2a] border-t border-b border-[#e5e7eb] dark:border-[#2a2a2a]">
          {relatedItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="block py-4 px-2 text-center font-fraunces text-[17px] leading-snug text-[#111827] dark:text-[#f3f4f6] transition hover:text-[#1344e7] dark:hover:text-[#5b8def]"
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="mt-6 flex justify-center">
      <a
        href={exploreHref}
        class="rounded-full bg-[#1344e7] px-6 py-2.5 text-xs font-semibold tracking-wide text-white transition hover:bg-[#0f36b8]"
      >
        {labels.exploreMore[section]}
      </a>
    </div>
  </div>
</section>

<script is:inline>
  function initCitationWidgets() {
    document.querySelectorAll('[data-citation-widget]').forEach((widget) => {
      if (widget.dataset.bound === 'true') return;
      widget.dataset.bound = 'true';

      const box = widget.querySelector('[data-citation-box]');
      const citeBtn = widget.querySelector('[data-copy-target="citation"]');
      const tabs = widget.querySelectorAll('[data-format-tab]');

      const activeClasses = ['bg-[#1344e7]', 'text-white'];
      const inactiveClasses = ['bg-[#e2f3ff]/70', 'text-[#1344e7]', 'hover:bg-[#e2f3ff]', 'dark:bg-white/5', 'dark:text-[#9ca3af]', 'dark:hover:text-white'];

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const fmt = tab.getAttribute('data-format-tab');
          const newText = widget.getAttribute(`data-cite-${fmt}`) || '';

          if (box) {
            box.textContent = newText;
            if (fmt === 'bibtex') {
              box.classList.remove('font-fraunces');
              box.classList.add('font-mono-tech', 'text-xs', 'whitespace-pre-wrap');
            } else {
              box.classList.remove('font-mono-tech', 'text-xs', 'whitespace-pre-wrap');
              box.classList.add('font-fraunces');
            }
          }

          if (citeBtn) {
            citeBtn.setAttribute('data-copy-text', newText);
          }

          tabs.forEach((t) => {
            const isSelected = t === tab;
            t.setAttribute('aria-selected', String(isSelected));
            if (isSelected) {
              t.classList.remove(...inactiveClasses);
              t.classList.add(...activeClasses);
            } else {
              t.classList.remove(...activeClasses);
              t.classList.add(...inactiveClasses);
            }
          });
        });
      });
    });

    document.querySelectorAll('[data-copy-btn]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy-text') || '';
        const copiedLabel = btn.getAttribute('data-copied-label') || '¡Copiado!';
        const originalLabel = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = copiedLabel;
          setTimeout(() => {
            btn.textContent = originalLabel;
          }, 2000);
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      });
    });
  }

  initCitationWidgets();
  document.addEventListener('astro:page-load', initCitationWidgets);
</script>
