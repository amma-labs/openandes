---
import { UI } from 'astrowind:config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme || 'system' }}>
  // Tema 100% automático: sigue SIEMPRE al sistema operativo.
  // Ignora localStorage (que puede tener una elección vieja del toggle eliminado).
  // Escucha cambios en tiempo real (cuando el iPhone cambia de claro a oscuro).

  function applyTheme(theme) {
    document.documentElement.classList[theme === 'dark' ? 'add' : 'remove']('dark');
  }

  function resolveTheme() {
    // Si el tema está forzado a light:only o dark:only, respetarlo
    if (defaultTheme && defaultTheme.endsWith(':only')) {
      return defaultTheme.replace(':only', '');
    }
    // Si el tema está forzado a light o dark, respetarlo
    if (defaultTheme === 'light' || defaultTheme === 'dark') {
      return defaultTheme;
    }
    // Modo 'system' (o cualquier otro): seguir al sistema operativo
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  applyTheme(resolveTheme());

  // Re-aplicar en navegaciones client-side (ClientRouter)
  document.addEventListener('astro:after-swap', () => applyTheme(resolveTheme()));

  // Escuchar cambios del sistema en tiempo real (sin recargar la página)
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (defaultTheme === 'system') {
      applyTheme(e.matches ? 'dark' : 'light');
    }
  });

  // Limpiar localStorage.theme (eliminar la elección vieja del toggle eliminado)
  try { localStorage.removeItem('theme'); } catch (e) {}
</script>
