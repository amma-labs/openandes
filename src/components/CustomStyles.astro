---
<style is:inline>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Fraunces:ital,opsz,wght@0,9..144,400;1,9..144,400&display=swap');

  :root {
    --aw-font-sans: 'Montserrat', sans-serif;
    --aw-font-serif: 'Fraunces', serif;
    --aw-font-heading: 'Montserrat', sans-serif;

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-bg-page-dark: rgb(2 33 53);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: 'Montserrat', sans-serif;
    --aw-font-serif: 'Fraunces', serif;
    --aw-font-heading: 'Montserrat', sans-serif;

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(2 33 53);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
