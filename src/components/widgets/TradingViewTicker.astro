---
// Este componente carga TradingView usando un script externo
// No contiene código JS que Astro pueda malinterpretar
---

<div class="tradingview-widget-container border-t-2 border-b-2 border-[#1a4b8c] dark:border-[#2b6cb5] py-4">
  <div class="tradingview-widget-container__widget"></div>
</div>

<script is:inline>
  // Cargar el script de TradingView después de que el DOM esté listo
  (function() {
    const script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
    script.async = true;
    script.innerHTML = JSON.stringify({
      "symbols": [
        { "proName": "BITSTAMP:BTCUSD", "title": "Bitcoin" },
        { "proName": "TVC:UKOIL", "title": "Brent Oil" },
        { "proName": "TVC:USOIL", "title": "WTI Oil" },
        { "proName": "TVC:GOLD", "title": "Oro" },
        { "proName": "NYSE:TSM", "title": "TSMC" },
        { "proName": "FOREXCOM:SPXUSD", "title": "S&P 500" }
      ],
      "showSymbolLogo": true,
      "colorTheme": "light",
      "isTransparent": false,
      "displayMode": "adaptive",
      "locale": "es"
    });
    document.querySelector('.tradingview-widget-container').appendChild(script);
  })();
</script>
