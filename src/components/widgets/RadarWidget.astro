---
export interface Props {
  title?: string;
}

const {
  title = 'Pulso',
} = Astro.props;

// 1. Las 12 fuentes estructuradas por Eje Geopolítico (fuentes abiertas)
const FEEDS_CONFIG = [
  // Occidente / Transatlántico
  { url: 'https://www.reutersagency.com/feed/?best-topics=world', region: 'Occidente / Transatlántico', source: 'Reuters World' },
  { url: 'https://foreignpolicy.com/feed/', region: 'Occidente / Transatlántico', source: 'Foreign Policy' },
  
  // Eje Ruso / Euroasiático
  { url: 'https://tass.com/rss/v2.xml', region: 'Eje Ruso / Euroasiático', source: 'TASS English' },
  { url: 'https://www.rt.com/rss/news/', region: 'Eje Ruso / Euroasiático', source: 'RT World News' },
  
  // Asia-Pacífico / China
  { url: 'https://www.scmp.com/rss/322296/feed', region: 'Asia-Pacífico / China', source: 'SCMP' },
  { url: 'http://www.xinhuanet.com/english/rss/worldrss.xml', region: 'Asia-Pacífico / China', source: 'Xinhua Net' },
  { url: 'https://asia.nikkei.com', region: 'Asia-Pacífico / China', source: 'Nikkei Asia' },
  
  // Oriente Medio, Sur Global / BRICS+ y Geoeconomía
  { url: 'https://www.aljazeera.com/xml/rss/all.xml', region: 'Sur Global / BRICS+', source: 'Al Jazeera' },
  { url: 'https://www.orfonline.org/feed', region: 'Sur Global / BRICS+', source: 'ORF India' },
  { url: 'https://en.mercopress.com/rss', region: 'Sur Global / BRICS+', source: 'Mercopress' },
  { url: 'https://timesofindia.indiatimes.com', region: 'Sur Global / BRICS+', source: 'Times of India' },
  { url: 'https://thediplomat.com/feed/', region: 'Riesgo Geofinanciero', source: 'The Diplomat' }
];

interface RadarItem {
  id: string;
  title: string;
  source: string;
  region: string;
  summary: string;
  url: string;
  date: string;
}

// Función para formatear fecha de forma segura
function formatDate(dateString: string): string {
  if (!dateString) return 'Hoy';
  
  try {
    const date = new Date(dateString);
    // Verificar si la fecha es válida
    if (isNaN(date.getTime())) {
      // Intentar parsear formatos comunes
      const cleaned = dateString.replace(/(\d{2})\s+(\w{3})\s+(\d{4})/, '$1 $2 $3');
      const fallbackDate = new Date(cleaned);
      if (!isNaN(fallbackDate.getTime())) {
        return fallbackDate.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
      }
      return 'Hoy';
    }
    return date.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
  } catch {
    return 'Hoy';
  }
}

// Función liviana para parsear XML básico usando Expresiones Regulares
function parseXmlItem(xmlText: string, config: typeof FEEDS_CONFIG[0]): RadarItem | null {
  try {
    const itemMatch = xmlText.match(/<item[\s\S]*?>([\s\S]*?)<\/item>/i) || xmlText.match(/<entry[\s\S]*?>([\s\S]*?)<\/entry>/i);
    if (!itemMatch) return null;

    const itemContent = itemMatch[1];

    const titleMatch = itemContent.match(/<title[\s\S]*?>([\s\S]*?)<\/title>/i);
    const linkMatch = itemContent.match(/<link[\s\S]*?>([\s\S]*?)<\/link>/i) || itemContent.match(/href=["']([^"']+)["']/i);
    const descMatch = itemContent.match(/<description[\s\S]*?>([\s\S]*?)<\/description>/i) || itemContent.match(/<summary[\s\S]*?>([\s\S]*?)<\/summary>/i);
    const dateMatch = itemContent.match(/<pubDate[\s\S]*?>([\s\S]*?)<\/pubDate>/i) || itemContent.match(/<updated[\s\S]*?>([\s\S]*?)<\/updated>/i);

    let title = titleMatch ? titleMatch[1].replace(/<!\[CDATA\[([\s\S]*?)\]\]>/gi, '$1').trim() : '';
    let url = linkMatch ? (linkMatch[1] || linkMatch[0]).replace(/<!\[CDATA\[([\s\S]*?)\]\]>/gi, '$1').trim() : config.url;
    let summaryRaw = descMatch ? descMatch[1].replace(/<!\[CDATA\[([\s\S]*?)\]\]>/gi, '$1') : '';
    
    // Limpiar HTML en la descripción
    let summary = summaryRaw.replace(/<[^>]*>?/gm, '').replace(/\s+/g, ' ').trim().slice(0, 150);
    if (summary.length >= 150) summary += '...';

    if (!title) return null;

    // Formatear fecha de forma segura
    const dateStr = dateMatch ? dateMatch[1].trim() : '';
    const formattedDate = formatDate(dateStr);

    return {
      id: url || Math.random().toString(),
      title,
      source: config.source,
      region: config.region,
      summary: summary || 'Sin descripción disponible.',
      url,
      date: formattedDate
    };
  } catch {
    return null;
  }
}

// Fetch rápido con abort controller de 2.5s
const fetchedResults = await Promise.all(
  FEEDS_CONFIG.map(async (config) => {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 2500);

      const res = await fetch(config.url, {
        headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) OpenAndes/1.0' },
        signal: controller.signal
      });
      clearTimeout(timeoutId);

      if (!res.ok) return null;
      const text = await res.text();
      return parseXmlItem(text, config);
    } catch {
      return null;
    }
  })
);

const validItems = fetchedResults.filter((item): item is RadarItem => item !== null);

// Algoritmo de balance geopolítico para seleccionar 6
function selectBalancedItems(items: RadarItem[], count: number = 6): RadarItem[] {
  const grouped: Record<string, RadarItem[]> = {};
  items.forEach((item) => {
    if (!grouped[item.region]) grouped[item.region] = [];
    grouped[item.region].push(item);
  });

  const selected: RadarItem[] = [];
  const regions = Object.keys(grouped).sort(() => Math.random() - 0.5);

  // 1 por región
  for (const reg of regions) {
    if (selected.length >= count) break;
    const pool = grouped[reg];
    if (pool.length > 0) {
      selected.push(pool.shift()!);
    }
  }

  // Rellenar resto aleatorio
  const remaining = Object.values(grouped).flat().sort(() => Math.random() - 0.5);
  while (selected.length < count && remaining.length > 0) {
    selected.push(remaining.pop()!);
  }

  return selected;
}

const radarData = selectBalancedItems(validItems, 6);
---

<section class="relative mx-auto max-w-7xl font-sans">
  <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <h2 class="text-3xl font-display font-bold tracking-tight text-[#1a1410] dark:text-[#f0ece4]">
      {title}
    </h2>
    <div class="flex items-center gap-2">
      <span class="inline-block bg-[#1a4b8c]/10 dark:bg-[#2b6cb5]/10 text-[#1a4b8c] dark:text-[#2b6cb5] font-mono-tech font-bold text-xs uppercase px-2.5 py-1 rounded w-max">
        Monitoreo Global
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      radarData.length > 0 ? (
        radarData.map((item) => (
          <article class="flex flex-col justify-between p-5 bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 border border-[#e8e0d0] dark:border-[#2a2a2a] rounded-lg hover:border-[#1a4b8c]/30 dark:hover:border-[#2b6cb5]/30 transition-colors font-sans min-h-[220px]">
            <div>
              <div class="flex justify-between items-center text-[11px] text-[#4a4038]/70 dark:text-[#c8c0b4]/70 mb-2 gap-2">
                <span class="font-mono-tech font-bold uppercase tracking-wider text-[#1a4b8c] dark:text-[#2b6cb5]">
                  {item.region}
                </span>
                <span class="font-mono-tech font-semibold">{item.date}</span>
              </div>

              <h3 class="font-display font-bold text-[#1a1410] dark:text-[#f0ece4] text-base leading-snug mb-2 line-clamp-2">
                {item.title}
              </h3>

              <p class="text-xs text-[#4a4038] dark:text-[#c8c0b4] leading-relaxed font-sans line-clamp-3">
                {item.summary}
              </p>
            </div>

            <div class="pt-4 mt-auto border-t border-[#e8e0d0]/60 dark:border-[#2a2a2a]/60 flex justify-between items-center text-xs">
              <span class="font-medium text-[#4a4038]/70 dark:text-[#c8c0b4]/70 font-sans">{item.source}</span>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center font-mono-tech font-semibold text-[#1a4b8c] dark:text-[#2b6cb5] hover:underline gap-1"
              >
                <span>Fuente</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </article>
        ))
      ) : (
        <div class="col-span-3 text-center py-8 text-[#4a4038] dark:text-[#c8c0b4] text-sm font-sans">
          Actualizando radar de noticias globales...
        </div>
      )
    }
  </div>
</section>
