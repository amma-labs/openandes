---
import { getHomePermalink } from '~/utils/permalinks';
---

<a class="flex items-center shrink-0" href={getHomePermalink()}>
  <span class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold whitespace-nowrap flex items-center">
    <img 
      src="/images/logo.svg" 
      alt="OpenAndes" 
      class="h-10 md:h-12 w-auto max-w-[200px] object-contain block dark:hidden" 
      width="180" 
      height="60" 
      loading="eager"
    />
    <img 
      src="/images/logo-dark.svg" 
      alt="OpenAndes" 
      class="h-10 md:h-12 w-auto max-w-[200px] object-contain hidden dark:block" 
      width="180" 
      height="60" 
      loading="eager"
    />
  </span>
</a>
