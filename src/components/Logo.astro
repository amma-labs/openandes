---
import { getLangFromUrl } from '~/i18n/ui';
import faviconDark from '~/assets/favicons/favicon-dark.svg';
import faviconLight from '~/assets/favicons/favicon-light.svg';

const lang = getLangFromUrl(Astro);
const homeUrl = lang === 'es' ? '/' : `/${lang}/`;
---

<a class="flex items-center shrink-0" href={homeUrl}>
  <span translate="no" class="notranslate inline-flex items-center gap-2 font-montserrat font-bold text-2xl tracking-wider text-[#140092] dark:text-[#f3f4f6] uppercase">
    <img 
      src={faviconLight.src} 
      alt="OpenAndes" 
      class="h-8 w-auto hidden dark:block"
    />
    <img 
      src={faviconDark.src} 
      alt="OpenAndes" 
      class="h-8 w-auto block dark:hidden"
    />
    OPEN ANDES
  </span>
</a>
