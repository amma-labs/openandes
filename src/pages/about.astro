---
import Layout from '~/layouts/PageLayout.astro';
import heroImage from '~/assets/images/10-chasing-climate-change-in-the-arctic-2800.webp';
import { getLangFromUrl } from '~/i18n/ui';

const lang = getLangFromUrl(Astro);
const allData = import.meta.glob('~/data/what-we-do/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = allData[`/src/data/what-we-do/${lang}.json`] ?? allData['/src/data/what-we-do/es.json'];

const metadata = {
  title: data?.metaTitle ?? 'What We Do | Open Andes',
  description: data?.metaDescription ?? 'Inteligencia estratégica para decidir antes que el mercado.',
};

type VisualCard = {
  codigo: string;
  etiqueta: string;
  titulo: string;
  bajada: string;
  imagen: string;
  alt: string;
  cta: string;
  href: string;
};

type LineaAccion = {
  numero: string;
  titulo: string;
  subtitulo: string;
  descripcion: string;
  cta: string;
  href: string;
};

const cards: VisualCard[] = data?.cards ?? [
  {
    codigo: '01',
    etiqueta: 'Poder y Comercio',
    titulo: 'Cuando las potencias chocan, tu balance lo siente',
    bajada: 'Aranceles, tensiones y movimientos en la cima definen dónde se abre o se cierra tu mercado.',
    imagen: 'https://cdn.i-scmp.com/sites/default/files/styles/1020x680/public/d8/images/canvas/2026/11/19/052457e8-d51f-4f1d-8a48-35213deffa5a_3fd49893.jpg?itok=UGw6OONB&v=1795096048',
    alt: 'Encuentro de líderes internacionales en cumbre',
    cta: 'Ver análisis',
    href: '/analysis',
  },
  {
    codigo: '02',
    etiqueta: 'APEC y Reglas Globales',
    titulo: 'La mesa donde se negocian las reglas del juego',
    bajada: 'Leemos qué acuerdos y alianzas marcan la pauta comercial antes de que golpeen tu operación.',
    imagen: 'https://web-cdnprod.aa.com.tr/uploads/Contents/2026/11/19/thumbs_b_c_6697a63728fd82ff910517b6c9dc2653.jpg',
    alt: 'Líderes reunidos en cumbre APEC',
    cta: 'Explorar monitores',
    href: '/monitors',
  },
  {
    codigo: '03',
    etiqueta: 'Rotterdam y Puertos',
    titulo: 'Que tu carga no quede varada en el muelle',
    bajada: 'Rutas clave y terminales como Rotterdam muestran cómo se mueve o se tranca el comercio global.',
    imagen: 'https://www.portofrotterdam.com/sites/default/files/styles/header_landingspage_mobile/public/2022-01/apm-container-terminal.jpg?h=b9b2c2a7&itok=YiVlSb1m',
    alt: 'Terminal de contenedores en el Puerto de Rotterdam',
    cta: 'Revisar reportes',
    href: '/reports',
  },
  {
    codigo: '04',
    etiqueta: 'Agroexportación · Chile',
    titulo: 'La ventana de temporada vale millones',
    bajada: 'En fruta fresca y agroindustria, una traba logística o sanitaria te cuesta el margen del año.',
    imagen: 'https://cdn.blueberriesconsulting.com/2025/02/Cerezas-Chile-2024-25.jpg',
    alt: 'Cerezas chilenas listas para exportación',
    cta: 'Ver reportes',
    href: '/reports',
  },
  {
    codigo: '05',
    etiqueta: 'Cadenas y Alimentos · Perú',
    titulo: 'Lo que pasa en el mar y el campo mueve precios',
    bajada: 'Desde el Pacífico y el agro andino hasta los mercados globales, vigilamos rutas, insumos y riesgos.',
    imagen: 'https://cravingsjournal.com/wp-content/uploads/2018/08/ceviche-con-leche-de-tigre-1.jpg',
    alt: 'Plato de ceviche peruano tradicional',
    cta: 'Explorar monitores',
    href: '/monitors',
  },
  {
    codigo: '06',
    etiqueta: 'Advisory Directo',
    titulo: 'Protege tu próxima jugada antes de firmar',
    bajada: 'Due diligence territorial, lectura de riesgo y briefings directos para directorios que no improvisan.',
    imagen: '/images/posts/shanghai-puerto-1920x1080-1.webp',
    alt: 'Operación portuaria y comercio transpacífico',
    cta: 'Ir a Advisory',
    href: '/advisory',
  },
];

const lineas: LineaAccion[] = data?.lines ?? [
  {
    numero: '01',
    titulo: 'Monitores y Reportes',
    subtitulo: 'El Radar',
    descripcion: 'Seguimiento continuo y análisis estructural sobre infraestructura, cadenas críticas y flujos de capital.',
    cta: 'Ver publicaciones',
    href: '/reports',
  },
  {
    numero: '02',
    titulo: 'Advisory a Medida',
    subtitulo: 'La Solución',
    descripcion: 'Evaluación de riesgo político-territorial y due diligence confidencial para inversiones o expansiones.',
    cta: 'Solicitar briefing',
    href: '/advisory',
  },
  {
    numero: '03',
    titulo: 'Briefings y Escenarios',
    subtitulo: 'La Mesa Chica',
    descripcion: 'Sesiones privadas con directorios y comités para probar escenarios y bajar la incertidumbre antes de actuar.',
    cta: 'Agendar sesión',
    href: 'mailto:contacto@openandes.org?subject=Solicitud%20de%20Briefing%20Ejecutivo',
  },
];
---

<Layout metadata={metadata}>
  <!-- HERO DIRECTO AL GERENTE -->
  <section class="relative min-h-[540px] flex items-center overflow-hidden bg-slate-950">
    <div class="absolute inset-0 z-0">
      <img
        src={heroImage.src}
        alt="Open Andes - What We Do"
        class="w-full h-full object-cover opacity-65"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/35"></div>
    </div>

    <div class="absolute top-0 left-0 right-0 z-10 h-1 bg-[#1344e7]"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 py-20 sm:py-24 w-full">
      <div class="max-w-3xl">
        <span class="inline-block text-xs font-mono-tech font-bold tracking-widest uppercase text-[#6b8cff] mb-4 border border-white/20 px-3.5 py-1.5 rounded-full bg-white/5">
          {data?.heroBadge ?? 'WHAT WE DO · ADELÁNTATE AL QUIEBRE'}
        </span>
        <h1 class="font-sans font-bold text-4xl sm:text-5xl md:text-6xl text-white leading-[1.08] tracking-tight">
          {data?.heroTitle ?? 'Tus números ven el pasado.'}{' '}
          <span class="text-[#6b8cff]">{data?.heroSubtitle ?? 'Nosotros leemos lo que viene.'}</span>
        </h1>
        <p class="mt-5 text-lg sm:text-xl text-slate-200 leading-relaxed max-w-2xl">
          {data?.heroDesc ?? 'Traducimos geopolítica, rutas logísticas y movimientos de capital en decisiones claras para que tu empresa proteja márgenes y no improvise.'}
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/reports"
            class="inline-flex items-center justify-center px-6 py-3.5 bg-[#1344e7] hover:bg-blue-500 text-white font-mono-tech font-bold text-xs uppercase tracking-wider rounded-full transition-colors"
          >
            {data?.primaryCta ?? 'Explorar Reportes'}
          </a>
          <a
            href="mailto:contacto@openandes.org?subject=Solicitud%20de%20Briefing%20Ejecutivo"
            class="inline-flex items-center justify-center px-6 py-3.5 border border-white/30 hover:border-white text-white font-mono-tech font-bold text-xs uppercase tracking-wider rounded-full transition-colors"
          >
            {data?.secondaryCta ?? 'Pedir un Briefing'}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- GRILLA VISUAL DE TARJETAS (EL MUNDO REAL QUE MUEVE EL NEGOCIO) -->
  <section class="py-16 sm:py-24 bg-slate-50 dark:bg-slate-900/40">
    <div class="max-w-6xl mx-auto px-4">
      <header class="mb-12 max-w-3xl">
        <span class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#1344e7] dark:text-blue-400">
          {data?.gridEyebrow ?? 'DONDE SE JUEGA LA PARTIDA'}
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mt-2 mb-3">
          {data?.gridTitle ?? 'Lo que pasa afuera entra directo a tu balance.'}
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          {data?.gridDesc ?? 'Seguimos los focos de poder, puertos, rutas y productos que mueven dinero real entre América Latina, Asia y Norteamérica.'}
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
        {cards.map((card) => (
          <a
            href={card.href}
            class="group flex flex-col bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm hover:shadow-xl hover:border-[#1344e7] transition-all duration-200"
          >
            <div class="relative aspect-[16/10] w-full overflow-hidden bg-slate-900">
              <img
                src={card.imagen}
                alt={card.alt}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 bg-slate-950/85 text-white font-mono-tech font-bold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded">
                {card.codigo} · {card.etiqueta}
              </span>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-[#1344e7] dark:group-hover:text-blue-400 transition-colors leading-snug">
                  {card.titulo}
                </h3>
                <p class="mt-2.5 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  {card.bajada}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-xs font-mono-tech font-bold uppercase tracking-wider text-[#1344e7] dark:text-blue-400">
                <span>{card.cta}</span>
                <span class="group-hover:translate-x-1 transition-transform duration-200">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS (3 LÍNEAS SIN RODEOS) -->
  <section class="py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <header class="mb-12 max-w-2xl">
        <span class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#1344e7] dark:text-blue-400">
          {data?.howEyebrow ?? 'CÓMO OPERAMOS'}
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mt-2">
          {data?.howTitle ?? 'Tres formas concretas de darte ventaja.'}
        </h2>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {lineas.map((linea) => (
          <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl border border-slate-200 dark:border-slate-700 flex flex-col justify-between hover:shadow-lg transition-shadow">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#1344e7] dark:text-blue-400">
                  {linea.numero} · {linea.subtitulo}
                </span>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">
                {linea.titulo}
              </h3>
              <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
                {linea.descripcion}
              </p>
            </div>

            <div class="mt-8">
              <a
                href={linea.href}
                class="inline-flex items-center gap-2 text-xs font-mono-tech font-bold uppercase tracking-wider text-slate-900 dark:text-white hover:text-[#1344e7] dark:hover:text-blue-400 transition-colors"
              >
                {linea.cta} <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL DIRECTO -->
  <section class="py-16 sm:py-20 bg-slate-950 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <span class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#6b8cff]">
        {data?.ctaEyebrow ?? 'CERO HUMO ACADÉMICO'}
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-2 mb-4">
        {data?.ctaTitle ?? '¿Nunca has metido riesgo geopolítico y territorial en tu comité?'}
      </h2>
      <p class="text-lg text-slate-300 mb-8 max-w-2xl mx-auto">
        {data?.ctaDesc ?? 'No necesitas un tratado de 200 páginas. Te entregamos lectura clara, aterrizada a tu operación y lista para decidir.'}
      </p>
      <a
        href="mailto:contacto@openandes.org?subject=Solicitud%20de%20Briefing%20Ejecutivo"
        class="inline-flex items-center justify-center px-8 py-4 bg-[#1344e7] hover:bg-blue-500 text-white font-mono-tech font-bold text-xs sm:text-sm uppercase tracking-wider rounded-full transition-colors"
      >
        {data?.ctaButton ?? 'Hablemos de tu operación'}
      </a>
    </div>
  </section>
</Layout>
