---
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';
import Hero2 from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';

// Importar imágenes locales con nombres limpios y sin espacios
import heroImage from '~/assets/images/religiones-del-mundo.webp';
import funPolitikImage from '~/assets/images/funpolitik-evento-30agosto.webp';
import futureLabImage from '~/assets/images/default.webp';

const lang = getLangFromUrl(Astro);
const t = useTranslations(lang).pages.eventos;

const metadata = {
  title: t.metaTitle,
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline={t.tagline}
    image={{
      src: heroImage.src,
      alt: 'Encuentros y Diálogos OpenAndes',
    }}
  >
    <Fragment slot="title">
      {t.heroTitle}
    </Fragment>

    <Fragment slot="subtitle">
      {t.heroSubtitle}
    </Fragment>

    <div slot="actions" class="flex flex-col sm:flex-row max-w-md gap-4">
      <Button variant="primary" href="https://luma.com/user/FunPolitik" target="_blank" icon="tabler:calendar">
        Agenda FunPolitik
      </Button>
      <Button variant="primary" href="https://luma.com/user/2050lab" target="_blank" icon="tabler:calendar">
        Agenda 2050 Lab
      </Button>
    </div>
  </Hero2>

  <Stats
    title={t.statsTitle}
    subtitle={t.statsSubtitle}
    stats={[
      { amount: '30+', icon: 'tabler:calendar-event', title: t.statEvents },
      { amount: '2', icon: 'tabler:hierarchy', title: t.statLabs },
      { amount: '100%', icon: 'tabler:brand-tabler', title: t.statManagement },
    ]}
  />

  <Content
    isReversed
    items={[
      {
        title: t.contentGeopoliticsTitle,
        description: t.contentGeopoliticsDesc,
        icon: 'tabler:world-latitude',
      },
      {
        title: t.contentTrainingTitle,
        description: t.contentTrainingDesc,
        icon: 'tabler:school',
      },
    ]}
    image={{
      src: funPolitikImage.src,
      alt: 'Sesiones de FunPolitik',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">{t.funPolitikTitle}</h3>
      <p class="text-muted dark:text-slate-400 mb-4">
        {t.funPolitikDesc}
      </p>
    </Fragment>
  </Content>

  <Content
    items={[
      {
        title: t.contentForesightTitle,
        description: t.contentForesightDesc,
        icon: 'tabler:rocket',
      },
      {
        title: t.contentInnovationTitle,
        description: t.contentInnovationDesc,
        icon: 'tabler:shield-check',
      },
    ]}
    image={{
      src: futureLabImage.src,
      alt: 'Sesiones de 2050 Futures Lab',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">{t.lab2050Title}</h3>
      <p class="text-muted dark:text-slate-400 mb-4">
        {t.lab2050Desc}
      </p>
    </Fragment>
  </Content>

  <FAQs
    title={t.faqsTitle}
    items={[
      {
        title: t.faq1Title,
        description: t.faq1Desc,
      },
      {
        title: t.faq2Title,
        description: t.faq2Desc,
      },
      {
        title: t.faq3Title,
        description: t.faq3Desc,
      },
    ]}
  />

  <CallToAction
    id="registro"
    title={t.ctaTitle}
    subtitle={t.ctaSubtitle}
  >
    <div slot="actions" class="flex flex-col sm:flex-row max-w-md gap-4 justify-center">
      <Button variant="primary" href="https://luma.com/user/FunPolitik" target="_blank" icon="tabler:calendar">
        FunPolitik
      </Button>
      <Button variant="primary" href="https://luma.com/user/2050lab" target="_blank" icon="tabler:calendar">
        2050 Lab
      </Button>
    </div>
  </CallToAction>
</Layout>
