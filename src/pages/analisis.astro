---
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import BlogPagination from '~/components/blog/Pagination.astro';
import { getBlogEntries } from '~/utils/blog';

export async function getStaticPaths() {
  const posts = await getBlogEntries();
  const totalPages = Math.ceil(posts.length / 10);
  const paths = [];
  for (let i = 1; i <= totalPages; i++) {
    paths.push({ params: { page: i } });
  }
  return paths;
}

const { page } = Astro.params;
const currentPage = parseInt(page) || 1;
const postsPerPage = 10;
const allPosts = await getBlogEntries();
const totalPages = Math.ceil(allPosts.length / postsPerPage);
const paginatedPosts = allPosts.slice((currentPage - 1) * postsPerPage, currentPage * postsPerPage);

const metadata = {
  title: 'Análisis | OpenAndes',
  description: 'Análisis estratégico y geopolítica aplicada bajo la metodología Narrative-Driven Analysis (NDA).',
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <div class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight font-heading text-slate-900 dark:text-white mb-4">Análisis</h1>
      <p class="text-xl text-muted dark:text-slate-400">Análisis estratégico y geopolítica aplicada bajo la metodología Narrative-Driven Analysis (NDA). Ensayos orientados a exponer las inercias de poder en América Latina.</p>
    </div>

    <BlogList posts={paginatedPosts} />
    <BlogPagination currentPage={currentPage} totalPages={totalPages} baseUrl="/analisis" />
  </section>
</Layout>
