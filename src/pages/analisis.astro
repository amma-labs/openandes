---
import Layout from '~/layouts/PageLayout.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'Análisis | OpenAndes',
  description: 'Ensayos de análisis estratégico y reencuadre geopolítico mediante metodología Narrative-Driven Analysis (NDA).',
};
---

<Layout metadata={metadata}>
  <div class="px-4 sm:px-6 py-12 max-w-7xl mx-auto">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight font-heading text-slate-900 dark:text-white mb-4">Análisis</h1>
        <p class="text-xl text-muted dark:text-slate-400">
          Análisis estratégico y geopolítica aplicada bajo la metodología Narrative-Driven Analysis (NDA). Ensayos orientados a exponer las inercias de poder en América Latina.
        </p>
      </div>
      
      <!-- Blog Latest Posts widget -->
      <BlogLatestPosts />
    </div>
  </div>
</Layout>
