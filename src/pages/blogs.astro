---
import Layout from '~/layouts/PageLayout.astro';
import LastPosts from '~/components/blogs/LastPosts.astro';

// Importar imagen para el hero
import heroImage from '~/assets/images/1-chasing-climate-change-in-the-arctic-2800.jpg';

const metadata = {
  title: 'Blogs — OpenAndes',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section con imagen de fondo -->
  <section class="relative min-h-[450px] flex items-center overflow-hidden">
    <!-- Imagen de fondo -->
    <div class="absolute inset-0 z-0">
      <img 
        src={heroImage.src} 
        alt="Análisis y prospectiva - Open Andes" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/85 via-slate-900/60 to-slate-900/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
    </div>
    
    <!-- Línea decorativa superior -->
    <div class="absolute top-0 left-0 right-0 z-10 h-1 bg-gradient-to-r from-blue-500 via-indigo-400 to-blue-500"></div>
    
    <!-- Contenido del hero -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-3xl">
        <span class="inline-block text-sm font-medium tracking-widest uppercase text-blue-300 mb-4 border border-blue-400/30 px-4 py-1.5 rounded-full backdrop-blur-sm bg-black/20">
          Análisis &amp; Prospectiva
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-5xl font-bold text-white leading-tight">
          Nuestras Publicaciones
        </h1>
        <p class="mt-4 text-lg sm:text-xl text-white/90 max-w-3xl leading-relaxed">
          Análisis coyuntural e internacional de Open Andes dedicada a interpretar los acontecimientos geopolíticos y geoeconómicos en tiempo real. Este espacio aporta la lectura crítica de política exterior, diplomacia y dinámicas de poder que alimenta el marco divulgativo del think tank.
        </p>
        <p class="mt-3 text-base sm:text-lg text-white/80 max-w-3xl leading-relaxed">
          El centro de prospectiva de Open Andes. Estudios con los efectos de la tecnología e innovación en la sociedad, enfocado en anticipar transformaciones sistémicas, proyectar escenarios complejos a 10, 20 y 30 años e investigar el impacto de las tecnologías e innovaciones disruptivas en la sociedad.
        </p>
      </div>
    </div>
  </section>

  <!-- Contenido existente -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Últimas publicaciones -->
    <LastPosts />
  </div>
</Layout>
