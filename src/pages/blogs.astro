---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Blogs — OpenAndes',
};
---

<Layout metadata={metadata}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-6">Blogs</h1>
    <p class="text-lg text-muted mb-8">Artículos, análisis y reflexiones sobre América Latina y el Sur Global.</p>
    
    <div class="grid grid-cols-1 gap-4">
      <div class="p-4 bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a]">
        <h2 class="text-xl font-bold">Próximamente</h2>
        <p class="text-muted">Estamos preparando nuevos artículos y análisis. Suscríbete a nuestro newsletter.</p>
      </div>
    </div>
  </div>
</Layout>
