---
import Layout from '~/layouts/PageLayout.astro';
import LastPosts from '~/components/blogs/LastPosts.astro';
// Importar imagen para el hero
import heroImage from '~/assets/images/1-chasing-climate-change-in-the-arctic-2800.jpg';

// Recopilar todos los tags únicos de posts y miradas
const postsMods = import.meta.glob('../data/post/*.{md,mdx}');
const miradasMods = import.meta.glob('../data/mirada-experta/*.{md,mdx}');

const tagCounts: Record<string, number> = {};

for (const path in postsMods) {
  const mod = await postsMods[path]();
  const tags = mod.frontmatter?.tags || [];
  tags.forEach((t) => {
    const key = t.toLowerCase();
    tagCounts[key] = (tagCounts[key] || 0) + 1;
  });
}

for (const path in miradasMods) {
  const mod = await miradasMods[path]();
  const tags = mod.frontmatter?.tags || [];
  tags.forEach((t) => {
    const key = t.toLowerCase();
    tagCounts[key] = (tagCounts[key] || 0) + 1;
  });
}

const topics = Object.entries(tagCounts)
  .map(([key, count]) => ({
    label: key,
    slug: key.replace(/\s+/g, '-'),
    count,
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const metadata = {
  title: 'Blogs — OpenAndes',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section con imagen de fondo -->
  <section class="relative min-h-[450px] flex items-center overflow-hidden">
    <!-- Imagen de fondo -->
    <div class="absolute inset-0 z-0">
      <img 
        src={heroImage.src} 
        alt="Análisis y prospectiva - Open Andes" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/85 via-slate-900/60 to-slate-900/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
    </div>
    
    <!-- Línea decorativa superior -->
    <div class="absolute top-0 left-0 right-0 z-10 h-1 bg-gradient-to-r from-blue-500 via-indigo-400 to-blue-500"></div>
    
    <!-- Contenido del hero -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-3xl">
        <span class="inline-block text-sm font-medium tracking-widest uppercase text-blue-300 mb-4 border border-blue-400/30 px-4 py-1.5 rounded-full backdrop-blur-sm bg-black/20">
          Análisis &amp; Prospectiva
        </span>
        <h1 class="font-sans text-4xl sm:text-5xl md:text-5xl font-bold text-white leading-tight">
          Nuestras Publicaciones
        </h1>
        <p class="mt-4 text-lg sm:text-xl text-white/90 max-w-3xl leading-relaxed">
          Open Andes tiene a su disposición plataformas de análisis, investigación y prospectiva orientadas a divulgar las transformaciones globales y su impacto en la región.
        </p>
        <p class="mt-3 text-base sm:text-lg text-white/80 max-w-3xl leading-relaxed">
          A través de nuestros espacios editoriales asociados, abordamos la coyuntura internacional y los escenarios de largo plazo desde distintos ángulos metodológicos.
        </p>
      </div>
    </div>
  </section>


  <!-- Explorar por tema -->
  <section class="max-w-5xl mx-auto px-4 py-12 border-t border-[#e8e0d0] dark:border-[#2a2a2a]">
    <h2 class="font-sans font-bold text-2xl sm:text-3xl text-[#1a1410] dark:text-[#f0ece4] mb-6">
      Explorar por tema
    </h2>
    <div class="flex flex-wrap gap-3">
      {topics.map((t) => (
        <a
          href={`/topics/${t.slug}`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#faf8f3] dark:bg-white/5 border border-[#e8e0d0] dark:border-[#2a2a2a] text-[#1a4b8c] dark:text-[#2b6cb5] font-mono-tech text-sm hover:bg-[#1a4b8c] hover:text-white dark:hover:bg-[#2b6cb5] transition-colors"
        >
          <span>{t.label}</span>
          <span class="text-[10px] font-bold text-[#8a8070] dark:text-[#8a8070]">· {t.count}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Contenido existente -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Últimas publicaciones -->
    <LastPosts />

  </div>
</Layout>
