---
import Layout from '~/layouts/PageLayout.astro';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../data/post/*.{md,mdx}');
  const paths = [];
  
  for (const path in posts) {
    const slug = path.split('/').pop().replace(/\.(md|mdx)$/, '');
    paths.push({ params: { slug } });
  }
  
  return paths;
}

const { slug } = Astro.params;
const post = await import(`../../data/post/${slug}.mdx`);

const metadata = {
  title: `${post.frontmatter?.title || 'Artículo'} | OpenAndes`,
  description: post.frontmatter?.excerpt || post.frontmatter?.description || '',
};
---

<Layout metadata={metadata}>
  <article class="mx-auto max-w-3xl px-6 py-12 sm:px-6 sm:py-16 lg:py-20">
    <header class="mb-8">
      <a href="/analisis" class="text-blue-600 dark:text-blue-400 hover:underline text-sm font-medium">&larr; Volver a Análisis</a>
      <h1 class="text-4xl font-serif font-bold mt-4 text-slate-900 dark:text-white">
        {post.frontmatter?.title || 'Sin título'}
      </h1>
      <div class="flex items-center gap-4 mt-3 text-sm text-slate-500 dark:text-slate-400">
        {post.frontmatter?.author && (
          <span>Por {post.frontmatter.author}</span>
        )}
        {post.frontmatter?.publishDate && (
          <time>
            {new Date(post.frontmatter.publishDate).toLocaleDateString('es-ES', { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
          </time>
        )}
      </div>
      {post.frontmatter?.tags && post.frontmatter.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {post.frontmatter.tags.map((tag) => (
            <span class="text-xs bg-slate-100 dark:bg-slate-700 px-2 py-1 rounded-full text-slate-600 dark:text-slate-300">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>
    
    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-serif prose-headings:text-slate-900 dark:prose-headings:text-white">
      <post.Content />
    </div>
  </article>
</Layout>
