---
import Layout from '~/layouts/PageLayout.astro';
import LastPosts from '~/components/blogs/LastPosts.astro';

// Importar imagen para el hero
import heroImage from '~/assets/images/1-chasing-climate-change-in-the-arctic-2800.jpg';

// Cargar miradas expertas
const posts = await Promise.all(
  Object.entries(import.meta.glob('../data/mirada-experta/*.{md,mdx}')).map(async ([path, load]) => {
    const post = await load();
    const slug = path.split('/').pop().replace(/\.(md|mdx)$/, '');
    return {
      ...post,
      slug,
      url: `/miradas/${slug}`,
    };
  })
);

const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.frontmatter?.pubDate || '1970-01-01');
  const dateB = new Date(b.frontmatter?.pubDate || '1970-01-01');
  return dateB - dateA;
});

// Recopilar todos los tags únicos
const tagCounts: Record<string, number> = {};
for (const post of sortedPosts) {
  const tags = post.frontmatter?.tags || [];
  tags.forEach((t) => {
    const key = t.toLowerCase();
    tagCounts[key] = (tagCounts[key] || 0) + 1;
  });
}

const topics = Object.entries(tagCounts)
  .map(([key, count]) => ({
    label: key,
    slug: key.replace(/\s+/g, '-'),
    count,
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const metadata = {
  title: 'Miradas — Open Andes',
  description: 'Comentarios y columnas de expertos sobre geopolítica, economía y poder en América Latina.',
};
---

<Layout metadata={metadata}>
  <!-- Hero con imagen de fondo -->
  <section class="relative min-h-[450px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src={heroImage.src}
        alt="Miradas expertas - Open Andes"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#030712]/90 via-[#030712]/70 to-[#030712]/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#030712]/60 via-transparent to-transparent"></div>
    </div>

    <div class="absolute top-0 left-0 right-0 z-10 h-1 bg-gradient-to-r from-[#1344e7] via-[#1344e7] to-[#1344e7]"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 py-16 sm:py-20">
      <div class="max-w-3xl">
        <span class="inline-block text-sm font-mono-tech font-bold tracking-widest uppercase text-[#e5e7eb] mb-4 border border-[#e5e7eb]/30 px-4 py-1.5 rounded-full backdrop-blur-sm bg-black/20">
          Comentarios
        </span>
        <h1 class="font-sans text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight tracking-tight">
          Miradas expertas
        </h1>
        <div class="mt-6 flex flex-wrap gap-2">
          {topics.map((t) => (
            <a
              href={`/topics/${t.slug}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white font-mono-tech text-xs hover:bg-white/20 transition-colors"
            >
              <span>{t.label}</span>
              <span class="text-[10px] text-white/60">· {t.count}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Listado de miradas -->
  <section class="mx-auto max-w-5xl px-6 py-12">
    {sortedPosts.length === 0 ? (
      <p class="text-center text-[#9ca3af]">No hay publicaciones aún.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedPosts.map((post) => {
          const image = post.frontmatter?.image || 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80';
          return (
            <article class="group rounded-xl overflow-hidden hover:shadow-xl transition-all duration-300 border border-[#e5e7eb] dark:border-[#2a2a2a] bg-white dark:bg-white/5">
              <a href={post.url} class="block">
                <div class="relative h-48 overflow-hidden">
                  <img
                    src={image}
                    alt={post.frontmatter?.title || 'Artículo'}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <span class="absolute top-3 left-3 text-[10px] font-mono-tech font-bold uppercase tracking-widest bg-[#1344e7] text-white px-2.5 py-1 rounded">
                    Mirada Experta
                  </span>
                </div>
                <div class="p-6">
                  <h2 class="text-xl font-sans font-bold mb-2 text-[#111827] dark:text-[#f3f4f6] group-hover:text-[#1344e7] dark:group-hover:text-[#1344e7] transition-colors leading-snug">
                    {post.frontmatter?.title || 'Sin título'}
                  </h2>
                  <p class="text-[#4b5563] dark:text-[#9ca3af] text-sm leading-relaxed line-clamp-2 font-fraunces font-light italic">
                    {post.frontmatter?.excerpt || ''}
                  </p>
                  <div class="flex items-center justify-between mt-4 text-xs text-[#9ca3af]">
                    <span class="font-medium uppercase tracking-wide">{post.frontmatter?.author || ''}</span>
                    {post.frontmatter?.pubDate && (
                      <time>
                        {new Date(post.frontmatter.pubDate).toLocaleDateString('es-ES', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </time>
                    )}
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- Plataformas asociadas -->
  <section class="mx-auto max-w-5xl px-6 py-12 border-t border-[#e5e7eb] dark:border-[#2a2a2a]">
    <h2 class="font-sans font-bold text-xl sm:text-2xl text-[#111827] dark:text-[#f3f4f6] mb-2">
      Plataformas asociadas
    </h2>
    <p class="text-sm text-[#9ca3af] mb-8 font-fraunces font-light italic">
      Espacios editoriales donde Open Andes publica análisis coyuntural y prospectiva de largo plazo.
    </p>
    <LastPosts />
  </section>
</Layout>
