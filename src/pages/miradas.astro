---
import Layout from '~/layouts/PageLayout.astro';
import LastPosts from '~/components/blogs/LastPosts.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';

import heroImage from '~/assets/images/1-chasing-climate-change-in-the-arctic-2800.webp';

const lang = getLangFromUrl(Astro);
const t = useTranslations(lang).pages.miradas;

const locale = (Astro.currentLocale as 'es' | 'en' | 'zh' | undefined) ?? 'es';

const allFiles = import.meta.glob('../data/mirada-experta/*/*.{md,mdx}');
const slugs = new Set<string>();
for (const filepath in allFiles) {
  const m = filepath.match(/\/mirada-experta\/(es|en|zh)\/([^/]+)\.(md|mdx)$/);
  if (m) slugs.add(m[2]);
}

const posts = (
  await Promise.all(
    Array.from(slugs).map(async (slug) => {
      const wanted = `../data/mirada-experta/${locale}/${slug}.mdx`;
      const fallback = `../data/mirada-experta/es/${slug}.mdx`;
      const loader = allFiles[wanted] ?? allFiles[fallback];
      if (!loader) return null;
      const post = await loader();
      return {
        ...post,
        slug,
        locale: allFiles[wanted] ? locale : 'es',
        url: locale === 'es' ? `/miradas/${slug}` : `/${locale}/miradas/${slug}`,
      };
    })
  )
).filter((p): p is NonNullable<typeof p> => p !== null);

const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.frontmatter?.pubDate || '1970-01-01');
  const dateB = new Date(b.frontmatter?.pubDate || '1970-01-01');
  return dateB - dateA;
});

const tagCounts: Record<string, number> = {};
for (const post of sortedPosts) {
  const tags = post.frontmatter?.tags || [];
  tags.forEach((tag) => {
    const key = tag.toLowerCase();
    tagCounts[key] = (tagCounts[key] || 0) + 1;
  });
}

const topics = Object.entries(tagCounts)
  .map(([key, count]) => ({
    label: key,
    slug: key.replace(/\s+/g, '-'),
    count,
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const metadata = {
  title: t.metaTitle,
  description: t.metaDesc,
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-6 py-12 sm:px-6 sm:py-16 lg:py-20">
    <header class="mx-auto mb-8 max-w-3xl text-center">
      <span class="text-sm font-medium tracking-widest uppercase text-blue-600 dark:text-[#5b8def] border border-blue-200 dark:border-[#5b8def]/30 px-3 py-1 rounded-full">
        {t.heroBadge}
      </span>
      <h1 class="text-4xl font-sans font-bold leading-tighter tracking-tighter md:text-5xl mt-4 text-slate-900 dark:text-white">
        {t.heroTitle}
      </h1>
      <div class="mt-4 text-lg font-medium text-slate-700 dark:text-slate-400 md:mt-3 max-w-2xl mx-auto">
        {t.heroDesc}
      </div>
      {topics.length > 0 && (
        <div class="mt-8 flex flex-wrap justify-center gap-2">
          {topics.map((topic) => (
            <a
              href={`${locale === 'es' ? '' : `/${locale}`}/topics/${topic.slug}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white dark:bg-white/5 border border-[#e5e7eb] dark:border-[#2a2a2a] text-[#1344e7] dark:text-[#5b8def] font-mono-tech text-xs hover:bg-[#1344e7] hover:text-white dark:hover:bg-[#1344e7] transition-colors"
            >
              <span>{topic.label}</span>
              <span class="text-[10px] opacity-60">· {topic.count}</span>
            </a>
          ))}
        </div>
      )}
    </header>
  </section>

  <!-- Listado de miradas -->
  <section class="mx-auto max-w-5xl px-6 pb-12 pt-0">
    {sortedPosts.length === 0 ? (
      <p class="text-center text-[#4b5563] dark:text-slate-300">{t.emptyState}</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedPosts.map((post) => {
          const image = post.frontmatter?.image || 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80';
          return (
            <article class="group rounded-xl overflow-hidden hover:shadow-xl transition-all duration-300 border border-[#e5e7eb] dark:border-[#2a2a2a] bg-white dark:bg-white/5">
              <a href={post.url} class="block">
                <div class="relative h-48 overflow-hidden">
                  <img
                    src={image}
                    alt={post.frontmatter?.title || t.articleFallback}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <span class="absolute top-3 left-3 text-[10px] font-mono-tech font-bold uppercase tracking-widest bg-[#1344e7] text-white px-2.5 py-1 rounded">
                    {t.miradasBadge}
                  </span>
                </div>
                <div class="p-6">
                  <h2 class="text-xl font-sans font-bold mb-2 text-[#111827] dark:text-[#f3f4f6] group-hover:text-[#1344e7] dark:group-hover:text-[#1344e7] transition-colors leading-snug">
                    {post.frontmatter?.title || t.noTitle}
                  </h2>
                  <p class="text-[#4b5563] dark:text-slate-300 text-sm leading-relaxed line-clamp-2">
                    {post.frontmatter?.excerpt || ''}
                  </p>
                  <div class="flex items-center justify-between mt-4 text-xs text-[#4b5563] dark:text-slate-300">
                    <span class="font-medium uppercase tracking-wide">{post.frontmatter?.author || ''}</span>
                    {post.frontmatter?.pubDate && (
                      <time>
                        {new Date(post.frontmatter.pubDate).toLocaleDateString(locale === 'es' ? 'es-ES' : locale === 'en' ? 'en-US' : 'zh-CN', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </time>
                    )}
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- Plataformas asociadas -->
  <section class="mx-auto max-w-5xl px-6 py-12 border-t border-[#e5e7eb] dark:border-[#2a2a2a]">
    <h2 class="font-sans font-bold text-xl sm:text-2xl text-[#111827] dark:text-[#f3f4f6] mb-2">
      {t.platformsTitle}
    </h2>
    <p class="text-sm text-[#4b5563] dark:text-slate-300 mb-8">
      {t.platformsDesc}
    </p>
    <LastPosts />
  </section>
</Layout>
