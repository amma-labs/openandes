---
// src/pages/what-we-do.astro
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl } from '~/i18n/ui';

const rawLang = getLangFromUrl(Astro);
const lang: 'es' | 'en' | 'zh' =
  rawLang === 'en' || rawLang === 'zh' ? rawLang : 'es';

const allData = import.meta.glob('~/data/what-we-do/*.json', {
  eager: true,
  import: 'default',
}) as Record<string, any>;

const fallbackData = {
  es: {
    metaTitle: 'Qué hacemos | Open Andes',
    metaDescription:
      'El mañana ya empezó. Inteligencia geopolítica, comercial y territorial para decidir antes que el mercado.',
    heroKicker: 'El mañana ya empezó',
    heroTitle: 'Cuando el tablero cambia, el que llega tarde paga el pato.',
    heroDesc:
      'Tus estados financieros muestran dónde estuviste; nosotros leemos qué se está moviendo en geopolítica, comercio, puertos y territorios para que tu negocio no reaccione a ciegas.',
    ctaPrimary: 'Explorar análisis',
    ctaSecondary: 'Hablemos',
    cardsTitle: 'Lo que pasa afuera entra directo a tu operación.',
    cardsDesc: 'Donde un movimiento externo cambia el costo o el ritmo del negocio.',
    cards: [
      {
        title: 'Márgenes bajo presión',
        desc: 'Un cambio normativo, un arancel o un salto en costos clave te come el margen sin que el presupuesto lo haya visto venir.',
        alt: 'Fruta de exportación desde Chile',
      },
      {
        title: 'Carga y rutas que se trancan',
        desc: 'Puertos saturados, desvíos o cuellos de botella en corredores críticos frenan entregas, encarecen fletes y tensionan a toda la cadena.',
        alt: 'Terminal de contenedores en el Puerto de Rotterdam',
      },
      {
        title: 'Capital expuesto en terreno',
        desc: 'Entrar a un mercado, expandir una operación o sostener un activo choca con fricciones políticas, sociales o regulatorias que no salen en un Excel.',
        alt: 'Encuentro de líderes internacionales en cumbre',
      },
      {
        title: 'Decisiones a contrarreloj',
        desc: 'Cuando las grandes potencias y foros regionales redefinen reglas, enterarse por la prensa es llegar tarde a ajustar estrategia.',
        alt: 'Líderes reunidos en cumbre APEC',
      },
    ],
    blocks: [
      {
        title: 'Monitores y Reportes',
        desc: 'Seguimiento continuo y lectura estructurada sobre comercio, infraestructura y tensiones en el Pacífico y las Américas. Ideal para tener el radar encendido y detectar señales antes de que estallen.',
        cta: 'Explorar reportes',
        alt: 'Operación portuaria y comercio transpacífico',
      },
      {
        title: 'Asesorías y Consultorías',
        desc: 'Trabajo directo y confidencial para cuando tienes una decisión crítica encima: evaluar riesgos antes de invertir, leer un escenario complejo o preparar a tu directorio con criterio de terreno.',
        cta: 'Ver asesorías y consultorías',
        alt: 'Dinámica financiera y comercial entre divisas y mercados',
      },
    ],
    manifestoTitle: 'Dejar la geopolítica y el riesgo territorial para después sale caro.',
    manifestoCta: 'Escribir a Open Andes',
    objectionTitle: '¿Nunca has llevado el riesgo geopolítico y territorial a la mesa de decisión?',
    objectionDesc:
      'No necesitas un tratado académico. Te entregamos lectura directa, aterrizada al negocio y lista para discutir.',
    objectionCta: 'Ver publicaciones',
    closingLine: 'El mañana ya empezó.',
    closingCta: 'Contactar',
  },
  en: {
    metaTitle: 'What We Do | Open Andes',
    metaDescription:
      'Tomorrow has already started. Geopolitical, trade, and territorial intelligence to decide ahead of the market.',
    heroKicker: 'Tomorrow has already started',
    heroTitle: 'When the board shifts, whoever arrives late pays the price.',
    heroDesc:
      'Financial statements show where you have been; we track what is moving across geopolitics, trade, ports, and territories so your business is not reacting blind.',
    ctaPrimary: 'Explore analysis',
    ctaSecondary: 'Let’s talk',
    cardsTitle: 'What happens outside reaches your operation directly.',
    cardsDesc: 'Where an external shift changes the cost or pace of business.',
    cards: [
      {
        title: 'Margins under pressure',
        desc: 'A regulatory shift, tariff, or jump in key inputs erodes margin before the budget ever saw it coming.',
        alt: 'Export fruit from Chile',
      },
      {
        title: 'Cargo and routes that stall',
        desc: 'Congested ports, detours, or bottlenecks along key corridors slow deliveries, push up freight, and strain the chain.',
        alt: 'Container terminal at the Port of Rotterdam',
      },
      {
        title: 'Capital exposed on the ground',
        desc: 'Entering a market, expanding an operation, or holding an asset runs into political, social, or regulatory friction that never shows up in a spreadsheet.',
        alt: 'International leaders meeting at a summit',
      },
      {
        title: 'Decisions against the clock',
        desc: 'When major powers and regional forums rewrite the rules, catching it in the press means adjusting strategy too late.',
        alt: 'Leaders gathered at an APEC summit',
      },
    ],
    blocks: [
      {
        title: 'Monitors & Reports',
        desc: 'Ongoing tracking and structured reading on trade, infrastructure, and tensions across the Pacific and the Americas. Built to keep your radar on and spot signals early.',
        cta: 'Explore reports',
        alt: 'Port operations and transpacific trade',
      },
      {
        title: 'Advisory & Consulting',
        desc: 'Direct, confidential work when a critical call is in front of you: assessing risk before investing, reading a complex environment, or briefing your board with ground-level judgment.',
        cta: 'See advisory & consulting',
        alt: 'Currency and market dynamics',
      },
    ],
    manifestoTitle: 'Putting geopolitics and territorial risk off until later gets expensive.',
    manifestoCta: 'Write to Open Andes',
    objectionTitle: 'Never brought geopolitical and territorial risk to the decision table?',
    objectionDesc:
      'You do not need an academic treatise. You get direct reading, grounded in business and ready to discuss.',
    objectionCta: 'See publications',
    closingLine: 'Tomorrow has already started.',
    closingCta: 'Get in touch',
  },
  zh: {
    metaTitle: '业务范围 | Open Andes',
    metaDescription:
      '明天已经开始。助你在市场变化前抢先决策的地缘、贸易与属地情报。',
    heroKicker: '明天已经开始',
    heroTitle: '牌局一变，慢一步的人就要付出代价。',
    heroDesc:
      '财务报表反映的是过去；我们追踪地缘政治、贸易、港口与属地动态，让你在决策时不至于盲目应对。',
    ctaPrimary: '浏览分析',
    ctaSecondary: '预约交流',
    cardsTitle: '外部的动向，会直接传导到你的业务一线。',
    cardsDesc: '当外部变化改变业务成本或节奏时。',
    cards: [
      {
        title: '利润率承压',
        desc: '监管变动、关税调整或关键成本跳升，往往在预算察觉之前就已吞噬利润。',
        alt: '智利出口水果',
      },
      {
        title: '货运与航线卡点',
        desc: '港口拥堵、绕行或关键通道受阻，会拖慢交付、推高运费并拉紧整条链条。',
        alt: '鹿特丹港集装箱码头',
      },
      {
        title: '属地资本暴露',
        desc: '进入新市场、扩大业务或守住资产时，常会遇到电子表格里看不见的政治、社会或审批摩擦。',
        alt: '国际领导人峰会会晤',
      },
      {
        title: '与时间赛跑的决策',
        desc: '当大国与区域机制重新改写规则时，等新闻报道出来再调整策略往往已经晚了。',
        alt: 'APEC 峰会领导人合影',
      },
    ],
    blocks: [
      {
        title: '持续监测与报告',
        desc: '围绕太平洋与美洲的贸易、基础设施与局势提供持续追踪与结构化研判，帮你保持雷达在线、提早捕捉信号。',
        cta: '浏览报告',
        alt: '港口作业与跨太平洋贸易',
      },
      {
        title: '咨询与顾问服务',
        desc: '在你面临关键决策时提供直接、保密的支持：在投资前评估风险、研判复杂局势，或以一线视角协助董事会判断。',
        cta: '了解咨询服务',
        alt: '汇率与市场动态',
      },
    ],
    manifestoTitle: '把地缘与属地风险往后拖，代价往往很高。',
    manifestoCta: '联系 Open Andes',
    objectionTitle: '还没有把地缘与属地风险带进决策会？',
    objectionDesc:
      '你不需要冗长的学术长文。我们给你的是贴近业务、拿得出手、适合直接讨论的判断。',
    objectionCta: '查看出版物',
    closingLine: '明天已经开始。',
    closingCta: '联系我们',
  },
};

const data = allData[`/src/data/what-we-do/${lang}.json`] ?? fallbackData[lang];

const metadata = {
  title: data.metaTitle,
  description: data.metaDescription,
};

const images = {
  agro: '/images/posts/Conoce-principales-frutas-Chile-exporta-mundo1.webp',
  rotterdam: '/images/posts/rotterdam.webp',
  summit: '/images/posts/thumbs_b_c_6697a63728fd82ff910517b6c9dc2653.webp',
  apec: '/images/posts/shanghai-puerto-1920x1080-1.webp',
  port: '/images/posts/rotterdam.webp',
  markets: '/images/posts/yuan-dollar.webp',
};

const fourCards = [
  { ...data.cards[0], image: images.agro },
  { ...data.cards[1], image: images.rotterdam },
  { ...data.cards[2], image: images.summit },
  { ...data.cards[3], image: images.apec },
];

const prefix = lang === 'es' ? '' : `/${lang}`;
const analysisHref = `${prefix}/analysis`;
const researchHref = `${prefix}/research`;
const advisoryHref = `${prefix}/advisory`;

const alternateBlocks = [
  {
    ...data.blocks[0],
    href: researchHref,
    image: images.port,
    imgRight: true,
  },
  {
    ...data.blocks[1],
    href: advisoryHref,
    image: images.markets,
    imgRight: false,
  },
];

const mailtoHref =
  lang === 'en'
    ? 'mailto:contacto@openandes.org?subject=Open%20Andes%20Conversation'
    : lang === 'zh'
      ? 'mailto:contacto@openandes.org?subject=%E4%B8%8E%20Open%20Andes%20%E4%BA%A4%E6%B5%81'
      : 'mailto:contacto@openandes.org?subject=Conversaci%C3%B3n%20con%20Open%20Andes';
---

<Layout metadata={metadata}>
  <div class="bg-white text-neutral-950">
    <!-- BLOQUE OSCURO SUPERIOR (IMPACTO INICIAL) -->
    <section class="bg-neutral-950 text-white py-16 sm:py-24 border-b border-neutral-800">
      <div class="max-w-6xl mx-auto px-6 sm:px-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 grid grid-cols-2 gap-4">
          <div class="aspect-[4/3] overflow-hidden rounded-lg bg-neutral-900">
            <img src={fourCards[2].image} alt={fourCards[2].alt} class="h-full w-full object-cover" />
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-lg bg-neutral-900 mt-6">
            <img src={fourCards[1].image} alt={fourCards[1].alt} class="h-full w-full object-cover" />
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-lg bg-neutral-900 -mt-3">
            <img src={fourCards[3].image} alt={fourCards[3].alt} class="h-full w-full object-cover" />
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-lg bg-neutral-900 mt-3">
            <img src={fourCards[0].image} alt={fourCards[0].alt} class="h-full w-full object-cover" />
          </div>
        </div>

        <div class="lg:col-span-6 space-y-5">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-400">
            {data.heroKicker}
          </p>
          <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight leading-[1.08]">
            {data.heroTitle}
          </h1>
          <p class="text-sm sm:text-base text-neutral-300 leading-relaxed max-w-xl">
            {data.heroDesc}
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <a
              href={analysisHref}
              class="rounded-full bg-white px-5 py-2.5 text-xs sm:text-sm font-medium text-neutral-950 hover:bg-[#1344e7] hover:text-white transition-colors"
            >
              {data.ctaPrimary}
            </a>
            <a
              href={mailtoHref}
              class="rounded-full border border-neutral-600 px-5 py-2.5 text-xs sm:text-sm font-medium text-white hover:border-white transition-colors"
            >
              {data.ctaSecondary}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 TARJETAS CON FOTO ARRIBA -->
    <section class="max-w-6xl mx-auto px-6 sm:px-10 py-16 sm:py-24">
      <div class="max-w-2xl mb-10">
        <h2 class="text-2xl sm:text-4xl font-semibold tracking-tight text-neutral-950">
          {data.cardsTitle}
        </h2>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 leading-relaxed">
          {data.cardsDesc}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          fourCards.map((card) => (
            <div class="rounded-xl bg-neutral-100/90 overflow-hidden flex flex-col">
              <div class="aspect-[16/10] w-full overflow-hidden bg-neutral-200">
                <img
                  src={card.image}
                  alt={card.alt}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="p-5 flex-1 flex flex-col justify-between space-y-2">
                <h3 class="text-base font-semibold text-neutral-950">
                  {card.title}
                </h3>
                <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
                  {card.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- BLOQUES ALTERNADOS -->
    <section class="max-w-6xl mx-auto px-6 sm:px-10 pb-16 sm:pb-24 space-y-20">
      {
        alternateBlocks.map((block) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
            <div
              class:list={[
                'md:col-span-5 space-y-4',
                block.imgRight ? 'md:order-1' : 'md:order-2',
              ]}
            >
              <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-950">
                {block.title}
              </h3>
              <p class="text-sm sm:text-base text-neutral-600 leading-relaxed">
                {block.desc}
              </p>
              <div class="pt-1">
                <a
                  href={block.href}
                  class="inline-flex items-center rounded-full border border-neutral-950 px-5 py-2 text-xs sm:text-sm font-medium text-neutral-950 hover:bg-neutral-950 hover:text-white transition-colors"
                >
                  {block.cta}
                </a>
              </div>
            </div>

            <div
              class:list={[
                'md:col-span-7',
                block.imgRight ? 'md:order-2' : 'md:order-1',
              ]}
            >
              <div class="aspect-[16/10] w-full overflow-hidden rounded-xl bg-neutral-100">
                <img
                  src={block.image}
                  alt={block.alt}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
            </div>
          </div>
        ))
      }
    </section>

    <!-- MANIFIESTO CENTRAL + TARJETA FLOTANTE SOBRE IMAGEN -->
    <section class="bg-neutral-100/70 py-16 sm:py-24 border-t border-neutral-200/80">
      <div class="max-w-5xl mx-auto px-6 sm:px-10 text-center space-y-6">
        <h2 class="text-2xl sm:text-4xl font-semibold tracking-tight text-neutral-950 max-w-2xl mx-auto leading-tight">
          {data.manifestoTitle}
        </h2>
        <div>
          <a
            href={mailtoHref}
            class="inline-flex items-center rounded-full bg-neutral-950 px-6 py-2.5 text-xs sm:text-sm font-medium text-white hover:bg-[#1344e7] transition-colors"
          >
            {data.manifestoCta}
          </a>
        </div>

        <div class="pt-8">
          <div class="relative rounded-2xl overflow-hidden min-h-[280px] sm:min-h-[340px] flex items-center bg-neutral-900 text-left">
            <img
              src={fourCards[1].image}
              alt={fourCards[1].alt}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover opacity-75"
            />
            <div class="relative z-10 m-5 sm:m-10 max-w-md rounded-xl bg-white p-6 sm:p-8 shadow-lg space-y-3">
              <h3 class="text-lg sm:text-xl font-semibold text-neutral-950">
                {data.objectionTitle}
              </h3>
              <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
                {data.objectionDesc}
              </p>
              <div class="pt-1">
                <a
                  href={analysisHref}
                  class="inline-flex items-center rounded-full border border-neutral-950 px-4 py-2 text-xs font-medium text-neutral-950 hover:bg-neutral-950 hover:text-white transition-colors"
                >
                  {data.objectionCta}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CIERRE SECO -->
    <section class="bg-neutral-950 text-white py-14 sm:py-16">
      <div class="max-w-6xl mx-auto px-6 sm:px-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-xl sm:text-3xl font-semibold tracking-tight">
          {data.closingLine}
        </p>
        <a
          href={mailtoHref}
          class="inline-flex items-center rounded-full bg-white px-5 py-2.5 text-xs sm:text-sm font-medium text-neutral-950 hover:bg-[#1344e7] hover:text-white transition-colors self-start sm:self-auto"
        >
          {data.closingCta}
        </a>
      </div>
    </section>
  </div>
</Layout>
