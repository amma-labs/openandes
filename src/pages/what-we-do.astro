---
// src/pages/what-we-do.astro
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl } from '~/i18n/ui';

const rawLang = getLangFromUrl(Astro);
const lang: 'es' | 'en' | 'zh' =
  rawLang === 'en' || rawLang === 'zh' ? rawLang : 'es';

const allData = import.meta.glob('~/data/what-we-do/*.json', {
  eager: true,
  import: 'default',
}) as Record<string, any>;

const fallbackData = {
  es: {
    metaTitle: 'What We Do | Open Andes',
    metaDescription: 'El mañana ya empezó. Inteligencia estratégica para decidir antes que el mercado.',
    heroKicker: 'El mañana ya empezó',
    heroTitle: 'Inteligencia para decidir antes que el mercado.',
    heroDesc:
      'Tus números ven el pasado. En Open Andes leemos geopolítica, puertos, comercio y riesgo real para que gerencias y directorios protejan su negocio.',
    ctaPrimary: 'Ver reportes',
    ctaSecondary: 'Pedir un briefing',
    cardsTitle: 'Lo que mueve el tablero entra a tu balance.',
    cardsDesc:
      'Conectamos cumbres, rutas marítimas, agro y cadenas de suministro con decisiones concretas para tu operación.',
    cards: [
      {
        title: 'Protege tus márgenes',
        desc: 'Anticípate a cambios regulatorios, trabas en insumos y shocks externos antes de que golpeen tu resultado.',
        alt: 'Fruta de exportación desde Chile',
      },
      {
        title: 'Evita cuellos de botella',
        desc: 'Lee puertos, corredores y rutas críticas para que tu carga y tus cadenas no queden varadas.',
        alt: 'Terminal de contenedores en el Puerto de Rotterdam',
      },
      {
        title: 'Blinda tu capital',
        desc: 'Evalúa riesgo político, territorial y de mercado antes de comprometer inversión o cerrar acuerdos.',
        alt: 'Encuentro de líderes internacionales en cumbre',
      },
      {
        title: 'Decide con ventaja',
        desc: 'Sigue las mesas donde se negocian las reglas entre América Latina, Asia y EE. UU. antes que todos.',
        alt: 'Líderes reunidos en cumbre APEC',
      },
    ],
    blocks: [
      {
        title: 'Monitores y Reportes',
        desc: 'Seguimiento continuo de infraestructura, flujos comerciales y cadenas críticas en el Pacífico y las Américas. Lectura clara para ver qué se mueve hoy y qué viene después.',
        cta: 'Explorar reportes',
        alt: 'Operación portuaria y comercio transpacífico',
      },
      {
        title: 'Advisory a Medida',
        desc: 'Análisis confidencial y lectura de riesgo territorial para decisiones de inversión, expansión o continuidad operativa. Directo al grano para directorios y gerencias.',
        cta: 'Ver Advisory',
        alt: 'Cadena alimentaria y recursos del Pacífico',
      },
    ],
    manifestoTitle: 'Lee el cambio antes de que te cueste margen. Muévete con claridad.',
    manifestoCta: 'Pedir un briefing',
    objectionTitle: '¿Nunca has sumado riesgo geopolítico y territorial a tu comité?',
    objectionDesc:
      'No necesitas un tratado académico. Te entregamos lectura directa, aterrizada al negocio y lista para decidir.',
    objectionCta: 'Ver cómo funciona',
    closingLine: 'El mañana ya empezó.',
    closingCta: 'Hablemos',
  },
  en: {
    metaTitle: 'What We Do | Open Andes',
    metaDescription: 'Tomorrow has already started. Strategic intelligence to decide ahead of the market.',
    heroKicker: 'Tomorrow has already started',
    heroTitle: 'Intelligence to decide ahead of the market.',
    heroDesc:
      'Your numbers look at yesterday. At Open Andes we read geopolitics, ports, trade, and real-world risk so executives and boards protect their business.',
    ctaPrimary: 'View reports',
    ctaSecondary: 'Request a briefing',
    cardsTitle: 'What moves the board hits your bottom line.',
    cardsDesc:
      'We connect summits, shipping lanes, agribusiness, and supply chains with concrete decisions for your operation.',
    cards: [
      {
        title: 'Protect your margins',
        desc: 'Spot regulatory shifts, input bottlenecks, and external shocks before they hit your P&L.',
        alt: 'Export fruit from Chile',
      },
      {
        title: 'Avoid bottlenecks',
        desc: 'Track ports, corridors, and critical routes so your cargo and supply chains keep moving.',
        alt: 'Container terminal at the Port of Rotterdam',
      },
      {
        title: 'Ring-fence your capital',
        desc: 'Assess political, territorial, and market risk before committing capital or closing deals.',
        alt: 'International leaders meeting at a summit',
      },
      {
        title: 'Decide with an edge',
        desc: 'Follow the tables where rules are set across Latin America, Asia, and the U.S. before everyone else.',
        alt: 'Leaders gathered at an APEC summit',
      },
    ],
    blocks: [
      {
        title: 'Monitors & Reports',
        desc: 'Ongoing tracking of infrastructure, trade flows, and critical supply chains across the Pacific and the Americas. Clear reading on what moves today and what comes next.',
        cta: 'Explore reports',
        alt: 'Port operations and transpacific trade',
      },
      {
        title: 'Bespoke Advisory',
        desc: 'Confidential analysis and territorial risk assessment for investment, expansion, or operational continuity. Straight to the point for boards and executives.',
        cta: 'See Advisory',
        alt: 'Food chain and Pacific resources',
      },
    ],
    manifestoTitle: 'Read the shift before it costs you margin. Move with clarity.',
    manifestoCta: 'Request a briefing',
    objectionTitle: 'Never brought geopolitical and territorial risk into your committee?',
    objectionDesc:
      'You do not need an academic treatise. You get direct reading, grounded in business and ready for action.',
    objectionCta: 'See how it works',
    closingLine: 'Tomorrow has already started.',
    closingCta: "Let's talk",
  },
  zh: {
    metaTitle: '业务范围 | Open Andes',
    metaDescription: '明天已经开始。助你在市场变化前抢先决策的战略情报。',
    heroKicker: '明天已经开始',
    heroTitle: '在市场变化前抢先决策的情报。',
    heroDesc:
      '财务报表看的是过去。在 Open Andes，我们研判地缘政治、港口、贸易与真实风险，帮助高管与董事会守住业务与利润。',
    ctaPrimary: '查看报告',
    ctaSecondary: '预约简报',
    cardsTitle: '牌桌上的变化，直接影响你的损益表。',
    cardsDesc:
      '我们将峰会动向、航运通道、农业与供应链与你的实际业务决策直接打通。',
    cards: [
      {
        title: '守住利润率',
        desc: '在监管变动、原材料卡点和外部冲击击穿利润前提前预判。',
        alt: '智利出口水果',
      },
      {
        title: '避开供应链堵点',
        desc: '盯紧港口、走廊与关键航线，让你的货物与供应链顺畅流转。',
        alt: '鹿特丹港集装箱码头',
      },
      {
        title: '稳住资本安全',
        desc: '在投入资金或拍板交易前，评估政治、属地与市场风险。',
        alt: '国际领导人峰会会晤',
      },
      {
        title: '抢占决策先机',
        desc: '先人一步看懂拉美、亚太与美国之间正在改写商业规则的谈判桌。',
        alt: 'APEC 峰会领导人合影',
      },
    ],
    blocks: [
      {
        title: '持续监测与报告',
        desc: '持续追踪太平洋与美洲的基础设施、贸易流向与关键供应链。清晰拆解当下动向与下一步棋局。',
        cta: '浏览报告',
        alt: '港口作业与跨太平洋贸易',
      },
      {
        title: '定制咨询（Advisory）',
        desc: '围绕投资、扩张或业务连续性提供保密研判与属地风险评估。直击重点，服务董事会与管理层。',
        cta: '了解 Advisory',
        alt: '食品供应链与太平洋资源',
      },
    ],
    manifestoTitle: '在侵蚀利润之前看清变局，果断行动。',
    manifestoCta: '预约简报',
    objectionTitle: '还没有把地缘与属地风险纳入决策会？',
    objectionDesc:
      '你不需要冗长的学术论文。我们给你的是贴近业务、拿来就能拍板的直白判断。',
    objectionCta: '了解运作方式',
    closingLine: '明天已经开始。',
    closingCta: '联系我们',
  },
};

const data = allData[`/src/data/what-we-do/${lang}.json`] ?? fallbackData[lang];

const metadata = {
  title: data.metaTitle,
  description: data.metaDescription,
};

const images = {
  agro: '/images/posts/Conoce-principales-frutas-Chile-exporta-mundo1.webp',
  rotterdam:
    '/images/posts/rotterdam.webp',
  summit:
    'https://cdn.i-scmp.com/sites/default/files/styles/1020x680/public/d8/images/canvas/2026/11/19/052457e8-d51f-4f1d-8a48-35213deffa5a_3fd49893.jpg?itok=UGw6OONB&v=1795096048',
  apec: '/images/posts/thumbs_b_c_6697a63728fd82ff910517b6c9dc2653.webp',
  port: '/images/posts/shanghai-puerto-1920x1080-1.webp',
  food: '/images/posts/yuan-dollar.webp',
};

const fourCards = [
  { ...data.cards[0], image: images.agro },
  { ...data.cards[1], image: images.rotterdam },
  { ...data.cards[2], image: images.summit },
  { ...data.cards[3], image: images.apec },
];

const alternateBlocks = [
  {
    ...data.blocks[0],
    href: lang === 'es' ? '/reports' : `/${lang}/reports`,
    image: images.port,
    imgRight: true,
  },
  {
    ...data.blocks[1],
    href: lang === 'es' ? '/advisory' : `/${lang}/advisory`,
    image: images.food,
    imgRight: false,
  },
];

const mailtoHref =
  lang === 'en'
    ? 'mailto:contacto@openandes.org?subject=Briefing%20Request'
    : lang === 'zh'
      ? 'mailto:contacto@openandes.org?subject=%E9%A2%84%E7%BA%A6%E9%AB%98%E7%AE%A1%E7%AE%80%E6%8A%A5'
      : 'mailto:contacto@openandes.org?subject=Solicitud%20de%20Briefing%20Ejecutivo';

const reportsHref = lang === 'es' ? '/reports' : `/${lang}/reports`;
---

<Layout metadata={metadata}>
  <div class="bg-white text-neutral-950">
    <!-- BLOQUE OSCURO SUPERIOR (IMPACTO INICIAL) -->
    <section class="bg-neutral-950 text-white py-16 sm:py-24 border-b border-neutral-800">
      <div class="max-w-6xl mx-auto px-6 sm:px-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 grid grid-cols-2 gap-4">
          <div class="aspect-[4/3] overflow-hidden rounded-lg bg-neutral-900">
            <img src={fourCards[2].image} alt={fourCards[2].alt} class="h-full w-full object-cover" />
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-lg bg-neutral-900 mt-6">
            <img src={fourCards[1].image} alt={fourCards[1].alt} class="h-full w-full object-cover" />
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-lg bg-neutral-900 -mt-3">
            <img src={fourCards[3].image} alt={fourCards[3].alt} class="h-full w-full object-cover" />
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-lg bg-neutral-900 mt-3">
            <img src={fourCards[0].image} alt={fourCards[0].alt} class="h-full w-full object-cover" />
          </div>
        </div>

        <div class="lg:col-span-6 space-y-5">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-400">
            {data.heroKicker}
          </p>
          <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight leading-[1.08]">
            {data.heroTitle}
          </h1>
          <p class="text-sm sm:text-base text-neutral-300 leading-relaxed max-w-xl">
            {data.heroDesc}
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <a
              href={reportsHref}
              class="rounded-full bg-white px-5 py-2.5 text-xs sm:text-sm font-medium text-neutral-950 hover:bg-[#1344e7] hover:text-white transition-colors"
            >
              {data.ctaPrimary}
            </a>
            <a
              href={mailtoHref}
              class="rounded-full border border-neutral-600 px-5 py-2.5 text-xs sm:text-sm font-medium text-white hover:border-white transition-colors"
            >
              {data.ctaSecondary}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 TARJETAS CON FOTO ARRIBA -->
    <section class="max-w-6xl mx-auto px-6 sm:px-10 py-16 sm:py-24">
      <div class="max-w-2xl mb-10">
        <h2 class="text-2xl sm:text-4xl font-semibold tracking-tight text-neutral-950">
          {data.cardsTitle}
        </h2>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 leading-relaxed">
          {data.cardsDesc}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          fourCards.map((card) => (
            <div class="rounded-xl bg-neutral-100/90 overflow-hidden flex flex-col">
              <div class="aspect-[16/10] w-full overflow-hidden bg-neutral-200">
                <img
                  src={card.image}
                  alt={card.alt}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="p-5 flex-1 flex flex-col justify-between space-y-2">
                <h3 class="text-base font-semibold text-neutral-950">
                  {card.title}
                </h3>
                <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
                  {card.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- BLOQUES ALTERNADOS -->
    <section class="max-w-6xl mx-auto px-6 sm:px-10 pb-16 sm:pb-24 space-y-20">
      {
        alternateBlocks.map((block) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
            <div
              class:list={[
                'md:col-span-5 space-y-4',
                block.imgRight ? 'md:order-1' : 'md:order-2',
              ]}
            >
              <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-950">
                {block.title}
              </h3>
              <p class="text-sm sm:text-base text-neutral-600 leading-relaxed">
                {block.desc}
              </p>
              <div class="pt-1">
                <a
                  href={block.href}
                  class="inline-flex items-center rounded-full border border-neutral-950 px-5 py-2 text-xs sm:text-sm font-medium text-neutral-950 hover:bg-neutral-950 hover:text-white transition-colors"
                >
                  {block.cta}
                </a>
              </div>
            </div>

            <div
              class:list={[
                'md:col-span-7',
                block.imgRight ? 'md:order-2' : 'md:order-1',
              ]}
            >
              <div class="aspect-[16/10] w-full overflow-hidden rounded-xl bg-neutral-100">
                <img
                  src={block.image}
                  alt={block.alt}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
            </div>
          </div>
        ))
      }
    </section>

    <!-- MANIFIESTO CENTRAL + TARJETA FLOTANTE SOBRE IMAGEN -->
    <section class="bg-neutral-100/70 py-16 sm:py-24 border-t border-neutral-200/80">
      <div class="max-w-5xl mx-auto px-6 sm:px-10 text-center space-y-6">
        <h2 class="text-2xl sm:text-4xl font-semibold tracking-tight text-neutral-950 max-w-2xl mx-auto leading-tight">
          {data.manifestoTitle}
        </h2>
        <div>
          <a
            href={mailtoHref}
            class="inline-flex items-center rounded-full bg-neutral-950 px-6 py-2.5 text-xs sm:text-sm font-medium text-white hover:bg-[#1344e7] transition-colors"
          >
            {data.manifestoCta}
          </a>
        </div>

        <div class="pt-8">
          <div class="relative rounded-2xl overflow-hidden min-h-[280px] sm:min-h-[340px] flex items-center bg-neutral-900 text-left">
            <img
              src={fourCards[1].image}
              alt={fourCards[1].alt}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover opacity-75"
            />
            <div class="relative z-10 m-5 sm:m-10 max-w-md rounded-xl bg-white p-6 sm:p-8 shadow-lg space-y-3">
              <h3 class="text-lg sm:text-xl font-semibold text-neutral-950">
                {data.objectionTitle}
              </h3>
              <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
                {data.objectionDesc}
              </p>
              <div class="pt-1">
                <a
                  href={reportsHref}
                  class="inline-flex items-center rounded-full border border-neutral-950 px-4 py-2 text-xs font-medium text-neutral-950 hover:bg-neutral-950 hover:text-white transition-colors"
                >
                  {data.objectionCta}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CIERRE SECO -->
    <section class="bg-neutral-950 text-white py-14 sm:py-16">
      <div class="max-w-6xl mx-auto px-6 sm:px-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-xl sm:text-3xl font-semibold tracking-tight">
          {data.closingLine}
        </p>
        <a
          href={mailtoHref}
          class="inline-flex items-center rounded-full bg-white px-5 py-2.5 text-xs sm:text-sm font-medium text-neutral-950 hover:bg-[#1344e7] hover:text-white transition-colors self-start sm:self-auto"
        >
          {data.closingCta}
        </a>
      </div>
    </section>
  </div>
</Layout>
