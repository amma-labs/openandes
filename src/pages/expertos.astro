---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Expertos — OpenAndes',
};
---

<Layout metadata={metadata}>
  <div class="font-sans text-[#1a1410] dark:text-[#f0ece4] min-h-screen">
    <section class="py-16 px-4 sm:px-6 mx-auto max-w-7xl">
      
      <!-- ENCABEZADO -->
      <div class="mb-12 border-b border-[#e8e0d0] dark:border-[#2a2a2a] pb-8">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-3 h-3 bg-[#1a4b8c] inline-block rounded-full"></span>
          <span class="text-xs font-mono font-bold tracking-widest uppercase text-[#1a4b8c] dark:text-[#2b6cb5]">
            Directorio Institucional
          </span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-display font-bold tracking-tight text-[#1a1410] dark:text-[#f0ece4]">
          Expertos y Analistas
        </h1>
        <p class="text-[#4a4038] dark:text-[#c8c0b4] text-base sm:text-lg mt-3 max-w-3xl leading-relaxed font-sans">
          Red global de investigadores, directores y especialistas dedicados al análisis estratégico y la prospectiva geopolítica en la Cuenca del Pacífico.
        </p>
      </div>

      <!-- REJILLA DE EXPERTOS -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
        <!-- Aquí va el contenido de los expertos extraído -->
        ${cat /tmp/expertos-content.txt | grep -A100 "const experts = \[" | head -200}
      </div>
    </section>
  </div>
</Layout>
