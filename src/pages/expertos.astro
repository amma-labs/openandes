---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Expertos — OpenAndes',
};

const experts = [
  {
    name: 'Benyi Barros Rojas',
    role: 'Director Ejecutivo',
    spec: 'Análisis geopolítico, política internacional, diplomacia interregional y estudios asiáticos.',
    bio: 'Politólogo y analista internacional especializado en geopolítica, política internacional y estudios asiáticos por la Universidad Nacional Mayor de San Marcos. Fundador y Director General de Fun Politik y del Centro Internacional de Estudios Asiáticos. Cuenta con trayectoria profesional en la Sociedad Peruana de Derecho Internacional (SPDI) y en el Ministerio de Relaciones Exteriores del Perú. Lidera la visión estratégica y las relaciones interregionales de Open Andes.',
    email: 'benyi.barros@openandes.org',
    image: '',
  },
  {
    name: 'Valeria Lavalle',
    role: 'Directora de Desarrollo Institucional',
    spec: 'Arquitectura de alianzas multilaterales, inserción en redes diplomáticas y políticas públicas.',
    bio: 'Bachiller en Relaciones Internacionales por la Universidad San Ignacio de Loyola, con especialización en Diplomacia Internacional y Derecho Espacial. Cofundadora de la Asociación Juvenil Potencia, iniciativa enfocada en fortalecer las capacidades de estudiantes de secundaria. Formó parte del Equipo de Formación Profesional de Junior Achievement Perú y voluntaria en la Academia Into Space. Se desempeña como Directora del Área de Eventos y Cursos en Fun Politik.',
    email: 'brissacg12@gmail.com',
    image: '',
  },
  {
    name: 'Maira Nahiara Oberstar',
    role: 'Directora de Comunicaciones',
    spec: 'Narrativa geopolítica, escritura estratégica, conflictos globales y derechos humanos.',
    bio: 'Especialista en narrativa geopolítica y estrategia editorial. Directora de Comunicaciones en Open Andes y responsable del Área de Redacción en Fun Politik, donde diseña estrategias de análisis y comunicación sobre dinámica internacional, conflictos globales y derechos humanos. Su trabajo enfoca la escritura estratégica y el análisis trilingüe (español, inglés, portugués) como herramientas clave para la prospectiva diplomática y el entendimiento intercultural en la Cuenca del Pacífico y América Latina.',
    email: '',
    image: '',
  },
  {
    name: 'Joaquín Vigueras',
    role: 'Coordinador Operativo & Estrategia',
    spec: 'Arquitectura operativa, modelos analíticos e inteligencia para redes geoeconómicas.',
    bio: 'Especialista en inteligencia para mercados emergentes y exposición a riesgos globales. Research Analyst en 2050 Futures Lab, donde produce escenarios de riesgo país, modelos electorales y notas de crisis para inversión y planificación estratégica. Aplica metodologías estructuradas de planificación de escenarios, seguimiento de señales y análisis político comparado para anticipar disrupciones y apoyar la asignación de capital. Cuenta con experiencia previa como analista financiero y de riesgo en Banco BICE y Banco de Chile.',
    email: 'jvigueras@openandes.org',
    image: '',
  },
  {
    name: 'Anthony Medina Rivas Plata',
    role: 'Asociado Distinguido',
    spec: 'Relaciones internacionales, historia económica, políticas públicas y gobernanza.',
    bio: 'Doctorando en Relaciones Internacionales de la Universidad Nacional de La Plata y Segunda Especialidad en Historia Económica en la Universidad de Buenos Aires (Argentina). Ex Director de la Escuela de Ciencia Política y Gobierno de la Universidad Católica de Santa María (Arequipa). Licenciado en Ciencia Política por la Universidad Nacional Mayor de San Marcos y Doble Máster en Políticas Públicas, Gobernanza y Desarrollo por la Erasmus Rotterdam University-ISS (Holanda) y la University of York (Reino Unido).',
    email: 'amedinar@unmsm.edu.pe',
    image: '',
  },
  {
    name: 'Esteban Silva Navarro',
    role: 'Asociado Distinguido',
    spec: 'Estudios migratorios, relaciones internacionales y análisis de estudios estratégicos.',
    bio: 'Politólogo por la Universidad Nacional Mayor de San Marcos, Master of Arts en Estudios Migratorios por la Universidad de Tel Aviv (Israel). Especialidad en Relaciones Internacionales en la Universidad de Chile. Estudios de Desarrollo en la Justus-Liebig Universität Giessen (Alemania), Administración Pública en la Universidad San Sebastián (Chile) y Estudios Estratégicos en la Universidad Federal Fluminense (Brasil). Director General Adjunto del Instituto de Estudios Políticos Andinos. Vicepresidente del Comité Ejecutivo de la International Association for Political Science Students (IAPSS) – Latin America.',
    email: 'esilva@iepa.org.pe',
    image: '',
  },
  {
    name: 'Francisco Javier Covarrubias Rojas',
    role: 'Líder de Investigación',
    spec: 'Seguridad internacional, diplomacia, cooperación internacional y análisis histórico de relaciones exteriores.',
    bio: 'Cientista Político de la Universidad Diego Portales con minor en Historia y Ciencias Sociales. Magíster en Desarrollo y Cooperación Internacional del Instituto de Estudios Internacionales de la Universidad de Chile. Actualmente candidato a Magíster en Seguridad, Defensa y Relaciones Internacionales de la Academia Nacional de Estudios Políticos y Estratégicos del Ministerio de Defensa Nacional de Chile. Cuenta con experiencia como practicante en la Dirección de Seguridad Internacional y Humana (DISIN) del Ministerio de Relaciones Exteriores, pasante del área internacional de IdeaPaís y asistente de investigación en la Universidad de las Américas como parte del Proyecto FONDECYT titulado "Herencia indeseada y diplomacia en transición: Una nueva historia diplomática de la larga Crisis de las Uvas (1989-1995)".',
    email: 'franciscocovarrubias24@gmail.com',
    image: '',
  },
  {
    name: 'Jimena Valenzuela',
    role: 'Líder de Investigación',
    spec: 'Seguridad internacional, ciberseguridad, cooperación tecnológica y estudios asiáticos.',
    bio: 'Cientista Político de la Pontificia Universidad Católica de Chile, con mención en Relaciones Internacionales, y actualmente cursa un Magíster en Estudios sobre Asia en la Universidad de Chile. Cuenta con un diplomado en Seguridad Internacional de la Universidad de Chile y un diplomado en Traducción de la PUC. Tiene experiencia profesional en la División de Seguridad Internacional y Humana del Ministerio de Relaciones Exteriores de Chile, donde participó en el análisis de política exterior en materias de ciberseguridad y cooperación tecnológica.',
    email: 'jivalenzuelagarrido@gmail.com',
    image: '',
  },
  {
    name: 'Félix Vásquez Suasnábar',
    role: 'Investigador Asociado',
    spec: 'Finanzas, contabilidad, prevención de lavado de activos y análisis de fraudes.',
    bio: 'Licenciado en Administración y Finanzas, y licenciado en Contabilidad por la Universidad Peruana de Ciencias Aplicadas, con especialización en Relaciones Internacionales por la Fundación Academia Diplomática del Perú y egresado del II Curso de Actualidad Internacional de la misma institución. Cuenta con experiencia como consultor senior de EY en proyectos de investigación de fraudes, prevención de lavado de activos y peritajes contables para la resolución de conflictos empresariales. Es redactor de noticias y artículos en la página web de actualidad internacional Fun Politik.',
    email: '',
    image: '',
  },
  {
    name: 'Alexia Thais Laimes Campos',
    role: 'Investigadora Asociada',
    spec: 'Ciencia política, diagnósticos territoriales, mapeo de actores y análisis de riesgos reputacionales.',
    bio: 'Bachiller en Ciencia Política por la Universidad Nacional Mayor de San Marcos con sólida experiencia en investigación académica, consultoría socio-política y gestión pública. Especializada en la formulación de diagnósticos territoriales, mapeo estratégico de actores y análisis de riesgos reputacionales y comunicacionales para proyectos de impacto. Coautora de publicaciones sobre políticas públicas e interculturalidad y redactora en Fun Politik, enfocada en la generación de evidencia técnica y cuantitativa para la toma de decisiones.',
    email: '',
    image: '',
  },
  {
    name: 'Silvana Huamán',
    role: 'Investigadora Asociada',
    spec: 'Derecho penal, ciberdelincuencia, tecnología aplicada al derecho e impacto social.',
    bio: 'Estudiante de 10.° ciclo de Derecho con experiencia en temas penales y fiscales. Actualmente realiza voluntariados en la Fiscalía Especializada en Ciberdelincuencia y en la SENAJU, además de ser redactora en Fun Politik. Participó en programas como el Aspire Leader Program de Harvard Business School, Modelo Académico APEC y el World Bank Youth Summit 2026. Se enfoca en la investigación jurídica, la tecnología aplicada al derecho y el impacto social, siendo parte del Círculo de Estudios de Derecho Informático de la UNMSM.',
    email: '',
    image: '',
  },
  {
    name: 'Lita Paola Picasso Ramírez',
    role: 'Investigadora Asociada',
    spec: 'Ciencia política, relaciones internacionales, políticas públicas y gestión de proyectos con perspectiva de género.',
    bio: 'Licenciada en Ciencia Política y Relaciones Internacionales, con mención en Relaciones Internacionales, por la Universidad Alberto Hurtado. Cuenta con experiencia en el Ministerio de Relaciones Exteriores de Chile, específicamente en la Dirección de Seguridad Internacional (DISIN), así como en investigación de políticas públicas y gestión de proyectos en la Fundación Crea Equidad. Su experiencia integra el análisis político, la investigación, la redacción institucional y la gestión de proyectos, incorporando además una perspectiva de género y un enfoque de gestión cultural. Se caracteriza por su capacidad para comprender las necesidades de distintos contextos y transformarlas en respuestas pertinentes, rigurosas y estratégicas.',
    email: '',
    image: '',
  },
  {
    name: 'Lourdes Agostina Delgado',
    role: 'Investigadora Asociada',
    spec: 'Relaciones internacionales, análisis de política global y asistencia en investigación.',
    bio: 'Tesista de Relaciones Internacionales por la Universidad Nacional de San Martín. Cuenta con experiencia como secretaria de recepción en consultorio médico privado, desarrollando habilidades en asistencia administrativa, recepción telefónica y gestión de oficinas. Actualmente se desempeña como analista y redactora de política global, con interés en la investigación académica y el análisis de coyuntura internacional.',
    email: 'ladelgado@estudiantes.unsam.edu.ar',
    image: '',
  },
  {
  {
    name: 'Aldo Andrés Rijo',
    role: 'Investigador Asociado',
    spec: 'Economía internacional, comercio exterior, integración regional y geoeconomía.',
    bio: 'Licenciado en Relaciones Internacionales y estudiante de Economía en la Universidad de la República (Udelar). Sus áreas de interés se encuentran en la intersección entre la economía, las relaciones internacionales y el análisis político, con especial interés en América Latina y los desafíos del desarrollo económico de la región.',
    email: '',
    image: '',
    linkedin: 'https://www.linkedin.com/in/aldo-andres-r-5a8626194/',
  },
  {
    name: 'Christian Ardila',
    role: 'Investigador Asociado',
    spec: 'Crimen organizado, narcotráfico transnacional, seguridad internacional e inteligencia criminal.',
    bio: 'Licenciado en Relaciones Internacionales y estudiante avanzado de Ciencia Política por la Universidad de Palermo. Especialización en Análisis de Crimen Organizado y Seguridad Internacional por FLACSO Ecuador. Cuenta con experiencia como pasante de investigación en InSight Crime y redactor en Refugio Latinoamericano. Ha publicado artículos sobre crimen organizado, narcotráfico transnacional y seguridad internacional en América Latina. Certificado en inglés C2 y diplomacia global.',
    email: 'christianardila03ar@gmail.com',
    image: '',
  },
  {
    name: 'Álvaro Recabal Cervantes',
    role: 'Investigador Asociado',
    spec: 'Estrategia militar, geopolítica, liderazgo institucional y análisis de conflictos armados.',
    bio: 'Oficial de artillería del Ejército de Chile en condición de retiro con más de 20 años de experiencia en liderazgo estratégico, gestión operativa y asesoría institucional en contextos de alta exigencia. Ha participado en misiones de paz internacionales (EUFOR en Bosnia y Herzegovina, 2011 y 2018), estados de emergencia por catástrofes naturales, crisis sociales y operaciones logísticas durante la pandemia. Magíster en Ciencia Política y en Liderazgo Organizacional. Fundador de Rooster Think Tank. Ejerce como docente universitario y columnista en temas de estrategia, ciencia política y cultura institucional.',
    email: 'ralcaman@hotmail.com',
    image: '',
  },
];
---

<Layout metadata={metadata}>
  <div class="font-sans text-[#1a1410] dark:text-[#f0ece4] min-h-screen">
    <section class="py-16 px-4 sm:px-6 mx-auto max-w-7xl">
      
      <div class="mb-12 border-b border-[#e8e0d0] dark:border-[#2a2a2a] pb-8">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-3 h-3 bg-[#1a4b8c] inline-block rounded-full"></span>
          <span class="text-xs font-mono font-bold tracking-widest uppercase text-[#1a4b8c] dark:text-[#2b6cb5]">
            Directorio Institucional
          </span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-display font-bold tracking-tight text-[#1a1410] dark:text-[#f0ece4]">
          Expertos y Analistas
        </h1>
        <p class="text-[#4a4038] dark:text-[#c8c0b4] text-base sm:text-lg mt-3 max-w-3xl leading-relaxed font-sans">
          Red global de investigadores, directores y especialistas dedicados al análisis estratégico y la prospectiva geopolítica en la Cuenca del Pacífico.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
        {experts.map((expert) => (
          <article class="flex flex-col sm:flex-row gap-5 p-5 rounded-xl bg-white/60 dark:bg-[#1a1a1a]/40 border border-[#e8e0d0] dark:border-[#2a2a2a] shadow-sm hover:shadow-md hover:border-[#1a4b8c]/30 dark:hover:border-[#2b6cb5]/30 transition-all duration-300">
            
            <div class="w-28 h-36 shrink-0 bg-[#f8f4ea] dark:bg-[#1a1a1a] rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a] flex flex-col items-center justify-center overflow-hidden mx-auto sm:mx-0">
              {expert.image ? (
                <img src={expert.image} alt={expert.name} class="w-full h-full object-cover" />
              ) : (
                <div class="text-center p-2">
                  <svg class="w-10 h-10 text-[#d5ccb8] dark:text-[#3a3a3a] mx-auto" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                  <span class="text-[8px] font-mono uppercase text-[#d5ccb8] dark:text-[#3a3a3a] mt-1 block">Perfil</span>
                </div>
              )}
            </div>

            <div class="flex flex-col justify-between flex-grow">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-[#1a4b8c]/10 dark:bg-[#2b6cb5]/10 text-[#1a4b8c] dark:text-[#2b6cb5] border border-[#1a4b8c]/20 dark:border-[#2b6cb5]/20">
                    {expert.role}
                  </span>
                </div>
                <h2 class="text-xl font-display font-bold text-[#1a1410] dark:text-[#f0ece4] tracking-tight mb-2">
                  {expert.name}
                </h2>
                <p class="text-xs text-[#4a4038] dark:text-[#c8c0b4] leading-relaxed font-sans mb-3">
                  {expert.spec}
                </p>
              </div>

              <details class="group pt-3 border-t border-[#e8e0d0] dark:border-[#2a2a2a] mt-2">
                <summary class="cursor-pointer text-xs font-semibold tracking-wide text-[#1a4b8c] dark:text-[#2b6cb5] flex items-center justify-between list-none select-none py-1 hover:opacity-80 transition-opacity font-sans">
                  <span>Ver perfil y trayectoria</span>
                  <span class="transition-transform duration-200 group-open:rotate-180 text-[10px]">▼</span>
                </summary>
                <div class="text-xs text-[#4a4038] dark:text-[#c8c0b4] leading-relaxed mt-3 pt-3 border-t border-[#e8e0d0] dark:border-[#2a2a2a] space-y-3 font-serif">
                  <p>{expert.bio}</p>
                  {expert.email && (
                    <p class="font-mono text-[11px] pt-1">
                      <a href={`mailto:${expert.email}`} class="text-[#1a4b8c] dark:text-[#2b6cb5] hover:underline flex items-center gap-1">
                        <span>✉</span> {expert.email}
                      </a>
                    </p>
                  )}
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>

    </section>
  </div>
</Layout>
