---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Expertos — OpenAndes',
};
---

<Layout metadata={metadata}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-6">Nuestros Expertos</h1>
    <p class="text-lg text-muted mb-8">Conoce a nuestro equipo de investigación y asesoría estratégica.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a]">
        <h2 class="text-xl font-bold mb-2">Investigadores Asociados</h2>
        <ul class="space-y-2 text-muted">
          <li>• Lourdes Agostina Delgado</li>
          <li>• Aldo Andrés Rijo</li>
          <li>• Christian Ardila</li>
          <li>• Álvaro Recabal Cervantes</li>
        </ul>
      </div>
      <div class="p-6 bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a]">
        <h2 class="text-xl font-bold mb-2">Líderes de Investigación</h2>
        <ul class="space-y-2 text-muted">
          <li>• Francisco Javier Covarrubias Rojas</li>
          <li>• Valeria Lavalle</li>
          <li>• Joaquín Vigueras</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
