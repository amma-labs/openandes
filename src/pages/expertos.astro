---
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl } from '~/i18n/ui';

// Importar imagen para el hero
import heroImage from '~/assets/images/19-the-time-between-2500.webp';

const lang = getLangFromUrl(Astro);
const allData = import.meta.glob('~/data/experts/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = allData[`/src/data/experts/${lang}.json`] ?? allData['/src/data/experts/es.json'];

const metadata = {
  title: data.metaTitle,
};

// Alias para mantener el template igual
const experts = data.experts as Array<{
  name: string;
  role: string;
  spec: string;
  bio: string;
  email: string;
  image: string;
}>;

---

<Layout metadata={metadata}>
  <!-- Hero Section con imagen de fondo -->
  <section class="relative min-h-[450px] flex items-center overflow-hidden">
    <!-- Imagen de fondo -->
    <div class="absolute inset-0 z-0">
      <img 
        src={heroImage.src} 
        alt="Expertos y analistas - Open Andes" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/85 via-slate-900/60 to-slate-900/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
    </div>
    
    <!-- Línea decorativa superior -->
    <div class="absolute top-0 left-0 right-0 z-10 h-1 bg-gradient-to-r from-blue-500 via-indigo-400 to-blue-500"></div>
    
    <!-- Contenido del hero -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-3xl">
        <span class="inline-block text-sm font-medium tracking-widest uppercase text-blue-300 mb-4 border border-blue-400/30 px-4 py-1.5 rounded-full backdrop-blur-sm bg-black/20">{data.heroBadge}</span>
        <h1 class="font-sans text-4xl sm:text-5xl md:text-5xl font-bold text-white leading-tight">{data.heroTitle}</h1>
        <p class="mt-4 text-lg sm:text-xl text-white/90 max-w-3xl leading-relaxed">
          {data.heroDesc}
        </p>
      </div>
    </div>
  </section>

  <!-- Contenido de expertos -->
  <div class="max-w-5xl mx-auto px-4 py-16">
    <!-- Grid de expertos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {experts.map((expert) => (
        <div class="group p-6 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-400 hover:shadow-lg transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-24 h-24 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-3xl font-bold text-blue-600 dark:text-blue-400 overflow-hidden">
              {expert.image ? (
                <img
                  src={expert.image}
                  alt={expert.name}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width="512"
                  height="512"
                />
              ) : (
                expert.name.charAt(0)
              )}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {expert.name}
              </h3>
              <p class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-1">
                {expert.role}
              </p>
              <p class="text-sm text-slate-700 dark:text-slate-300">
                {expert.spec}
              </p>
              <details class="mt-3">
                <summary class="text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 cursor-pointer transition-colors">{data.profileToggle}</summary>
                <p class="mt-2 text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                  {expert.bio}
                </p>
                {expert.email && (
                  <a href={`mailto:${expert.email}`} class="inline-block mt-2 text-xs text-blue-600 dark:text-blue-400 hover:underline">
                    {expert.email}
                  </a>
                )}
              </details>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
