---
import Layout from '~/layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';

const lang = getLangFromUrl(Astro);
const t = useTranslations(lang).pages.topics;

const locale = (Astro.currentLocale as 'es' | 'en' | 'zh' | undefined) ?? 'es';

export const prerender = true;

const posts = import.meta.glob('../../data/post/es/*.{md,mdx}');
const miradas = import.meta.glob('../../data/comentarios/es/*.{md,mdx}');
const reports = import.meta.glob('../../content/reports/es/*.{md,mdx}');

const tagCounts: Record<string, { count: number; label: string }> = {};

for (const path in posts) {
  const mod = (await posts[path]()) as { frontmatter?: Record<string, any> };
  const tags = mod.frontmatter?.tags || [];
  tags.forEach((tag: string) => {
    const key = tag.toLowerCase().replace(/\s+/g, '-');
    if (!tagCounts[key]) tagCounts[key] = { count: 0, label: tag };
    tagCounts[key].count++;
  });
}
for (const path in miradas) {
  const mod = (await miradas[path]()) as { frontmatter?: Record<string, any> };
  const tags = mod.frontmatter?.tags || [];
  tags.forEach((tag: string) => {
    const key = tag.toLowerCase().replace(/\s+/g, '-');
    if (!tagCounts[key]) tagCounts[key] = { count: 0, label: tag };
    tagCounts[key].count++;
  });
}
for (const path in reports) {
  const mod = (await reports[path]()) as { frontmatter?: Record<string, any> };
  const tags = mod.frontmatter?.tags || [];
  tags.forEach((tag: string) => {
    const key = tag.toLowerCase().replace(/\s+/g, '-');
    if (!tagCounts[key]) tagCounts[key] = { count: 0, label: tag };
    tagCounts[key].count++;
  });
}

// Top 16 por count, ordenados alfabéticamente dentro del top
const top16 = Object.entries(tagCounts)
  .sort((a, b) => b[1].count - a[1].count)
  .slice(0, 16)
  .sort((a, b) => a[1].label.localeCompare(b[1].label))
  .map(([slug, data]) => ({ slug, label: data.label, count: data.count }));

const top16Slugs = new Set(top16.map((t) => t.slug));

// Resto: alfabético
const rest = Object.entries(tagCounts)
  .filter(([slug]) => !top16Slugs.has(slug))
  .sort((a, b) => a[1].label.localeCompare(b[1].label))
  .map(([slug, data]) => ({ slug, label: data.label, count: data.count }));

const metadata = {
  title: t.indexTitle,
  description: t.indexDesc,
};

// Gradiente para los top 16: de índigo (más usado) a azul claro (menos usado)
const gradientClasses = [
  'bg-indigo-600 text-white',
  'bg-indigo-500 text-white',
  'bg-blue-600 text-white',
  'bg-blue-500 text-white',
  'bg-blue-400 text-white',
  'bg-sky-500 text-white',
  'bg-sky-400 text-white',
  'bg-cyan-500 text-white',
  'bg-cyan-400 text-slate-900',
  'bg-teal-500 text-white',
  'bg-teal-400 text-slate-900',
  'bg-emerald-400 text-slate-900',
  'bg-emerald-300 text-slate-900',
  'bg-lime-300 text-slate-900',
  'bg-amber-300 text-slate-900',
  'bg-amber-200 text-slate-900',
];
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-5xl px-6 py-12 sm:py-16 lg:py-20">
    <header class="mb-10 pb-8 border-b border-[#e5e7eb] dark:border-[#2a2a2a]">
      <span class="text-sm font-medium tracking-widest uppercase text-blue-600 dark:text-[#5b8def] border border-blue-200 dark:border-[#5b8def]/30 px-3 py-1 rounded-full">
        {t.indexBadge}
      </span>
      <h1 class="text-4xl font-sans font-bold mt-6 text-[#111827] dark:text-[#f3f4f6] leading-tight">
        {t.indexHeroTitle}
      </h1>
      <p class="mt-3 text-lg text-[#4b5563] dark:text-[#4b5563] max-w-2xl">
        {t.indexHeroDesc}
      </p>
    </header>

    {top16.length === 0 && rest.length === 0 ? (
      <p class="text-[#4b5563]">{t.emptyState}</p>
    ) : (
      <>
        {top16.length > 0 && (
          <section class="mb-12">
            <h2 class="text-xs font-mono-tech uppercase tracking-widest text-[#4b5563] dark:text-slate-400 mb-4">
              {t.topTopics}
            </h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
              {top16.map((topic, i) => (
                <a
                  href={`${locale === 'es' ? '' : `/${locale}`}/topics/${topic.slug}`}
                  class={`flex items-center justify-center text-center px-4 py-6 rounded-lg font-sans font-bold text-lg leading-tight transition-transform hover:scale-[1.03] ${gradientClasses[i]}`}
                >
                  <span>{topic.label}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {rest.length > 0 && (
          <section>
            <h2 class="text-xs font-mono-tech uppercase tracking-widest text-[#4b5563] dark:text-slate-400 mb-4">
              {t.allTopics}
            </h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
              {rest.map((topic) => (
                <a
                  href={`${locale === 'es' ? '' : `/${locale}`}/topics/${topic.slug}`}
                  class="flex items-center justify-center text-center px-3 py-3 rounded-lg bg-white dark:bg-white/5 border border-[#e5e7eb] dark:border-[#2a2a2a] hover:border-[#1344e7] dark:hover:border-[#5b8def] transition-colors"
                >
                  <span class="font-sans font-medium text-sm text-[#111827] dark:text-[#f3f4f6] truncate">
                    {topic.label}
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </div>
</Layout>
