          </div>
          <h3 class="text-base font-display font-medium text-slate-500 dark:text-slate-400 italic">Informe táctico en redacción...</h3>
        </article>

        <article class="flex flex-col gap-3 p-4 rounded-lg bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 border border-[#e8e0d0] dark:border-[#2a2a2a] opacity-70">
