---
import Layout from '~/layouts/PageLayout.astro';
import RadarWidget from '~/components/widgets/RadarWidget.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '~/i18n/ui';

const lang = getLangFromUrl(Astro);
const t = useTranslations(lang).home;

// Importar posts de Análisis (por locale)
const locale = (Astro.currentLocale as 'es' | 'en' | 'zh' | undefined) ?? 'es';
const allFiles = import.meta.glob('../data/post/*/*.{md,mdx}');
const slugs = new Set<string>();
for (const filepath in allFiles) {
  const m = filepath.match(/\/post\/(es|en|zh)\/([^/]+)\.(md|mdx)$/);
  if (m) slugs.add(m[2]);
}
const posts = (
  await Promise.all(
    Array.from(slugs).map(async (slug) => {
      const wanted = `../data/post/${locale}/${slug}.mdx`;
      const fallback = `../data/post/es/${slug}.mdx`;
      const loader = allFiles[wanted] ?? allFiles[fallback];
      if (!loader) return null;
      const post = await loader();
      return {
        ...post,
        slug,
        locale: allFiles[wanted] ? locale : 'es',
        url: locale === 'es' ? `/analisis/${slug}` : `/${locale}/analisis/${slug}`,
      };
    })
  )
).filter((p): p is NonNullable<typeof p> => p !== null);

// Ordenar por fecha y obtener el más reciente
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.frontmatter?.pubDate || '1970-01-01');
  const dateB = new Date(b.frontmatter?.pubDate || '1970-01-01');
  return dateB - dateA;
});

const todayStr = new Date().toISOString().slice(0, 10);
const visiblePosts = sortedPosts.filter(p => !p.frontmatter?.draft).filter(p => {
  const d = new Date(p.frontmatter?.pubDate || "1970-01-01").toISOString().slice(0, 10);
  return d <= todayStr;
});
const mainPost = visiblePosts[0] || null;

// Importar reportes para el hero
const reports = (await getCollection('reports', ({ data }) => !data.draft && data.lang === locale))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const mainReport = reports[0] || null;
const getReportSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');

// Cargar miradas dinámicamente por locale
const allMiradas = import.meta.glob('../data/mirada-experta/*/*.{md,mdx}');

// Cargar todas las miradas del locale actual (con fallback a ES si no existe)
const miradas = await Promise.all(
  Object.entries(allMiradas)
    .filter(([path]) => path.includes(`/mirada-experta/${locale}/`))
    .map(async ([path, load]) => {
      const post = await load();
      const slug = path.split('/').pop()?.replace(/\.(md|mdx)$/, '') ?? '';
      return {
        ...post,
        slug,
        url: locale === 'es' ? `/miradas/${slug}` : `/${locale}/miradas/${slug}`,
      };
    })
);

// Ordenar por fecha descendente
miradas.sort((a, b) => {
  const dateA = new Date(a.frontmatter?.pubDate || '1970-01-01').getTime();
  const dateB = new Date(b.frontmatter?.pubDate || '1970-01-01').getTime();
  return dateB - dateA;
});

// Primeras 4 para el array briefs
const briefs = miradas.slice(0, 4);

// Miradas 5 y 6 para los bloques destacados
const mirada5 = miradas[4];
const mirada6 = miradas[5];

const metadata = {
  title: t.metaTitle,
  description: t.metaDesc,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="font-sans text-[#111827] dark:text-[#f3f4f6]">

    <!-- ============================================ -->
    <!-- HERO / MAIN GRID                             -->
    <!-- ============================================ -->
    <section class="py-8 px-4 sm:px-6 mx-auto max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">

        <article class="lg:col-span-8 flex flex-col gap-4 font-sans text-center items-center lg:max-w-[700px] lg:mx-auto">
          <div class="flex items-center gap-3">
            <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-400 font-mono-tech font-bold text-xs uppercase px-2.5 py-1 rounded w-max tracking-wide">
              {mainPost ? mainPost.frontmatter?.category || t.categoryFallback : t.categoryFallback}
            </span>
            {mainPost?.frontmatter?.pubDate && (
              <span class="text-xs font-mono-tech font-bold text-[#1344e7] dark:text-[#5b8def] uppercase tracking-tight">
                {new Date(mainPost.frontmatter.pubDate).toLocaleDateString(locale === 'es' ? 'es-ES' : locale === 'en' ? 'en-US' : 'zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>
            )}
          </div>

          <a href={mainPost?.url || '#'} class="group block overflow-hidden rounded-md bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 lg:max-w-[700px] lg:mx-auto">
            <img
              src={mainPost?.frontmatter?.image || 'https://images.unsplash.com/photo-1578575437130-527eed3abbec?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80'}
              alt={mainPost?.frontmatter?.title || t.mainAnalysisAlt}
              class="w-full h-[360px] sm:h-[400px] lg:h-auto lg:aspect-[4/3] object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </a>

          <a href={mainPost?.url || '#'} class="hover:underline">
            <h1 class="text-3xl sm:text-4xl font-fraunces font-normal tracking-tight text-slate-900 dark:text-white leading-tight">
              {mainPost?.frontmatter?.title || t.titleFallback}
            </h1>
          </a>

          <a href={mainPost?.url || '#'} class="block hover:opacity-90">
            <p class="font-fraunces font-normal text-xl text-slate-700 dark:text-slate-300 leading-relaxed italic">
              {mainPost?.frontmatter?.subtitle || mainPost?.frontmatter?.excerpt || ""}
            </p>
          </a>

          <div class="flex items-center gap-3 text-sm text-slate-600 dark:text-slate-400">
            {mainPost?.frontmatter?.author && (
              <span class="font-medium uppercase tracking-wide">{mainPost.frontmatter.author.toUpperCase()}</span>
            )}
          </div>
        </article>

        <aside class="lg:col-span-4 flex flex-col justify-between lg:border-l lg:border-[#e5e7eb] lg:dark:border-[#2a2a2a] lg:pl-8 font-sans h-full">
          <div class="flex flex-col justify-between h-full gap-5">
            {visiblePosts.slice(1, 5).map((post, index, arr) => {
              const frontmatter = post.frontmatter || {};
              const dateStr = frontmatter.pubDate ? new Date(frontmatter.pubDate).toLocaleDateString(locale === 'es' ? 'es-ES' : locale === 'en' ? 'en-US' : 'zh-CN', { day: "numeric", month: "short", year: "numeric" }) : "";
              return (
                <article class={`grid grid-cols-12 gap-3 ${index < arr.length - 1 ? "pb-4 border-b border-[#e5e7eb] dark:border-[#2a2a2a]" : ""} items-center`}>
                  <div class="col-span-8 flex flex-col gap-1">
                    <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-400 font-mono-tech font-bold text-[10px] uppercase px-2 py-0.5 rounded w-max">
                      {frontmatter.category || t.categoryFallback}
                    </span>
                    <a href={post.url} class="hover:underline">
                      <h3 class="text-xl font-display font-medium text-slate-900 dark:text-white leading-snug">
                        {frontmatter.title || t.noTitle}
                      </h3>
                    </a>
                    {frontmatter.author && (
                      <p class="text-xs text-slate-600 dark:text-slate-400 font-medium uppercase tracking-wide">{frontmatter.author.toUpperCase()}</p>
                    )}
                    <div class="text-[10px] font-mono-tech font-bold text-[#1344e7] dark:text-[#5b8def] uppercase tracking-tight mt-0.5">
                      {dateStr}
                    </div>
                  </div>
                  <div class="col-span-4 overflow-hidden rounded">
                    <a href={post.url}>
                      <img src={frontmatter.image || "https://images.unsplash.com/photo-1451187580459-43490279c0fa"} alt={frontmatter.title || t.articleFallback} class="w-full h-20 object-cover hover:scale-105 transition-transform duration-300" />
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </aside>

      </div>
    </section>

    <!-- ============================================ -->
    <!-- ANÁLISIS & INFORMES TÁCTICOS                 -->
    <!-- ============================================ -->
    <section class="py-12 px-4 sm:px-6 mx-auto max-w-7xl border-b border-[#e5e7eb] dark:border-[#2a2a2a] font-sans">
      <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-[#111827] dark:text-[#f3f4f6]">
          {t.commentsBriefsTitle}
        </h2>
        <div class="flex items-center gap-2 self-start sm:self-auto bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 px-3 py-1.5 rounded-full shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#1344e7] dark:bg-[#1344e7] animate-pulse"></span>
          <span class="text-xs font-mono-tech font-semibold tracking-wide text-slate-800 dark:text-slate-300 uppercase">{t.miradas2050}</span>
        </div>
      </div>

      {mirada5 && (
        <a href={mirada5.url} class="block group mb-10">
          <article class="rounded-2xl overflow-hidden border border-[#e5e7eb] dark:border-[#2a2a2a] bg-[#ffffff] dark:bg-white/5">
            <div class="grid grid-cols-1 lg:grid-cols-2">
              <div class="p-6 sm:p-8 flex flex-col justify-center gap-3">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="bg-[#4A7C59] text-white font-mono-tech font-bold text-[10px] px-2 py-0.5 rounded uppercase tracking-widest">{t.miradas2050}</span>
                  <span class="text-[10px] font-mono-tech font-bold text-[#4A7C59] uppercase tracking-widest">
                    {mirada5.frontmatter?.category || t.miradasBadge} · {mirada5.frontmatter?.pubDate ? new Date(mirada5.frontmatter.pubDate).toLocaleDateString(locale === 'es' ? 'es-ES' : locale === 'en' ? 'en-US' : 'zh-CN', { day: '2-digit', month: 'short', year: 'numeric' }) : ''}
                  </span>
                </div>
                <h3 class="font-sans text-2xl sm:text-3xl font-bold text-[#111827] dark:text-[#f3f4f6] leading-tight tracking-tight">
                  {mirada5.frontmatter?.title}
                </h3>
                <p class="font-fraunces font-normal italic text-lg text-slate-800 dark:text-slate-300 leading-relaxed">
                  {mirada5.frontmatter?.excerpt}
                </p>
                <p class="text-xs text-slate-600 dark:text-slate-400 font-medium uppercase tracking-wide">
                  {mirada5.frontmatter?.author}
                </p>
              </div>
              <div class="relative min-h-[280px] lg:min-h-[360px]">
                <img src={mirada5.frontmatter?.image} alt={mirada5.frontmatter?.title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500" />
              </div>
            </div>
          </article>
        </a>
      )}
      {mirada6 && (
        <a href={mirada6.url} class="block group mb-10">
          <article class="rounded-2xl overflow-hidden border border-[#e5e7eb] dark:border-[#2a2a2a] bg-[#ffffff] dark:bg-white/5">
            <div class="grid grid-cols-1 lg:grid-cols-2">
              <div class="relative min-h-[280px] lg:min-h-[360px]">
                <img src={mirada6.frontmatter?.image} alt={mirada6.frontmatter?.title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500" />
              </div>
              <div class="p-6 sm:p-8 flex flex-col justify-center gap-3">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="bg-[#1344e7] text-white font-mono-tech font-bold text-[10px] px-2 py-0.5 rounded uppercase tracking-widest">{t.miradas2050}</span>
                  <span class="text-[10px] font-mono-tech font-bold text-[#1344e7] uppercase tracking-widest">
                    {mirada6.frontmatter?.category || t.miradasBadge} · {mirada6.frontmatter?.pubDate ? new Date(mirada6.frontmatter.pubDate).toLocaleDateString(locale === 'es' ? 'es-ES' : locale === 'en' ? 'en-US' : 'zh-CN', { day: '2-digit', month: 'short', year: 'numeric' }) : ''}
                  </span>
                </div>
                <h3 class="font-sans text-2xl sm:text-3xl font-bold text-[#111827] dark:text-[#f3f4f6] leading-tight tracking-tight">
                  {mirada6.frontmatter?.title}
                </h3>
                <p class="font-fraunces font-normal italic text-lg text-slate-800 dark:text-slate-300 leading-relaxed">
                  {mirada6.frontmatter?.excerpt}
                </p>
                <p class="text-xs text-slate-600 dark:text-slate-400 font-medium uppercase tracking-wide">
                  {mirada6.frontmatter?.author}
                </p>
              </div>
            </div>
          </article>
        </a>
      )}

      <!-- Brief principal: Informe #2 -->
      {mainReport && (
        <a href={`${locale === 'es' ? '' : `/${locale}`}/monitor/${getReportSlug(mainReport.id)}`} class="block group mb-10">
          <article class="rounded-2xl overflow-hidden border border-[#e5e7eb] dark:border-[#2a2a2a] bg-[#e2f3ff]/50 dark:bg-white/5">
            <div class="grid grid-cols-1 lg:grid-cols-4">
              <div class="lg:col-span-1 p-6 sm:p-8 flex flex-col justify-center gap-3">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="bg-[#1344e7] text-white font-mono-tech font-bold text-[10px] px-2 py-0.5 rounded uppercase tracking-widest">{t.reportBadge}</span>
                  <span class="text-[10px] font-mono-tech font-bold text-[#1344e7] dark:text-[#5b8def] uppercase tracking-widest">{t.researchBadge}</span>
                </div>
                <p class="font-fraunces font-normal italic text-lg text-slate-800 dark:text-slate-300 leading-relaxed">
                  {mainReport.data.subtitle || mainReport.data.summary || ''}
                </p>
              </div>
              <div class="lg:col-span-3 relative min-h-[280px] lg:min-h-[360px]">
                <img src={mainReport.data.image || '/images/posts/bolivia-uyuni-laguna-colorada.webp'} alt={mainReport.data.title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                <h3 class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 text-white font-sans text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight tracking-tight">
                  {mainReport.data.title}
                </h3>
              </div>
            </div>
          </article>
        </a>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {briefs.map((brief: any) => {
          const fm = brief.frontmatter || {};
          const displayDate = fm.pubDate
            ? new Date(fm.pubDate).toLocaleDateString(
                locale === 'es' ? 'es-ES' : locale === 'en' ? 'en-US' : 'zh-CN',
                { day: 'numeric', month: 'short', year: 'numeric' }
              )
            : '';
          return (
            <article class="flex flex-col gap-3 p-4 rounded-lg bg-[#e2f3ff]/50 dark:bg-white/5 border border-[#e5e7eb] dark:border-[#2a2a2a] hover:opacity-100 transition-opacity">
              <a href={brief.url}>
                <div class="overflow-hidden rounded h-40 bg-slate-200 dark:bg-slate-800">
                  <img src={fm.image} alt={fm.title || ''} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
                </div>
              </a>
              <div class="flex items-center justify-between text-xs">
                <span class="bg-[#1344e7] text-white font-mono-tech font-bold px-2 py-0.5 rounded uppercase">{fm.category || t.miradasBadge}</span>
                <span class="text-[#1344e7] dark:text-[#5b8def] font-mono-tech font-bold">{displayDate}</span>
              </div>
              <a href={brief.url} class="hover:underline">
                <h3 class="text-lg font-display font-medium text-slate-800 dark:text-slate-200 leading-tight">{fm.title || ''}</h3>
              </a>
              <p class="text-xs text-slate-600 dark:text-slate-400 font-medium uppercase tracking-wide">{(fm.author || '').toUpperCase()}</p>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ============================================ -->
    <!-- RADAR WIDGET                                 -->
    <!-- ============================================ -->
    <section class="py-12 px-4 sm:px-6 mx-auto max-w-7xl font-sans">
      <RadarWidget title={t.radarTitle} badgePosition="right" />
    </section>

  </div>
</Layout>
