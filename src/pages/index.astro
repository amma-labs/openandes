                <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-[10px] uppercase px-2 py-0.5 rounded w-max">Tecnología</span>
                <h3 class="text-sm font-display font-medium leading-snug text-slate-500 dark:text-slate-400 italic">Análisis en preparación...</h3>
                <div class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">Estreno: Jueves 03 Sep</div>
              </div>
              <div class="col-span-4 overflow-hidden rounded">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="En espera" class="w-full h-20 object-cover grayscale" />
              </div>
            </article>

            <article class="grid grid-cols-12 gap-3 items-center opacity-70">
              <div class="col-span-8 flex flex-col gap-1">
                <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-[10px] uppercase px-2 py-0.5 rounded w-max">Escenarios</span>
                <h3 class="text-sm font-display font-medium leading-snug text-slate-500 dark:text-slate-400 italic">Análisis en preparación...</h3>
                <div class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">Estreno: Lunes 07 Sep</div>
              </div>
              <div class="col-span-4 overflow-hidden rounded">
                <img src="https://images.unsplash.com/photo-1541872703-74c5e44368f9?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="En espera" class="w-full h-20 object-cover grayscale" />
              </div>
            </article>

          </div>
        </aside>

      </div>
    </section>

    <!-- ============================================ -->
    <!-- ANÁLISIS & INFORMES TÁCTICOS                  -->
    <!-- ============================================ -->
    <section class="py-12 px-4 sm:px-6 mx-auto max-w-7xl border-b border-[#e8e0d0] dark:border-[#2a2a2a] font-sans">
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-[#1a1410] dark:text-[#f0ece4]">
