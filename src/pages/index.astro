      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Artículo: El Milagro Chino de Zhou Qunfei -->
        <article class="flex flex-col gap-3 p-4 rounded-lg bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 border border-[#e8e0d0] dark:border-[#2a2a2a] hover:opacity-100 transition-opacity">
