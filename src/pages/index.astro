---
import Layout from '~/layouts/PageLayout.astro';
import RadarWidget from '~/components/widgets/RadarWidget.astro';

// Importar posts de Análisis
const posts = await Promise.all(
  Object.entries(import.meta.glob('../data/post/*.{md,mdx}')).map(async ([path, load]) => {
    const post = await load();
    const slug = path.split('/').pop().replace(/\.(md|mdx)$/, '');
    return {
      ...post,
      slug,
      url: `/analisis/${slug}`
    };
  })
);

// Ordenar por fecha y obtener el más reciente
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.frontmatter?.pubDate || '1970-01-01');
  const dateB = new Date(b.frontmatter?.pubDate || '1970-01-01');
  return dateB - dateA;
});

const mainPost = sortedPosts[0] || null;

const metadata = {
  title: 'OPEN ANDES — Inteligencia Estratégica y Riesgo Geofinanciero LatAm-Asia',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="font-sans text-[#1a1410] dark:text-[#f0ece4]">

    <!-- ============================================ -->
    <!-- HERO / MAIN GRID                              -->
    <!-- ============================================ -->
    <section class="py-8 px-4 sm:px-6 mx-auto max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <article class="lg:col-span-8 flex flex-col gap-4 font-sans">
          <div class="flex items-center gap-3">
            <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-xs uppercase px-2.5 py-1 rounded w-max tracking-wide">
              {mainPost ? mainPost.frontmatter?.category || 'Análisis' : 'Informe Principal'}
            </span>
            {mainPost?.frontmatter?.pubDate && (
              <span class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">
                {new Date(mainPost.frontmatter.pubDate).toLocaleDateString('es-ES', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </span>
            )}
          </div>
          <div class="overflow-hidden rounded-md bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <img 
              src={mainPost?.frontmatter?.image || 'https://images.unsplash.com/photo-1578575437130-527eed3abbec?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80'} 
              alt={mainPost?.frontmatter?.title || 'Análisis Principal'} 
              class="w-full h-[360px] sm:h-[400px] object-cover"
            />
          </div>
          <h1 class="text-3xl sm:text-4xl font-display font-semibold tracking-tight text-slate-900 dark:text-white leading-tight">
            {mainPost?.frontmatter?.title || 'Título del Informe Principal en preparación...'}
          </h1>
          <div class="flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
            {mainPost?.frontmatter?.author && (
              <span class="font-medium">Por {mainPost.frontmatter.author}</span>
            )}
          </div>
          <p class="font-sans text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            {mainPost?.frontmatter?.excerpt || 'El equipo analítico de Open Andes se encuentra redactando la evaluación estratégica de esta entrega. Estará disponible públicamente en la fecha programada.'}
          </p>
          {mainPost && (
            <a href={mainPost.url} class="inline-flex items-center gap-2 text-[#1a4b8c] dark:text-[#2b6cb5] font-medium hover:underline">
              Leer artículo completo →
            </a>
          )}
        </article>

        <aside class="lg:col-span-4 flex flex-col justify-between lg:border-l lg:border-[#e8e0d0] lg:dark:border-[#2a2a2a] lg:pl-8 font-sans h-full">
          <div class="flex flex-col justify-between h-full gap-5">
            
            <article class="grid grid-cols-12 gap-3 pb-4 border-b border-[#e8e0d0] dark:border-[#2a2a2a] items-center opacity-70">
              <div class="col-span-8 flex flex-col gap-1">
                <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-[10px] uppercase px-2 py-0.5 rounded w-max">Defensa</span>
                <h3 class="text-sm font-display font-medium leading-snug text-slate-500 dark:text-slate-400 italic">Análisis en preparación...</h3>
                <div class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">Estreno: Jueves 27 Ago</div>
              </div>
              <div class="col-span-4 overflow-hidden rounded">
                <img src="https://images.unsplash.com/photo-1508614589041-895b88991e3e?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="En espera" class="w-full h-20 object-cover grayscale" />
              </div>
            </article>

            <article class="grid grid-cols-12 gap-3 pb-4 border-b border-[#e8e0d0] dark:border-[#2a2a2a] items-center opacity-70">
              <div class="col-span-8 flex flex-col gap-1">
                <span class="inline-block bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono-tech font-bold text-[10px] uppercase px-2 py-0.5 rounded w-max">Geoeconomía</span>
                <h3 class="text-sm font-display font-medium leading-snug text-slate-500 dark:text-slate-400 italic">Análisis en preparación...</h3>
                <div class="text-xs font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-tight">Estreno: Lunes 31 Ago</div>
              </div>
              <div class="col-span-4 overflow-hidden rounded">
