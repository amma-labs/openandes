---
import Layout from '~/layouts/PageLayout.astro';
import ShareButtons from '~/components/common/ShareButtons.astro';
import { authors } from '~/data/authors';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../data/mirada-experta/*.{md,mdx}');
  const paths = [];

  for (const path in posts) {
    const slug = path.split('/').pop().replace(/\.(md|mdx)$/, '');
    paths.push({ params: { slug } });
  }

  return paths;
}

const { slug } = Astro.params;
const post = await import(`../../data/mirada-experta/${slug}.mdx`);

const authorSlug = post.frontmatter?.authorSlug;
const authorData = authorSlug ? authors[authorSlug] : null;

const metadata = {
  title: `${post.frontmatter?.title || "Artículo"} | OpenAndes`,
  description: post.frontmatter?.excerpt || "",
  openGraph: {
    images: post.frontmatter?.image ? [{ url: post.frontmatter.image }] : [],
  },
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-5xl px-6 py-12 sm:py-16 lg:py-20">
    <div class="lg:grid lg:grid-cols-[80px_1fr] lg:gap-8">

      <ShareButtons variant="sticky" />

      <article class="max-w-3xl">
        <header class="mb-10">
          <a href="/miradas" class="text-[#1a4b8c] dark:text-[#2b6cb5] hover:underline text-sm font-medium">
            &larr; Volver a Mirada Experta
          </a>
          <h1 class="text-4xl font-sans font-bold mt-6 text-[#1a1410] dark:text-[#f0ece4] leading-tight">
            {post.frontmatter?.title || 'Sin título'}
          </h1>
          <div class="flex items-center gap-4 mt-4 text-sm text-[#8a8070]">
            {post.frontmatter?.author && (
              <span class="font-medium uppercase tracking-wide">Por {post.frontmatter.author}</span>
            )}
            {post.frontmatter?.pubDate && (
              <time>
                {new Date(post.frontmatter.pubDate).toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            )}
          </div>
          {post.frontmatter?.tags && post.frontmatter.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-4">
              {post.frontmatter.tags.map((tag) => (
                <a
                  href={`/topics/${tag.toLowerCase().replace(/\s+/g, "-")}`}
                  class="text-xs bg-[#e2f3ff]/70 dark:bg-white/5 border border-[#e8e0d0] dark:border-[#2a2a2a] px-2 py-1 rounded-full text-[#1a4b8c] dark:text-[#2b6cb5] font-mono-tech hover:bg-[#1a4b8c] hover:text-white dark:hover:bg-[#2b6cb5] transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <div class="prose prose-lg max-w-none font-fraunces
          text-[#1a1410] dark:text-[#f0ece4]
          prose-headings:font-sans prose-headings:font-bold prose-headings:tracking-tight
          prose-headings:text-[#1a1410] dark:prose-headings:text-[#f0ece4]
          prose-p:leading-relaxed prose-p:text-[20px] prose-p:text-[#0a0705] dark:prose-p:text-[#f0ece4] prose-p:font-light prose-p:mb-6
          prose-a:text-[#1a4b8c] dark:prose-a:text-[#7fb3e0] prose-a:no-underline hover:prose-a:underline
          prose-strong:text-[#1a1410] dark:prose-strong:text-[#f0ece4]
          prose-li:text-[#1a1410] dark:prose-li:text-[#f0ece4]
          prose-img:rounded-xl prose-img:shadow-md
          prose-figure:my-8
          prose-figcaption:text-center prose-figcaption:text-sm prose-figcaption:text-[#8a8070]
          prose-blockquote:border-l-4 prose-blockquote:border-[#1a4b8c]
          prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-[#4a4438] dark:prose-blockquote:text-[#c8c2b6]
          [&_img]:my-8 [&_img]:rounded-xl [&_img]:shadow-lg">
          <post.Content />
        </div>

        {authorData && (
          <div class="mt-12 pt-8 border-t border-[#e8e0d0] dark:border-[#2a2a2a]">
            <p class="font-fraunces text-[#1a1410] dark:text-[#f0ece4]">
              <strong>{authorData.name}</strong>{' '}
              <em>{authorData.bio}</em>
            </p>
          </div>
        )}


        {post.frontmatter?.bibliography && post.frontmatter.bibliography.length > 0 && (
          <div class="mt-12 pt-8 border-t border-[#e8e0d0] dark:border-[#2a2a2a]">
            <h2 class="font-sans font-bold text-2xl text-[#1a1410] dark:text-[#f0ece4] mb-4">Bibliografía</h2>
            <ol class="space-y-3 text-sm text-[#4a4438] dark:text-[#c8c2b6] list-decimal pl-5">
              {post.frontmatter.bibliography.map((item) => (
                <li set:html={item.replace(/\*(.*?)\*/g, "<em>$1</em>")} />
              ))}
            </ol>
          </div>
        )}
        <div class="mt-10 p-5 rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a] bg-[#faf8f3] dark:bg-white/5">
          <p class="font-mono-tech font-bold text-xs uppercase tracking-widest text-[#1a4b8c] dark:text-[#2b6cb5] mb-2">
            Nota editorial
          </p>
          <p class="text-sm text-[#4a4438] dark:text-[#c8c2b6] leading-relaxed">
            Este trabajo representa exclusivamente las opiniones del autor o autores. Open Andes es un think tank y editorial independiente, y no adopta posturas institucionales sobre asuntos de política pública.
          </p>
        </div>

        <ShareButtons variant="inline" />
      </article>

    </div>
  </div>
</Layout>
