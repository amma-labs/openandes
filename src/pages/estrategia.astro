---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Estrategia — OpenAndes',
};
---

<Layout metadata={metadata}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-6">Estrategia</h1>
    <p class="text-lg text-muted mb-8">Diseñamos estrategias para navegar la complejidad de América Latina y el Sur Global.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a]">
        <h2 class="text-xl font-bold mb-2">Asesoría Geopolítica</h2>
        <p class="text-muted">Acompañamiento en la toma de decisiones en contextos de alta incertidumbre.</p>
      </div>
      <div class="p-6 bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a]">
        <h2 class="text-xl font-bold mb-2">Posicionamiento Regional</h2>
        <p class="text-muted">Análisis de competitividad y posicionamiento de actores en el espacio latinoamericano.</p>
      </div>
    </div>
  </div>
</Layout>
