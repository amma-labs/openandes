---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Estrategia — OpenAndes',
};
---

<Layout metadata={metadata}>
  <div class="min-h-screen py-16 px-4 sm:px-6 mx-auto max-w-4xl">
    <div class="mb-12 border-b border-[#e8e0d0] dark:border-[#2a2a2a] pb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-3 h-3 bg-[#1a4b8c] inline-block rounded-full"></span>
        <span class="text-xs font-mono-tech font-bold tracking-widest uppercase text-[#1a4b8c] dark:text-[#2b6cb5]">
          Estrategia
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-display font-bold tracking-tight text-[#1a1410] dark:text-[#f0ece4]">
        Advisory Estratégico
      </h1>
      <p class="text-[#4a4038] dark:text-[#c8c0b4] text-base sm:text-lg mt-3 max-w-3xl leading-relaxed font-sans">
        Asesoramiento para la toma de decisiones en entornos de alta incertidumbre.
      </p>
    </div>

    <div class="prose prose-slate dark:prose-invert max-w-none">
      <p class="font-sans text-[#4a4038] dark:text-[#c8c0b4] leading-relaxed">
        Open Andes ofrece servicios de inteligencia estratégica y análisis de riesgo para organizaciones públicas y privadas con intereses en América Latina y la Cuenca del Pacífico.
      </p>
      
      <h2 class="font-display text-2xl font-bold text-[#1a1410] dark:text-[#f0ece4] mt-8">Nuestros Servicios</h2>
      <ul class="font-sans text-[#4a4038] dark:text-[#c8c0b4]">
        <li>Análisis de riesgo geofinanciero</li>
        <li>Prospectiva y escenarios</li>
        <li>Inteligencia competitiva</li>
        <li>Asesoría en relaciones internacionales</li>
      </ul>
    </div>
  </div>
</Layout>
