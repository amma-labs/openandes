---
import Layout from '~/layouts/PageLayout.astro';
import heroImage from '~/assets/images/46-chasing-climate-change-in-the-arctic-2800.jpg';
import { getLangFromUrl } from '~/i18n/ui';

const lang = getLangFromUrl(Astro);
// Carga el JSON del locale (es/en/zh). Todos los JSON existen; fallback a es.
const allData = import.meta.glob('~/data/estrategia/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = allData[`/src/data/estrategia/${lang}.json`] ?? allData['/src/data/estrategia/es.json'];

const metadata = {
  title: data.metaTitle,
  description: data.metaDescription,
};

// Alias para mantener el resto del template igual
type Servicio = { titulo: string; descripcion: string; icon: string };
type Sello = { titulo: string; descripcion: string };
type Stat = { valor: string; label: string };

const servicios = data.services as Servicio[];
const sello = data.sello as Sello[];
const stats = data.stats as Stat[];

---

<Layout metadata={metadata}>
  <!-- HERO -->
  <section class="relative min-h-[450px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src={heroImage.src}
        alt="Asesoría estratégica — Open Andes"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#030712]/90 via-[#030712]/70 to-[#030712]/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#030712]/60 via-transparent to-transparent"></div>
    </div>

    <div class="absolute top-0 left-0 right-0 z-10 h-1 bg-gradient-to-r from-[#1344e7] via-[#1344e7] to-[#1344e7]"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-3xl">
        <span class="inline-block text-sm font-mono-tech font-bold tracking-widest uppercase text-[#e5e7eb] mb-4 border border-[#e5e7eb]/30 px-4 py-1.5 rounded-full backdrop-blur-sm bg-black/20">{data.heroBadge}</span>
        <h1 class="font-sans font-bold text-4xl sm:text-5xl md:text-6xl text-white leading-tight tracking-tight">{data.heroTitle}</h1>
        <p class="mt-4 text-lg sm:text-xl text-white/90 max-w-3xl leading-relaxed">
          {data.heroDesc}
        </p>
      </div>
    </div>
  </section>

  <!-- CONTENIDO -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">

    <!-- BRIEFING DESTACADO -->
    <section class="mb-20">
      <div class="rounded-2xl overflow-hidden border border-[#e5e7eb] dark:border-[#2a2a2a] bg-[#ffffff] dark:bg-white/5">
        <div class="grid grid-cols-1 lg:grid-cols-5">

          <!-- Texto -->
          <div class="lg:col-span-3 p-8 sm:p-10 flex flex-col justify-between gap-6">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-5">
                <span class="bg-[#030712] text-white font-mono-tech font-bold text-[10px] px-2.5 py-1 rounded uppercase tracking-widest">{data.briefingBadge}</span>
                <span class="text-[10px] font-mono-tech font-bold text-[#1344e7] dark:text-[#5b8def] uppercase tracking-widest">{data.briefingNumber}</span>
              </div>

              <h2 class="font-sans font-bold text-3xl sm:text-4xl text-[#111827] dark:text-[#f3f4f6] leading-tight tracking-tight mb-3">{data.briefingTitle}</h2>
              <p class="font-sans font-light italic text-lg text-[#4b5563] dark:text-[#4b5563] mb-5">{data.briefingSubtitle}</p>

              <p class="text-sm text-[#4b5563] dark:text-[#4b5563] leading-relaxed mb-6">
                {data.briefingDesc}
              </p>

              <!-- Stats -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-5 border-t border-[#e5e7eb] dark:border-[#2a2a2a]">
                {stats.map((s) => (
                  <div>
                    <span class="block font-sans font-bold text-xl text-[#1344e7] dark:text-[#5b8def]">{s.valor}</span>
                    <span class="mt-1 block text-[10px] font-mono-tech font-bold text-[#4b5563] uppercase tracking-wider leading-tight">
                      {s.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <a
              href="/reports/pdf/open-andes-briefing-asesoria-2026-09.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 self-start px-7 py-3.5 bg-[#030712] hover:bg-[#1344e7] text-white font-mono-tech font-bold text-sm uppercase tracking-wider rounded-full transition-colors duration-200"
            >{data.briefingCta}<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
            </a>
          </div>

          <!-- Imagen -->
          <div class="lg:col-span-2 relative min-h-[280px] lg:min-h-full">
            <img
              src="/images/posts/shanghai-puerto-1920x1080-1.webp"
              alt={`${data.briefingBadge} — ${data.briefingTitle}`}
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#030712]/70 via-transparent to-transparent"></div>
          </div>

        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section class="mb-20">
      <h2 class="font-sans font-bold text-2xl sm:text-3xl text-[#111827] dark:text-[#f3f4f6] mb-10">{data.servicesTitle}</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {servicios.map((s) => (
          <div class="p-6 rounded-xl border border-[#e5e7eb] dark:border-[#2a2a2a] bg-white dark:bg-white/5 hover:border-[#1344e7] dark:hover:border-[#1344e7] hover:shadow-lg transition-all duration-300">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-[#e2f3ff]/70 dark:bg-white/5 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#1344e7] dark:text-[#5b8def]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                </svg>
              </div>
              <div>
                <h3 class="font-sans font-bold text-lg text-[#111827] dark:text-[#f3f4f6] mb-2">{s.titulo}</h3>
                <p class="text-sm text-[#4b5563] dark:text-[#4b5563] leading-relaxed">{s.descripcion}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SELLO DE IDENTIDAD -->
    <section class="mb-20 py-10 border-y border-[#e5e7eb] dark:border-[#2a2a2a]">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {sello.map((s) => (
          <div class="text-center md:text-left">
            <h3 class="font-mono-tech font-bold text-xs uppercase tracking-widest text-[#1344e7] dark:text-[#5b8def] mb-2">
              {s.titulo}
            </h3>
            <p class="text-sm text-[#4b5563] dark:text-[#4b5563] leading-relaxed">{s.descripcion}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center">
      <h2 class="font-sans font-normal text-2xl sm:text-3xl text-[#111827] dark:text-[#f3f4f6] mb-4">
        ¿Listo para evaluar sus escenarios de riesgo?
      </h2>
      <p class="text-[#4b5563] dark:text-[#4b5563] mb-8 max-w-xl mx-auto">
        {data.ctaDesc}
      </p>
      <a
        href="mailto:contacto@openandes.org?subject=Solicitud%20de%20Briefing%20Ejecutivo"
        class="inline-flex items-center justify-center px-8 py-3.5 bg-[#030712] hover:bg-[#1344e7] text-white font-mono-tech font-bold text-sm uppercase tracking-wider rounded-full transition-colors duration-200"
      >{data.ctaButton}</a>
    </section>

  </div>
</Layout>
