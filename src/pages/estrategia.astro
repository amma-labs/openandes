---
import Layout from '~/layouts/PageLayout.astro';
import heroImage from '~/assets/images/46-chasing-climate-change-in-the-arctic-2800.jpg';

const metadata = {
  title: 'Asesoría — Open Andes',
  description: 'Inteligencia de riesgo y prospectiva para la toma de decisiones en América Latina.',
};

const servicios = [
  {
    titulo: 'Monitor de Riesgo LatAm-Asia',
    descripcion: 'Tableros paramétricos y mapas de calor regulatorio actualizados continuamente.',
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  },
  {
    titulo: 'Análisis Geofinanciero & Regulatorio',
    descripcion: 'Evaluaciones técnicas sobre concesiones, regulación ambiental, soberanía digital y aduanas.',
    icon: 'M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z',
  },
  {
    titulo: 'Riesgo Político & Ciclos Electorales',
    descripcion: 'Mapeo de perfiles gubernamentales y proyecciones de gobernabilidad en América Latina.',
    icon: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
  },
  {
    titulo: 'Prospectiva de Escenarios & Cisnes Negros',
    descripcion: 'Modelado de escenarios de incertidumbre a mediano y largo plazo (2035–2050).',
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  },
  {
    titulo: 'Briefings Ejecutivos & Reportes Ad-Hoc',
    descripcion: 'Sesiones privadas de trabajo y reportes a medida ante coyunturas específicas.',
    icon: 'M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0',
  },
];

const sello = [
  {
    titulo: 'Data-Driven Visuals',
    descripcion: 'Gráficos, mapas y esquemas diseñados para entender el impacto de negocio en segundos.',
  },
  {
    titulo: 'Firma Humana',
    descripcion: 'Análisis técnico empírico y desprovisto de especulación o IA generativa.',
  },
  {
    titulo: 'Neutralidad',
    descripcion: 'Análisis riguroso, independiente y agnóstico ideológicamente.',
  },
];

const stats = [
  { valor: '−10 días', label: 'Reducción tránsito transpacífico' },
  { valor: '−20%', label: 'Costos logísticos globales' },
  { valor: '$1.3B', label: 'Inversión Etapa 1 · Chancay' },
  { valor: '$4.5B', label: 'Inversión proyectada · San Antonio' },
];
---

<Layout metadata={metadata}>
  <!-- HERO -->
  <section class="relative min-h-[450px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src={heroImage.src}
        alt="Asesoría estratégica — Open Andes"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0F2A44]/90 via-[#0F2A44]/70 to-[#0F2A44]/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0F2A44]/60 via-transparent to-transparent"></div>
    </div>

    <div class="absolute top-0 left-0 right-0 z-10 h-1 bg-gradient-to-r from-[#1a4b8c] via-[#2b6cb5] to-[#1a4b8c]"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-3xl">
        <span class="inline-block text-sm font-mono-tech font-bold tracking-widest uppercase text-[#c8d8ea] mb-4 border border-[#c8d8ea]/30 px-4 py-1.5 rounded-full backdrop-blur-sm bg-black/20">
          Asesoría
        </span>
        <h1 class="font-sans font-bold text-4xl sm:text-5xl md:text-6xl text-white leading-tight tracking-tight">
          Soluciones y Solicitudes Directas
        </h1>
        <p class="mt-4 text-lg sm:text-xl text-white/90 max-w-3xl leading-relaxed">
          Inteligencia de riesgo y prospectiva para la toma de decisiones en América Latina.
        </p>
      </div>
    </div>
  </section>

  <!-- CONTENIDO -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">

    <!-- BRIEFING DESTACADO -->
    <section class="mb-20">
      <div class="rounded-2xl overflow-hidden border border-[#e8e0d0] dark:border-[#2a2a2a] bg-[#faf8f3] dark:bg-white/5">
        <div class="grid grid-cols-1 lg:grid-cols-5">

          <!-- Texto -->
          <div class="lg:col-span-3 p-8 sm:p-10 flex flex-col justify-between gap-6">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-5">
                <span class="bg-[#0F2A44] text-white font-mono-tech font-bold text-[10px] px-2.5 py-1 rounded uppercase tracking-widest">
                  Brief Ejecutivo
                </span>
                <span class="text-[10px] font-mono-tech font-bold text-[#1a4b8c] dark:text-[#2b6cb5] uppercase tracking-widest">
                  N.° 2026-09
                </span>
              </div>

              <h2 class="font-fraunces font-normal text-3xl sm:text-4xl text-[#1a1410] dark:text-[#f0ece4] leading-tight tracking-tight mb-3">
                Pívot en el Pacífico Sur
              </h2>
              <p class="font-fraunces font-light italic text-lg text-[#4a4438] dark:text-[#c8c2b6] mb-5">
                Análisis de Riesgo Geoeconómico
              </p>

              <p class="text-sm text-[#4a4438] dark:text-[#c8c2b6] leading-relaxed mb-6">
                La pugna por el liderazgo logístico entre el megapuerto de Chancay (Perú) y el Puerto Exterior de San Antonio (Chile) reconfigura la competitividad de las cadenas de suministro transpacíficas. Este brief analiza la inversión china en infraestructura portuaria, el impacto del corredor directo Chancay-Shanghái, las asimetrías regulatorias, el riesgo geopolítico y las implicaciones para las industrias minera y agrícola de la región.
              </p>

              <!-- Stats -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-5 border-t border-[#e8e0d0] dark:border-[#2a2a2a]">
                {stats.map((s) => (
                  <div>
                    <span class="block font-fraunces font-bold text-xl text-[#1a4b8c] dark:text-[#2b6cb5]">{s.valor}</span>
                    <span class="mt-1 block text-[10px] font-mono-tech font-bold text-[#8a8070] uppercase tracking-wider leading-tight">
                      {s.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <a
              href="/reports/pdf/open-andes-briefing-asesoria-2026-09.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 self-start px-7 py-3.5 bg-[#0F2A44] hover:bg-[#1a4b8c] text-white font-mono-tech font-bold text-sm uppercase tracking-wider rounded-full transition-colors duration-200"
            >
              Descargar PDF
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
            </a>
          </div>

          <!-- Imagen -->
          <div class="lg:col-span-2 relative min-h-[280px] lg:min-h-full">
            <img
              src="/images/posts/shanghai-puerto-1920x1080-1.jpg"
              alt="Brief Ejecutivo — Pívot en el Pacífico Sur"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0F2A44]/70 via-transparent to-transparent"></div>
          </div>

        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section class="mb-20">
      <h2 class="font-sans font-bold text-2xl sm:text-3xl text-[#1a1410] dark:text-[#f0ece4] mb-10">
        Líneas de Asesoría
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {servicios.map((s) => (
          <div class="p-6 rounded-xl border border-[#e8e0d0] dark:border-[#2a2a2a] bg-white dark:bg-white/5 hover:border-[#1a4b8c] dark:hover:border-[#2b6cb5] hover:shadow-lg transition-all duration-300">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-[#e2f3ff]/70 dark:bg-white/5 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#1a4b8c] dark:text-[#2b6cb5]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                </svg>
              </div>
              <div>
                <h3 class="font-sans font-bold text-lg text-[#1a1410] dark:text-[#f0ece4] mb-2">{s.titulo}</h3>
                <p class="text-sm text-[#4a4438] dark:text-[#c8c2b6] leading-relaxed">{s.descripcion}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SELLO DE IDENTIDAD -->
    <section class="mb-20 py-10 border-y border-[#e8e0d0] dark:border-[#2a2a2a]">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {sello.map((s) => (
          <div class="text-center md:text-left">
            <h3 class="font-mono-tech font-bold text-xs uppercase tracking-widest text-[#1a4b8c] dark:text-[#2b6cb5] mb-2">
              {s.titulo}
            </h3>
            <p class="text-sm text-[#4a4438] dark:text-[#c8c2b6] leading-relaxed">{s.descripcion}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center">
      <h2 class="font-fraunces font-normal text-2xl sm:text-3xl text-[#1a1410] dark:text-[#f0ece4] mb-4">
        ¿Listo para evaluar sus escenarios de riesgo?
      </h2>
      <p class="text-[#4a4438] dark:text-[#c8c2b6] mb-8 max-w-xl mx-auto">
        Coordinemos un briefing ejecutivo a medida para su directorio o equipo de inversión.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-3.5 bg-[#0F2A44] hover:bg-[#1a4b8c] text-white font-mono-tech font-bold text-sm uppercase tracking-wider rounded-full transition-colors duration-200"
      >
        Solicitar Briefing Ejecutivo
      </a>
    </section>

  </div>
</Layout>
