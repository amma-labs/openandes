---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Monitor Latam-Asia — OpenAndes',
};
---

<Layout metadata={metadata}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-6">Monitor Latam-Asia</h1>
    <p class="text-lg text-muted mb-8">Seguimiento de las relaciones entre América Latina y Asia-Pacífico.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-4 bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a] text-center">
        <h3 class="font-bold">Flujos Comerciales</h3>
        <p class="text-sm text-muted">Análisis de intercambios comerciales y acuerdos bilaterales.</p>
      </div>
      <div class="p-4 bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a] text-center">
        <h3 class="font-bold">Inversiones</h3>
        <p class="text-sm text-muted">Monitoreo de flujos de inversión y cooperación económica.</p>
      </div>
      <div class="p-4 bg-[#f8f4ea]/50 dark:bg-[#1a1a1a]/50 rounded-lg border border-[#e8e0d0] dark:border-[#2a2a2a] text-center">
        <h3 class="font-bold">Cooperación</h3>
        <p class="text-sm text-muted">Seguimiento de acuerdos estratégicos y alianzas.</p>
      </div>
    </div>
  </div>
</Layout>
