---
import Layout from '~/layouts/PageLayout.astro';

// Importar imagen para el hero
import heroImage from '~/assets/images/9-viridien-see-things-differently-1400.png';

const metadata = {
  title: 'Monitor: Equipos de Investigación — OpenAndes',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section con imagen de fondo -->
  <section class="relative min-h-[450px] flex items-center overflow-hidden">
    <!-- Imagen de fondo -->
    <div class="absolute inset-0 z-0">
      <img 
        src={heroImage.src} 
        alt="Monitor LatAm-Asia - Open Andes" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/85 via-slate-900/60 to-slate-900/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
    </div>
    
    <!-- Línea decorativa superior -->
    <div class="absolute top-0 left-0 right-0 z-10 h-1 bg-gradient-to-r from-blue-500 via-indigo-400 to-blue-500"></div>
    
    <!-- Contenido del hero -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-3xl">
        <span class="inline-block text-sm font-medium tracking-widest uppercase text-blue-300 mb-4 border border-blue-400/30 px-4 py-1.5 rounded-full backdrop-blur-sm bg-black/20">
          Monitor
        </span>
        <h1 class="font-sans text-4xl sm:text-5xl md:text-5xl font-bold text-white leading-tight">
          LatAm-Asia
        </h1>
        <p class="mt-4 text-lg sm:text-xl text-white/90 max-w-3xl leading-relaxed">
          es una iniciativa de investigación aplicada de Open Andes dedicada al análisis geoeconómico, logístico y financiero de las relaciones entre América Latina y la Cuenca del Indo-Pacífico.
        </p>
      </div>
    </div>
  </section>

  <!-- Contenido -->
  <div class="max-w-5xl mx-auto px-4 py-16">
    

    <!-- Reporte -->
    <a href="/monitor/reporte-1" class="block group mb-16">
      <article class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 hover:border-blue-500 dark:hover:border-blue-400 hover:shadow-lg transition-all duration-300 overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="p-8">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-xs font-mono uppercase tracking-widest text-blue-600 dark:text-blue-400 font-bold">REPORTE #1</span>
              <span class="text-xs text-slate-500 dark:text-slate-400">Septiembre 2026</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-3 leading-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              Reconfiguración logística y geopolítica en el Pacífico Sur
            </h3>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              Frente a la inversión de capital chino y de Asia-Pacífico en infraestructura portuaria (San Antonio, Chancay y Callao).
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Geopolítica</span>
              <span class="text-xs px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Pacífico Sur</span>
              <span class="text-xs px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Comercio Marítimo</span>
              <span class="text-xs px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Infraestructura Portuaria</span>
              <span class="text-xs px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">China-América Latina</span>
              <span class="text-xs px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Chile</span>
              <span class="text-xs px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Perú</span>
              <span class="text-xs px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Minerales Críticos</span>
              <span class="text-xs px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Cadenas de Suministro</span>
            </div>
          </div>
          <div class="relative min-h-[280px] md:min-h-full">
            <img src="/images/posts/shanghai-puerto-1920x1080-1.webp" alt="Puerto de Shanghái" class="absolute inset-0 w-full h-full object-cover" />
          </div>
        </div>
      </article>
    </a>

  </div>
</Layout>
