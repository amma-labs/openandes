---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Inteligencia | OpenAndes',
  description: 'Terminal de inteligencia estratégica global. Monitoreo en tiempo real de mercados, energía y riesgos geopolíticos.',
};
---

<Layout metadata={metadata}>
  <div class="font-sans text-[#1a1410] dark:text-[#f0ece4] max-w-7xl mx-auto px-4 sm:px-6 py-8">
    
    <!-- TÍTULO -->
    <div class="text-center mb-10 pb-5 border-b-2 border-[#1a4b8c] dark:border-[#2b6cb5]">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1a1410] dark:text-[#f0ece4]">
        Global Intelligence Terminal
      </h1>
      <p class="text-[#1a4b8c] dark:text-[#2b6cb5] font-semibold uppercase text-sm tracking-wider mt-2">
        Monitoreo Estratégico en Tiempo Real • OpenAndes Proprietary Data
      </p>
    </div>

    <!-- 1. TICKER TAPE -->
    <div class="mb-6">
      <h3 class="text-[#1a1410] dark:text-[#f0ece4] font-bold uppercase text-sm mb-4">
        <span class="text-[#1a4b8c] dark:text-[#2b6cb5]">●</span> Strategic Asset Ticker
      </h3>
      <div class="tradingview-widget-container border-t-2 border-b-2 border-[#1a4b8c] dark:border-[#2b6cb5] py-4">
        <div class="tradingview-widget-container__widget"></div>
        <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js" async>
        {
          "symbols": [
            { "proName": "BITSTAMP:BTCUSD", "title": "Bitcoin" },
            { "proName": "TVC:UKOIL", "title": "Brent Oil" },
            { "proName": "TVC:USOIL", "title": "WTI Oil" },
            { "proName": "TVC:GOLD", "title": "Oro" },
            { "proName": "NYSE:TSM", "title": "TSMC" },
            { "proName": "NYSE:VALE", "title": "Vale" },
            { "proName": "NYSE:BHP", "title": "BHP" },
            { "proName": "NYSE:SCCO", "title": "Southern Copper" },
            { "proName": "FOREXCOM:SPXUSD", "title": "S&P 500" },
            { "proName": "NASDAQ:IXIC", "title": "Nasdaq" },
            { "proName": "NYSE:NKE", "title": "Nike" },
            { "proName": "NYSE:JPM", "title": "JP Morgan" },
            { "proName": "NYSE:XOM", "title": "ExxonMobil" }
          ],
          "showSymbolLogo": true,
          "colorTheme": "light",
          "isTransparent": false,
          "displayMode": "adaptive",
          "locale": "es"
        }
        </script>
      </div>
    </div>

    <!-- 2. MENSAJE DE BIENVENIDA -->
    <div class="bg-[#f8fafc] dark:bg-[#1a1a1a] border border-[#e2e8f0] dark:border-[#2a2a2a] p-6 rounded-lg my-8">
      <p class="text-[#1a1410] dark:text-[#f0ece4] text-base leading-relaxed">
        <strong class="text-[#1a4b8c] dark:text-[#2b6cb5]">Bienvenido, Consejero.</strong> Está accediendo a la 
        <strong>Terminal de Inteligencia de OpenAndes</strong>. Esta interfaz integra flujos de datos en tiempo real con indicadores prospectivos para respaldar la toma de decisiones en geopolítica, infraestructura y finanzas transpacíficas.
      </p>
    </div>

    <!-- 3. MARKET QUOTES (Energía y Metales) -->
    <div class="mb-8">
      <h3 class="text-[#1a1410] dark:text-[#f0ece4] font-bold uppercase text-sm mb-4">
        <span class="text-[#1a4b8c] dark:text-[#2b6cb5]">●</span> Commodities & Markets
      </h3>
      <div class="tradingview-widget-container border border-[#e8e0d0] dark:border-[#2a2a2a] rounded-lg p-4">
        <div class="tradingview-widget-container__widget"></div>
        <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-market-quotes.js" async>
        {
          "width": "100%",
          "height": "300",
          "symbolsGroups": [
            {
              "name": "Energía",
              "symbols": [
                { "name": "TVC:UKOIL", "displayName": "Brent Crude" },
                { "name": "TVC:USOIL", "displayName": "WTI Crude" },
                { "name": "TVC:NG1!", "displayName": "Natural Gas" }
              ]
            },
            {
              "name": "Metales",
              "symbols": [
                { "name": "TVC:GOLD", "displayName": "Gold" },
                { "name": "TVC:SILVER", "displayName": "Silver" },
                { "name": "TVC:COPPER", "displayName": "Copper" }
              ]
            }
          ],
          "showSymbolLogo": true,
          "colorTheme": "light",
          "isTransparent": false,
          "locale": "es"
        }
        </script>
      </div>
    </div>

    <!-- 4. ECONOMIC CALENDAR -->
    <div class="mb-8">
      <h3 class="text-[#1a1410] dark:text-[#f0ece4] font-bold uppercase text-sm mb-4">
        <span class="text-[#1a4b8c] dark:text-[#2b6cb5]">●</span> Economic Calendar
      </h3>
      <div class="tradingview-widget-container border border-[#e8e0d0] dark:border-[#2a2a2a] rounded-lg p-4">
        <div class="tradingview-widget-container__widget"></div>
        <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-events.js" async>
        {
          "colorTheme": "light",
          "isTransparent": false,
          "width": "100%",
          "height": "400",
          "locale": "es",
          "importanceFilter": "-1,0,1"
        }
        </script>
      </div>
    </div>

    <!-- 5. TIMELINE (News Feed) -->
    <div class="mb-8">
      <h3 class="text-[#1a1410] dark:text-[#f0ece4] font-bold uppercase text-sm mb-4">
        <span class="text-[#1a4b8c] dark:text-[#2b6cb5]">●</span> Global Intelligence Feed
      </h3>
      <div class="tradingview-widget-container border border-[#e8e0d0] dark:border-[#2a2a2a] rounded-lg p-4">
        <div class="tradingview-widget-container__widget"></div>
        <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-timeline.js" async>
        {
          "feedMode": "all_symbols",
          "isTransparent": false,
          "displayMode": "regular",
          "width": "100%",
          "height": "500",
          "colorTheme": "light",
          "locale": "es"
        }
        </script>
      </div>
    </div>

  </div>
</Layout>
