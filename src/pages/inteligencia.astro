---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Inteligencia | OpenAndes',
};

const commodities = [
  { symbol: 'HG=F', name: 'Cobre', region: 'LatAm' },
  { symbol: 'LIT', name: 'Litio', region: 'LatAm' },
  { symbol: 'ZS=F', name: 'Soja', region: 'LatAm' },
  { symbol: 'SI=F', name: 'Plata', region: 'LatAm' },
  { symbol: 'BZ=F', name: 'Brent', region: 'Global' },
  { symbol: 'GC=F', name: 'Oro', region: 'Global' },
  { symbol: '000001.SS', name: 'Shanghai', region: 'Asia' },
  { symbol: '^HSI', name: 'Hang Seng', region: 'Asia' },
  { symbol: '^N225', name: 'Nikkei', region: 'Asia' },
  { symbol: 'DX-Y.NYB', name: 'Dólar Index', region: 'Inversión' },
];

const groups = {
  'LatAm': commodities.filter(c => c.region === 'LatAm'),
  'Asia': commodities.filter(c => c.region === 'Asia'),
  'Global': commodities.filter(c => c.region === 'Global'),
  'Inversión': commodities.filter(c => c.region === 'Inversión'),
};
---

<Layout metadata={metadata}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    
    <div class="mb-8">
      <span class="text-sm font-medium tracking-widest uppercase text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800 px-3 py-1 rounded-full">
        Inteligencia de Mercados
      </span>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white mt-3">Monitor Estratégico</h1>
      <p class="text-lg text-slate-600 dark:text-slate-400">Commodities, índices asiáticos e indicadores de inversión para América Latina.</p>
    </div>

    {Object.entries(groups).map(([region, items]) => (
      <div class="mb-10">
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-200 mb-4 border-b border-slate-200 dark:border-slate-700 pb-2">
          {region === 'LatAm' ? '🌎 América Latina' : 
           region === 'Asia' ? '🌏 Asia-Pacífico' : 
           region === 'Global' ? '🌍 Global' : '📊 Inversión'}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((item) => (
            <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm hover:shadow-md transition-all duration-200">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase">{item.name}</span>
                  <div class="text-xl font-bold text-slate-900 dark:text-white mt-1" id={`price-${item.symbol}`}>
                    Cargando...
                  </div>
                </div>
                <div class="text-sm font-semibold" id={`change-${item.symbol}`}>
                  ...
                </div>
              </div>
              <div class="mt-3 h-12 w-full">
                <canvas id={`chart-${item.symbol}`} class="w-full h-full"></canvas>
              </div>
              <div class="mt-1 text-right">
                <span class="text-xs text-slate-400 dark:text-slate-500" id={`status-${item.symbol}`}>
                  Conectando...
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <script is:inline>
      const chartScript = document.createElement('script');
      chartScript.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
      chartScript.onload = initCharts;
      document.head.appendChild(chartScript);

      let charts = {};
      const symbols = ['HG=F', 'LIT', 'ZS=F', 'SI=F', 'BZ=F', 'GC=F', '000001.SS', '^HSI', '^N225', 'DX-Y.NYB'];

      // Usar el proxy de nuestro servidor
      async function fetchYahooData(symbol) {
        try {
          const response = await fetch(`/api/yahoo.json?symbol=${symbol}`);
          const data = await response.json();
          
          if (data.chart && data.chart.result && data.chart.result.length > 0) {
            const result = data.chart.result[0];
            const meta = result.meta;
            const quotes = result.indicators.quote[0];
            
            const currentPrice = meta.regularMarketPrice || meta.previousClose || 0;
            const change = meta.regularMarketChangePercent || 0;
            const closes = quotes.close || [];
            
            return {
              price: currentPrice,
              change: change,
              change_direction: change > 0 ? 'up' : change < 0 ? 'down' : 'flat',
              history: closes.filter(c => c !== null).slice(-20)
            };
          }
          return null;
        } catch (error) {
          console.error(`Error fetching ${symbol}:`, error);
          return null;
        }
      }

      function initCharts() {
        for (const symbol of symbols) {
          const canvas = document.getElementById(`chart-${symbol}`);
          if (!canvas) continue;
          
          const ctx = canvas.getContext('2d');
          charts[symbol] = new Chart(ctx, {
            type: 'line',
            data: {
              labels: [],
              datasets: [{
                data: [],
                borderColor: '#2563eb',
                backgroundColor: '#2563eb20',
                borderWidth: 1.5,
                pointRadius: 0,
                tension: 0.4,
                fill: true,
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false }, tooltip: { enabled: false } },
              scales: { x: { display: false }, y: { display: false } },
              animation: { duration: 0 }
            }
          });
        }
        updateAll();
        setInterval(updateAll, 60000);
      }

      async function updateAll() {
        for (const symbol of symbols) {
          const data = await fetchYahooData(symbol);
          if (!data) {
            const statusEl = document.getElementById(`status-${symbol}`);
            if (statusEl) {
              statusEl.textContent = 'Error';
              statusEl.className = 'text-xs text-red-600 dark:text-red-400';
            }
            continue;
          }

          const priceEl = document.getElementById(`price-${symbol}`);
          const changeEl = document.getElementById(`change-${symbol}`);
          const statusEl = document.getElementById(`status-${symbol}`);

          if (priceEl) {
            priceEl.textContent = data.price ? `$${data.price.toFixed(2)}` : 'N/A';
          }

          if (changeEl && data.change !== undefined) {
            const change = data.change;
            const direction = data.change_direction;
            const color = direction === 'up' ? 'text-green-600' : direction === 'down' ? 'text-red-600' : 'text-slate-400';
            const sign = direction === 'up' ? '+' : '';
            changeEl.className = `text-sm font-semibold ${color}`;
            changeEl.textContent = `${sign}${change.toFixed(2)}%`;
          }

          if (statusEl) {
            statusEl.textContent = 'Actualizado';
            statusEl.className = 'text-xs text-green-600 dark:text-green-400';
          }

          if (charts[symbol] && data.history && data.history.length > 0) {
            const prices = data.history;
            const color = prices[prices.length - 1] > prices[0] ? '#22c55e' : '#ef4444';
            charts[symbol].data.labels = prices.map((_, i) => i);
            charts[symbol].data.datasets[0].data = prices;
            charts[symbol].data.datasets[0].borderColor = color;
            charts[symbol].data.datasets[0].backgroundColor = color + '20';
            charts[symbol].update();
          }
        }
      }
    </script>

  </div>
</Layout>
