---
import PageLayout from '~/layouts/PageLayout.astro';
import type { CollectionEntry } from 'astro:content';
import ShareButtons from '~/components/common/ShareButtons.astro';
import { getLangFromUrl, useTranslations, languages, type Lang } from '~/i18n/ui';

export interface Props {
  report: CollectionEntry<'reports'>;
  headings?: { depth: number; slug: string; text: string }[];
  langLinks?: { lang: Lang; href: string }[];
  missingLangs?: Lang[];
}

const { report, headings = [], langLinks = [], missingLangs = [] } = Astro.props;
const { data } = report;

const lang = getLangFromUrl(Astro);
const t = useTranslations(lang);

const leaderImages: Record<string, string> = {
  'Francisco J. Covarrubias R.': '/images/experts-profile/francisco-covarrubias.webp',
  'Jimena Valenzuela G.': '/images/experts-profile/jimena-valenzuela.webp',
};

const tocHeadings = headings.filter((h) => h.depth === 1 || h.depth === 2);

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : lang === 'en' ? 'en-US' : 'zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

const metadata = {
  title: data.title,  // el Layout base añade el sufijo `— Open Andes` vía config.yaml
  description: data.summary || data.subtitle,
  openGraph: {
    images: data.image ? [{ url: data.image }] : [],
  },
};
---

<PageLayout metadata={metadata}>
  <!-- HERO -->
  <section class="bg-[#ffffff] dark:bg-[#030712] border-b border-[#e5e7eb] dark:border-[#2a2a2a]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 sm:py-16">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono-tech font-bold uppercase tracking-widest text-[#1344e7] dark:text-[#5b8def] mb-6">
        {data.program && <span>{data.program}</span>}
        {data.type && <><span>•</span><span>{data.type}</span></>}
        {data.date && <><span>•</span><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></>}
      </div>

      <h1 class="font-fraunces font-normal text-4xl sm:text-5xl lg:text-6xl text-[#111827] dark:text-[#f3f4f6] leading-tight tracking-tight max-w-4xl">
        {data.title}
      </h1>

      {data.subtitle && (
        <p class="mt-6 text-lg sm:text-xl text-[#4b5563] dark:text-[#4b5563] leading-relaxed max-w-4xl font-sans font-normal">
          {data.subtitle}
        </p>
      )}

      <!-- i18n: idiomas disponibles + traducciones pendientes -->
      {(langLinks.length > 0 || missingLangs.length > 0) && (
        <div class="mt-8 flex flex-wrap items-center gap-3 text-sm max-w-4xl">
          {langLinks.length > 0 && (
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#4b5563] dark:text-[#4b5563]">
                {t.common.availableIn}:
              </span>
              {langLinks.map(({ lang: l, href }) => (
                <a
                  href={href}
                  hreflang={l}
                  class="text-xs px-3 py-1 rounded-full border border-[#1344e7] text-[#1344e7] dark:text-[#5b8def] dark:border-[#5b8def] hover:bg-[#1344e7] hover:text-white transition-colors font-mono-tech"
                >
                  {languages[l]}
                </a>
              ))}
            </div>
          )}
          {missingLangs.length > 0 && (
            <span class="text-xs text-[#4b5563] dark:text-[#4b5563] italic">
              {t.common.translationPending}: {missingLangs.map((l) => languages[l]).join(' · ')}
            </span>
          )}
        </div>
      )}

      <!-- AUTORES -->
      {(data.researchLeaders.length > 0 || data.associateResearchers.length > 0) && (
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8 text-sm border-t border-[#e5e7eb] dark:border-[#2a2a2a] pt-8 max-w-4xl">
          {data.researchLeaders.length > 0 && (
            <div>
              <h4 class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#4b5563] dark:text-[#4b5563] mb-3">
                Líderes de Investigación
              </h4>
              <ul class="space-y-3">
                {data.researchLeaders.map((name) => (
                  <li class="flex items-center gap-3">
                    {leaderImages[name] && (
                      <img
                        src={leaderImages[name]}
                        alt={name}
                        class="w-10 h-10 rounded-full object-cover border border-[#e5e7eb] dark:border-[#2a2a2a]"
                      />
                    )}
                    <span class="font-normal text-[#111827] dark:text-[#f3f4f6]">{name}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {data.associateResearchers.length > 0 && (
            <div>
              <h4 class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#4b5563] dark:text-[#4b5563] mb-3">
                Investigadores Asociados
              </h4>
              <p class="text-sm text-[#4b5563] dark:text-[#4b5563] leading-relaxed">
                {data.associateResearchers.join(', ')}.
              </p>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- CUERPO PRINCIPAL -->
  <section class="bg-white dark:bg-[#030712]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 sm:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

        <!-- TOC STICKY (izquierda) -->
        {data.toc && tocHeadings.length > 0 && (
          <aside class="hidden lg:block lg:col-span-3">
            <div class="sticky top-24 space-y-8">
              <ShareButtons variant="sticky" />
              <nav aria-label="Tabla de contenidos">
                <h3 class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#4b5563] dark:text-[#4b5563] mb-4">
                  Contenido
                </h3>
                <ol class="space-y-2 text-sm">
                  {tocHeadings.map((h) => (
                    <li class={h.depth === 2 ? "pl-3" : ""}>
                      <a
                        href={`#${h.slug}`}
                        class="block text-[#4b5563] dark:text-[#4b5563] hover:text-[#1344e7] dark:hover:text-[#5b8def] transition-colors leading-snug"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </div>
          </aside>
        )}
        <!-- CONTENIDO (derecha) -->
        <div class={data.toc && tocHeadings.length > 0 ? 'lg:col-span-9' : 'lg:col-span-12'}>
          <div class="max-w-3xl">

            <!-- KEY TAKEAWAYS -->
            {data.keyTakeaways && data.keyTakeaways.length > 0 && (
              <aside class="mb-10 rounded-lg border-l-4 border-[#1344e7] dark:border-[#1344e7] bg-[#e2f3ff]/50 dark:bg-white/5 p-6">
                <h3 class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#1344e7] dark:text-[#5b8def] mb-3">
                  Puntos Clave
                </h3>
                <ul class="space-y-2 text-sm text-[#111827] dark:text-[#f3f4f6] leading-relaxed list-disc pl-5">
                  {data.keyTakeaways.map((t) => (
                    <li set:html={t.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
                  ))}
                </ul>
              </aside>
            )}

            <!-- STATS -->
            {data.stats && data.stats.length > 0 && (
              <div class="my-10 grid grid-cols-1 sm:grid-cols-3 gap-6 py-6 border-y border-[#e5e7eb] dark:border-[#2a2a2a] text-center">
                {data.stats.map((s) => (
                  <div>
                    <span class="block text-3xl font-bold text-[#1344e7] dark:text-[#5b8def] font-fraunces">{s.value}</span>
                    <span class="mt-1 block text-xs font-mono-tech font-bold text-[#4b5563] dark:text-[#4b5563] uppercase tracking-wider leading-tight">{s.label}</span>
                  </div>
                ))}
              </div>
            )}

            <!-- ACKNOWLEDGMENT -->
            {data.acknowledgment && (
              <aside class="my-10 rounded-lg border border-[#e5e7eb] dark:border-[#2a2a2a] bg-[#ffffff] dark:bg-white/5 p-6 text-sm">
                <h3 class="text-xs font-mono-tech font-bold uppercase tracking-widest text-[#1344e7] dark:text-[#5b8def] mb-3">
                  Reconocimiento Institucional
                </h3>
                <p class="text-[#111827] dark:text-[#f3f4f6] leading-relaxed" set:html={data.acknowledgment.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\*(.*?)\*/g, '<em>$1</em>')} />
              </aside>
            )}

            <!-- TAGS -->
            {data.tags.length > 0 && (
              <div class="mb-10 flex flex-wrap gap-2">
                {data.tags.map((tag) => (
                  <span class="text-xs px-3 py-1 rounded-full bg-[#e2f3ff]/70 dark:bg-white/5 border border-[#e5e7eb] dark:border-[#2a2a2a] text-[#1344e7] dark:text-[#5b8def] font-mono-tech">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <!-- CONTENIDO MDX -->
            <div class="prose prose-lg prose-p:text-[20px] prose-p:text-[#0a0705] dark:prose-p:text-[#f3f4f6] prose-p:font-light max-w-none font-fraunces text-[#111827] dark:text-[#f3f4f6] prose-headings:font-fraunces prose-headings:text-[#111827] dark:prose-headings:text-[#f3f4f6] prose-strong:text-[#111827] dark:prose-strong:text-[#f3f4f6] prose-a:text-[#1344e7] dark:prose-a:text-[#7fb3e0] prose-a:no-underline hover:prose-a:underline prose-blockquote:text-[#4b5563] dark:prose-blockquote:text-[#4b5563] prose-blockquote:border-l-[#1344e7] prose-code:text-[#1344e7] dark:prose-code:text-[#7fb3e0] prose-table:text-[#111827] dark:prose-table:text-[#f3f4f6]">
              <slot />
            </div>

            <ShareButtons variant="inline" />

          </div>
        </div>

      </div>
    </div>
  </section>
</PageLayout>
