---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <h1 class="font-sans font-bold text-3xl md:text-4xl lg:text-5xl leading-tight tracking-tight text-[#1a1410] dark:text-[#f0ece4]">
      {frontmatter.title}
    </h1>
    <div
      class="mx-auto prose prose-lg max-w-4xl mt-8 font-fraunces
        text-[#1a1410] dark:text-[#f0ece4]
        prose-headings:font-sans prose-headings:font-bold prose-headings:tracking-tight
        prose-headings:text-[#1a1410] dark:prose-headings:text-[#f0ece4]
        prose-strong:text-[#1a1410] dark:prose-strong:text-[#f0ece4]
        prose-a:text-[#1a4b8c] dark:prose-a:text-[#7fb3e0] prose-a:no-underline hover:prose-a:underline
        prose-blockquote:text-[#4a4438] dark:prose-blockquote:text-[#c8c2b6] prose-blockquote:border-l-[#1a4b8c]
        prose-code:text-[#1a4b8c] dark:prose-code:text-[#7fb3e0]
        prose-table:text-[#1a1410] dark:prose-table:text-[#f0ece4]
        prose-img:rounded-md prose-img:shadow-lg"
    >
      <slot />
    </div>
  </section>
</Layout>
